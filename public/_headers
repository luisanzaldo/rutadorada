# Cabeceras de caché para Cloudflare Pages.
#
# OJO con el orden: en _headers las reglas que casan NO se sobrescriben entre sí,
# se ACUMULAN. Una regla específica después de /* produce dos Cache-Control
# concatenados y contradictorios, y ante eso Cloudflare aplica su propio criterio
# (se observaron 4 horas donde el archivo pedía 5 minutos). Por eso lo específico
# va primero y el comodín al final.
#
# Sin este archivo, Pages servía el HTML con s-maxage=604800: siete días. Una nota
# editada o borrada podía tardar una semana en actualizarse, y de hecho pasó.

# Nombres con hash: si el contenido cambia, cambia la URL. Caché eterna.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Las genera el prebuild como <slug>.jpg: al cambiar la URL de origen de una nota
# cambia el contenido pero no el nombre, así que la caché no puede ser larga.
# La fase 4 elimina la causa; en R2 las URLs llevarán hash del contenido.
/images/*
  Cache-Control: public, max-age=300, must-revalidate

/icons/*
  Cache-Control: public, max-age=86400

# Todo lo demás es HTML, que debe revalidar siempre.
/*
  Cache-Control: public, max-age=0, must-revalidate
