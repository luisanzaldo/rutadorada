# Supabase Configuration
# Replace these with your actual values from the Supabase Dashboard
# PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Analytics (optional — leave empty to disable)
# Google Analytics 4 Measurement ID — formato: G-XXXXXXXXXX
PUBLIC_GA4_MEASUREMENT_ID=
# Microsoft Clarity Project ID — formato: 10 caracteres alfanuméricos
PUBLIC_CLARITY_PROJECT_ID=
# CookieYes Site ID — necesario para que el banner cargue y desbloquee GA/Clarity
PUBLIC_COOKIEYES_ID=

# Google Sheets — Calificaciones Cannes 2026
GOOGLE_API_KEY=
CANNES_SHEET_ID=
CANNES_SHEET_RANGE=

# Supabase — operaciones server-side del admin
SUPABASE_SERVICE_ROLE_KEY=

# Panel admin — sesión JWT y usuarios (hashes bcrypt)
JWT_SECRET=
HASH_LUISANZALDO=
HASH_RAMONFIGUEROA=

# Publicación de posts desde el admin (API de GitHub + deploy hook de Vercel)
# GITHUB_REPO en formato usuario/repositorio
GITHUB_TOKEN=
GITHUB_REPO=
VERCEL_DEPLOY_HOOK=

# Asistente de calendario editorial (/api/calendar/chat)
GROQ_API_KEY=
NOTION_TOKEN=
NOTION_CALENDAR_DATA_SOURCE_ID=
