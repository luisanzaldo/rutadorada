---

---

<footer
    class="bg-card-light dark:bg-card-dark border-t border-slate-200 dark:border-white/5 py-12"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between gap-12">
            <div class="max-w-md">
                <a href={import.meta.env.BASE_URL} class="flex items-center space-x-3 mb-6 group">

                    <span
                        class="font-display font-bold text-xl uppercase tracking-tighter text-slate-900 dark:text-white"
                        >Ruta<span class="text-[#F2AF0D]">Dorada</span></span
                    >
                </a>
                <p class="text-slate-500 text-sm mb-6 leading-relaxed">
                    Celebremos juntos el poder del séptimo arte.
                </p>
                <div class="flex space-x-4">
                    <a
                        class="text-slate-400 hover:text-[#F2AF0D] transition-colors rss-trigger"
                        href="/rss.xml"
                        aria-label="Suscribirse mediante RSS"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M4 11a9 9 0 0 1 9 9"></path>
                            <path d="M4 4a16 16 0 0 1 16 16"></path>
                            <circle cx="5" cy="19" r="1"></circle>
                        </svg>
                    </a>
                    <a
                        class="text-slate-400 hover:text-[#F2AF0D] transition-colors"
                        href="mailto:rutadoradafilms@gmail.com"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <rect width="20" height="16" x="2" y="4" rx="2"
                            ></rect>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                            ></path>
                        </svg>
                    </a>
                </div>
            </div>

            <div class="min-w-[200px]">
                <h4 class="text-slate-900 dark:text-white font-bold mb-4">
                    Categorías
                </h4>
                <ul
                    class="grid grid-cols-2 gap-x-8 gap-y-3 text-sm text-slate-500 dark:text-slate-400"
                >
                    <li>
                        <a
                            class="hover:text-[#F2AF0D] transition-colors"
                            href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/#lo-ultimo`}>Lo último</a>
                    </li>
                    <li>
                        <a
                            class="hover:text-[#F2AF0D] transition-colors"
                            href={`${import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL}/articulos`}>Artículos</a>
                    </li>
                    <li>
                        <a
                            class="hover:text-[#F2AF0D] transition-colors"
                            href={`${import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL}/criticas`}>Críticas</a>
                    </li>
                    <li>
                        <a
                            class="hover:text-[#F2AF0D] transition-colors"
                            href={`${import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL}/premios`}>Premios</a>
                    </li>
                    <li>
                        <a
                            class="hover:text-[#F2AF0D] transition-colors"
                            href={`${import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL}/trailers`}>Tráilers</a>
                    </li>
                    <li>
                        <a
                            class="hover:text-[#F2AF0D] transition-colors"
                            href={`${import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL}/archive`}>Archivo</a>
                    </li>
                </ul>
            </div>
        </div>

        <div
            class="border-t border-slate-200 dark:border-white/5 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center gap-4"
        >
            <p class="text-slate-500 text-xs text-center md:text-left">
                © 2026 RutaDorada Films. All rights reserved.
            </p>
            <div class="flex flex-wrap justify-center md:justify-end gap-x-6 gap-y-2 text-xs text-slate-500">
                <a href={`${import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL}/politica-de-privacidad`} class="hover:text-[#F2AF0D] transition-colors">Política de privacidad</a>
                <a href={`${import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL}/politica-de-cookies`} class="hover:text-[#F2AF0D] transition-colors">Política de cookies</a>
                <a href={`${import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL}/terminos-y-condiciones`} class="hover:text-[#F2AF0D] transition-colors">Términos y condiciones de uso</a>
            </div>
        </div>
    </div>
</footer>
