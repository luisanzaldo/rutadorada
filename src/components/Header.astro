---
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
const searchablePosts = allPosts.map((post) => ({
    title: post.data.title,
    description: post.data.description,
    slug: post.slug,
    category: post.data.category,
    tags: post.data.tags || [],
    body: post.body,
}));
const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
---

<header
    class="sticky top-0 z-50 w-full backdrop-blur-md bg-nav-bg border-b border-white/5"
>
    <div class="max-w-7xl mx-auto px-2 sm:px-4 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <!-- Logo -->
            <a
                href={import.meta.env.BASE_URL}
                class="flex-shrink-0 flex items-center space-x-2 sm:space-x-3 cursor-pointer group"
            >

                <img
                    src={`${baseUrl}/images/RutaDorada-web.png`}
                    alt="Ruta Dorada"
                    class="h-[40px] sm:h-[48px] w-auto"
                />
            </a>

            <nav class="hidden lg:flex space-x-8">
                <a
                    class="text-slate-300 hover:text-[#D4AF37] px-3 py-2 text-sm font-medium transition-colors"
                    href={import.meta.env.BASE_URL}>Lo último</a>
                <a
                    class="text-slate-300 hover:text-[#D4AF37] px-3 py-2 text-sm font-medium transition-colors"
                    href={`${baseUrl}/articulos`}>Artículos</a>
                <a
                    class="text-slate-300 hover:text-[#D4AF37] px-3 py-2 text-sm font-medium transition-colors"
                    href={`${baseUrl}/criticas`}>Críticas</a>
                <a
                    class="text-slate-300 hover:text-[#D4AF37] px-3 py-2 text-sm font-medium transition-colors"
                    href={`${baseUrl}/premios`}>Premios</a>
                <a
                    class="text-slate-300 hover:text-[#D4AF37] px-3 py-2 text-sm font-medium transition-colors"
                    href={`${baseUrl}/trailers`}>Tráilers</a>
                <a
                    class="text-slate-300 hover:text-[#D4AF37] px-3 py-2 text-sm font-medium transition-colors"
                    href={`${baseUrl}/archive`}>Archivo</a>
            </nav>

            <!-- Search + Auth + Menu -->
            <div class="flex items-center space-x-1 sm:space-x-2 lg:space-x-4">
                <!-- Search -->
                <button
                    id="search-btn"
                    class="p-2 text-slate-500 hover:text-[#D4AF37] transition-colors hover:bg-primary/10 rounded-full flex items-center justify-center"
                    aria-label="Search"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.3-4.3"></path>
                    </svg>
                </button>

                <!-- Auth Buttons (Desktop) -->
                <div
                    id="auth-buttons"
                    class="hidden lg:flex items-center space-x-2"
                >
                    <a
                        href={`${baseUrl}/login`}
                        class="text-slate-300 hover:text-[#D4AF37] px-1 py-2 text-sm font-medium transition-colors"
                    >
                        Login
                    </a>
                    <a
                        href={`${baseUrl}/register`}
                        class="px-3 py-2 text-sm font-medium text-[#102023] bg-primary hover:bg-primary/90 rounded-lg transition-colors shadow-lg shadow-primary/20"
                    >
                        Registro
                    </a>
                </div>

                <!-- User Menu (Desktop) -->
                <div id="user-menu" class="hidden relative group">
                    <button
                        id="user-menu-button"
                        class="flex items-center gap-2 p-1 rounded-full hover:bg-slate-100 dark:hover:bg-[#162a2f] transition-colors group"
                    >
                        <div
                            class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-[#102023] font-bold text-sm overflow-hidden border-2 border-transparent group-hover:border-primary/50 transition-all"
                        >
                            <span id="user-initials">U</span>
                            <img
                                id="user-avatar"
                                src=""
                                alt="Profile"
                                class="hidden w-full h-full object-cover"
                                loading="lazy"
                                decoding="async"
                            />
                        </div>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="text-slate-400 group-hover:text-[#D4AF37] transition-colors"
                        >
                            <path d="m6 9 6 6 6-6"></path>
                        </svg>
                    </button>

                    <!-- User Dropdown -->
                    <div
                        id="user-dropdown"
                        class="absolute right-0 top-full mt-3 w-48 bg-white dark:bg-[#0b1618] border border-slate-200 dark:border-[#224249] rounded-xl shadow-xl py-2 hidden"
                    >
                        <div
                            class="px-4 py-2 border-b border-slate-100 dark:border-[#224249] mb-1"
                        >
                            <p
                                class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-widest font-bold"
                            >
                                Account
                            </p>
                            <p
                                id="user-email"
                                class="text-sm font-medium text-slate-900 dark:text-white truncate"
                            >
                                user@example.com
                            </p>
                        </div>
                        <a
                            href={`${baseUrl}/settings`}
                            class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#162a2f] hover:text-[#D4AF37] transition-colors"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path
                                    d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"
                                ></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            Configuración
                        </a>
                        <div
                            class="h-[1px] bg-slate-100 dark:bg-[#224249] my-1"
                        >
                        </div>
                        <a
                            href={`${baseUrl}/my-likes`}
                            class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#162a2f] hover:text-[#D4AF37] transition-colors"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M7 10v12"></path>
                                <path
                                    d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88Z"
                                ></path>
                            </svg>
                            Mis likes
                        </a>
                        <a
                            href={`${baseUrl}/my-favorites`}
                            class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#162a2f] hover:text-[#D4AF37] transition-colors"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path
                                    d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"
                                ></path>
                            </svg>
                            Mis favoritos
                        </a>
                        <div
                            class="h-[1px] bg-slate-100 dark:bg-[#224249] my-1"
                        >
                        </div>
                        <button
                            id="logout-btn"
                            class="w-full flex items-center gap-2 px-4 py-2 text-sm text-red-600 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path
                                    d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"
                                ></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" x2="9" y1="12" y2="12"></line>
                            </svg>
                            Cerrar sesión
                        </button>
                    </div>
                </div>

                <!-- Mobile Menu Button -->
                <button
                    id="mobile-menu-btn"
                    class="lg:hidden p-2 text-slate-500 hover:text-[#D4AF37] transition-colors hover:bg-primary/10 rounded-lg group"
                    aria-label="Toggle Menu"
                >
                    <div class="w-6 h-5 relative flex flex-col justify-between">
                        <span
                            id="menu-bar-1"
                            class="w-full h-0.5 bg-current rounded-full transition-all duration-300"
                        ></span>
                        <span
                            id="menu-bar-2"
                            class="w-full h-0.5 bg-current rounded-full transition-all duration-300"
                        ></span>
                        <span
                            id="menu-bar-3"
                            class="w-full h-0.5 bg-current rounded-full transition-all duration-300"
                        ></span>
                    </div>
                </button>
            </div>
        </div>
    </div>
</header>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="fixed inset-0 z-40 hidden lg:hidden">
    <!-- Backdrop -->
    <div
        id="mobile-menu-backdrop"
        class="absolute inset-0 bg-slate-900/60 backdrop-blur-md opacity-0 transition-opacity duration-300"
    >
    </div>

    <!-- Menu Content -->
    <div
        id="mobile-menu-content"
        class="absolute right-0 top-0 bottom-0 w-[280px] bg-black border-l border-white/10 translate-x-full transition-transform duration-300 ease-out p-6 pt-24 overflow-y-auto custom-scrollbar"
    >
        <nav class="flex flex-col space-y-4">
            <a
                class="text-slate-300 hover:text-[#D4AF37] text-lg font-bold py-2 border-b border-white/5"
                href={import.meta.env.BASE_URL}>Lo último</a>
            <a
                class="text-slate-300 hover:text-[#D4AF37] text-lg font-bold py-2 border-b border-white/5"
                href={`${baseUrl}/articulos`}>Artículos</a
            >
            <a
                class="text-slate-300 hover:text-[#D4AF37] text-lg font-bold py-2 border-b border-white/5"
                href={`${baseUrl}/criticas`}>Críticas</a
            >
            <a
                class="text-slate-300 hover:text-[#D4AF37] text-lg font-bold py-2 border-b border-white/5"
                href={`${baseUrl}/premios`}>Premios</a
            >
            <a
                class="text-slate-300 hover:text-[#D4AF37] text-lg font-bold py-2 border-b border-white/5"
                href={`${baseUrl}/trailers`}>Tráilers</a
            >
            <a
                class="text-slate-300 hover:text-[#D4AF37] text-lg font-bold py-2 border-b border-white/5"
                href={`${baseUrl}/archive`}>Archivo</a
            >

            <div id="mobile-auth-section" class="pt-4 flex flex-col space-y-3">
                <a
                    href={`${baseUrl}/login`}
                    class="w-full text-center py-2 rounded-lg border border-slate-700 text-slate-300 font-bold hover:border-primary hover:text-[#D4AF37] transition-colors"
                >
                    Login
                </a>
                <a
                    href={`${baseUrl}/register`}
                    class="w-full text-center py-2 rounded-lg bg-primary text-[#102023] font-bold hover:bg-primary/90 transition-colors shadow-lg shadow-primary/20"
                >
                    Registro
                </a>
            </div>

            <div
                id="mobile-user-section"
                class="hidden pt-4 flex flex-col space-y-4"
            >
                <!-- User Profile Summary in Mobile -->
                <div class="flex items-center gap-4 p-4 bg-white/5 rounded-2xl border border-white/10">
                    <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center text-[#102023] font-bold text-lg overflow-hidden border-2 border-white/10 shadow-lg">
                        <span id="mobile-user-initials">U</span>
                        <img
                            id="mobile-user-avatar"
                            src=""
                            alt="Profile"
                            class="hidden w-full h-full object-cover"
                        />
                    </div>
                    <div class="flex-1 overflow-hidden">
                        <p class="text-xs text-slate-500 uppercase font-black tracking-widest">Cuenta</p>
                        <p id="mobile-user-email" class="text-sm font-medium text-white truncate">usuario@ejemplo.com</p>
                    </div>
                </div>

                <a
                    href={`${baseUrl}/settings`}
                    class="w-full flex items-center justify-center gap-2 py-2 rounded-lg border border-slate-700 text-slate-300 font-bold hover:border-primary hover:text-[#D4AF37] transition-colors"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path
                            d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"
                        ></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    Configuración
                </a>
                <a
                    href={`${baseUrl}/my-likes`}
                    class="w-full flex items-center justify-center gap-2 py-2 rounded-lg border border-slate-700 text-slate-300 font-bold hover:border-primary hover:text-[#D4AF37] transition-colors"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M7 10v12"></path>
                        <path
                            d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88Z"
                        ></path>
                    </svg>
                    Mis likes
                </a>
                <a
                    href={`${baseUrl}/my-favorites`}
                    class="w-full flex items-center justify-center gap-2 py-2 rounded-lg border border-slate-700 text-slate-300 font-bold hover:border-primary hover:text-[#D4AF37] transition-colors"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path
                            d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"
                        ></path>
                    </svg>
                    Mis favoritos
                </a>
                <button
                    id="mobile-logout-btn"
                    class="w-full flex items-center justify-center gap-2 py-2 rounded-lg bg-red-500/10 text-red-500 font-bold hover:bg-red-500/20 transition-colors"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"
                        ></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" x2="9" y1="12" y2="12"></line>
                    </svg>
                    Cerrar sesión
                </button>
            </div>
        </nav>

        <div class="mt-12 flex flex-col gap-4">
            <p
                class="text-xs font-bold text-slate-500 uppercase tracking-widest"
            >
                Conecta
            </p>
            <div class="flex gap-4">
                <a
                    class="w-10 h-10 rounded-lg bg-white/5 flex items-center justify-center text-slate-400 hover:text-[#D4AF37] hover:bg-primary/10 transition-all"
                    href="https://x.com/rutadoradafilms"
                    target="_blank"
                    rel="noopener noreferrer"
                    title="X (Twitter)"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                      <path d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865l8.875 11.633Z"/>
                    </svg>
                </a>
                <a
                    class="w-10 h-10 rounded-lg bg-white/5 flex items-center justify-center text-slate-400 hover:text-[#D4AF37] hover:bg-primary/10 transition-all"
                    href="https://www.tiktok.com/@rutadoradafilms"
                    target="_blank"
                    rel="noopener noreferrer"
                    title="TikTok"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                      <path d="M9 0h1.98c.144.715.54 1.617 1.235 2.512C12.895 3.389 13.797 4 15 4v2c-1.753 0-3.07-.814-4-1.829V11a5 5 0 1 1-5-5v2a3 3 0 1 0 3 3V0Z"/>
                    </svg>
                </a>
                <a
                    class="w-10 h-10 rounded-lg bg-white/5 flex items-center justify-center text-slate-400 hover:text-[#D4AF37] hover:bg-primary/10 transition-all"
                    href="https://www.instagram.com/rutadoradafilms"
                    target="_blank"
                    rel="noopener noreferrer"
                    title="Instagram"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                      <path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.917 3.917 0 0 0-1.417.923A3.927 3.927 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.916 3.916 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.926 3.926 0 0 0-.923-1.417A3.911 3.911 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0h.003zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599.28.28.453.546.598.92.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.47 2.47 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.478 2.478 0 0 1-.92-.598 2.48 2.48 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233 0-2.136.008-2.388.046-3.231.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92.28-.28.546-.453.92-.598.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045v.002zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92zm-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217zm0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334z"/>
                    </svg>
                </a>
                <a
                    class="w-10 h-10 rounded-lg bg-white/5 flex items-center justify-center text-slate-400 hover:text-[#D4AF37] hover:bg-primary/10 transition-all"
                    href="https://www.youtube.com/@RutaDoradaFilms"
                    target="_blank"
                    rel="noopener noreferrer"
                    title="YouTube"
                >
