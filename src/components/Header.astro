            class="w-full max-w-2xl bg-[#0b1618] border border-[#224249] rounded-2xl shadow-2xl overflow-hidden pointer-events-auto transform transition-all"
        >
            <!-- Search Input -->
            <div class="relative p-4 border-b border-[#224249]">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
