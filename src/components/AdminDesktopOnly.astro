---
// Aviso visible solo en móvil/tablet pequeño cuando se intenta entrar al panel.
// El contenido del panel se oculta debajo de lg (1024px).
---

<div class="lg:hidden flex-grow py-12 px-4 sm:px-6 w-full max-w-2xl mx-auto">
    <div class="absolute inset-0 pointer-events-none overflow-hidden -z-10">
        <div class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-primary/10 rounded-full blur-[120px] mix-blend-screen opacity-20"></div>
        <div class="absolute bottom-[-10%] left-[-5%] w-[500px] h-[500px] bg-blue-500/5 rounded-full blur-[120px] mix-blend-screen opacity-20"></div>
    </div>

    <div class="bg-white/80 dark:bg-background-dark border border-slate-200 dark:border-[#224249] rounded-2xl p-8 shadow-2xl backdrop-blur-sm relative z-10 text-center">
        <div class="w-16 h-16 rounded-full bg-primary/15 border border-primary/30 flex items-center justify-center text-primary mx-auto mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
        </div>

        <h1 class="font-display font-bold text-xl sm:text-2xl text-slate-900 dark:text-white mb-3">
            Panel de Ruta<span class="text-primary">Dorada</span> Films
        </h1>

        <p class="text-slate-600 dark:text-slate-300 text-base leading-relaxed mb-6">
            Ingresa a la versión de escritorio para administrar tu panel.
        </p>

        <a href="/" class="inline-flex items-center gap-2 bg-primary text-[#0b1618] px-6 py-2.5 rounded-xl font-bold text-sm hover:brightness-110 transition-all shadow-[0_0_15px_rgba(212,175,55,0.3)]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            Volver al inicio
        </a>
    </div>
</div>
