---
import { getCollection } from "astro:content";

const baseUrl = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL;

const allPosts = await getCollection("posts");
const latest = allPosts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 8);

const fmtDate = (d: Date) =>
    d
        .toLocaleDateString("es-ES", {
            day: "numeric",
            month: "short",
            year: "numeric",
        })
        .replace(/\./g, "");

const featured = latest.slice(0, 5).map((p) => {
    const videoUrl = p.data.videoUrl || "";
    const isTrailer = videoUrl !== "";
    return {
        title: p.data.title,
        category: p.data.category,
        date: fmtDate(p.data.pubDate),
        read: (p.data.readTime || "").replace(/read/i, "").trim() || "—",
        image: p.data.image.startsWith("/")
            ? `${baseUrl}${p.data.image}`
            : p.data.image,
        videoUrl,
        isTrailer,
        href: isTrailer ? videoUrl : `${baseUrl}/posts/${p.slug}`,
    };
});

const marquee = latest.map((p) => ({
    title: p.data.title,
    href: p.data.videoUrl || `${baseUrl}/posts/${p.slug}`,
}));

const first = featured[0];
const archiveHref = `${baseUrl}/archive`;
---

<section
    id="hero"
    class="hero-cover relative w-full overflow-hidden bg-[#0c0a09] text-[#F3ECDD] h-[80svh] min-h-[600px] lg:h-[84svh] lg:max-h-[820px]"
    aria-label="En cartelera — últimas noticias"
>
    <!-- Full-bleed stills -->
    <div class="absolute inset-0 z-0">
        {
            featured.map((s, i) => (
                <figure
                    data-slide={i}
                    class={`hero-slide absolute inset-0 ${i === 0 ? "is-active" : ""}`}
                >
                    <img
                        src={s.image}
                        alt=""
                        class="kb-img h-full w-full object-cover"
                        loading={i === 0 ? "eager" : "lazy"}
                        decoding="async"
                        aria-hidden="true"
                    />
                </figure>
            ))
        }
    </div>

    <!-- Cinematic light grade -->
    <div
        class="absolute inset-0 z-10 bg-gradient-to-t from-[#0c0a09]/90 via-[#0c0a09]/35 to-transparent dark:from-[#0c0a09] dark:via-[#0c0a09]/75 dark:to-[#0c0a09]/25"
    >
    </div>
    <div
        class="absolute inset-0 z-10 bg-gradient-to-b from-black/30 via-transparent to-transparent dark:from-black/55"
    >
    </div>
    <div class="hero-grain absolute inset-0 z-10 pointer-events-none"></div>

    <!-- Content -->
    <div
        class="relative z-20 h-full max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 flex flex-col justify-between pt-7 sm:pt-9 pb-16 sm:pb-20"
    >
        <!-- Eyebrow row -->
        <div class="hero-reveal flex items-start justify-end gap-4">
            <div class="text-right shrink-0">
                <p
                    class="ff-sans inline-flex items-center gap-2 text-[10px] sm:text-[11px] uppercase tracking-[0.28em] text-[#F2AF0D]"
                >
                    <span class="live-dot"></span>
                    En cartelera
                </p>
                <a
                    href={archiveHref}
                    class="archive-link ff-sans block mt-2 text-[10px] sm:text-[11px] uppercase tracking-[0.2em] text-[#F3ECDD]/45 transition-colors"
                >
                    Archivo &#8599;
                </a>
            </div>
        </div>

        <!-- Protagonist -->
        <div class="hero-reveal hero-reveal-2 max-w-5xl">
            <a id="hero-link" href={first.href} class="hero-link block group">
                <span
                    class="ff-sans inline-flex items-center gap-2 text-[10px] sm:text-[11px] uppercase tracking-[0.3em] text-[#F2AF0D] mb-4"
                >
                    Lo último
                </span>

                <h1
                    id="hero-title"
                    class="hero-title ff-display font-semibold normal-case tracking-[-0.02em] text-[2.1rem] sm:text-6xl lg:text-7xl xl:text-[5.2rem] text-[#F3ECDD] [text-wrap:balance] line-clamp-3"
                >
                    {first.title}
                </h1>

                <span
                    class="hero-cta ff-sans mt-6 inline-flex items-center gap-2.5 text-xs sm:text-sm uppercase tracking-[0.18em] text-[#F3ECDD] border-b border-[#F2AF0D]/40 pb-1"
                >
                    <span id="hero-cta-text"
                        >{first.isTrailer ? "Ver tráiler" : "Leer la nota"}</span
                    >
                    <svg
                        id="hero-arrow-icon"
                        class={`hero-arrow ${first.isTrailer ? "hidden" : ""}`}
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M5 12h14"></path>
                        <path d="m12 5 7 7-7 7"></path>
                    </svg>
                    <svg
                        id="hero-play-icon"
                        class={`hero-arrow ${first.isTrailer ? "" : "hidden"}`}
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                    >
                        <path d="M8 5.14v14l11-7-11-7z"></path>
                    </svg>
                </span>
            </a>

            <!-- Redes sociales -->
            <div class="mt-8 sm:mt-10 flex items-center gap-5 sm:gap-6">
                <a
                    class="hero-social text-[#F3ECDD]/55 hover:text-[#C13584] transition-colors"
                    href="https://www.instagram.com/rutadoradafilms"
                    target="_blank"
                    rel="noopener noreferrer"
                    title="Instagram"
                    aria-label="Instagram"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                      <path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.917 3.917 0 0 0-1.417.923A3.927 3.927 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.916 3.916 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.926 3.926 0 0 0-.923-1.417A3.911 3.911 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0h.003zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599.28.28.453.546.598.92.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.47 2.47 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.478 2.478 0 0 1-.92-.598 2.48 2.48 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233 0-2.136.008-2.388.046-3.231.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92.28-.28.546-.453.92-.598.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045v.002zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92zm-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217zm0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334z"/>
                    </svg>
                </a>
                <a
                    class="hero-social text-[#F3ECDD]/55 hover:text-[#38BDF8] transition-colors"
                    href="https://www.tiktok.com/@rutadoradafilms"
                    target="_blank"
                    rel="noopener noreferrer"
                    title="TikTok"
                    aria-label="TikTok"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                      <path d="M9 0h1.98c.144.715.54 1.617 1.235 2.512C12.895 3.389 13.797 4 15 4v2c-1.753 0-3.07-.814-4-1.829V11a5 5 0 1 1-5-5v2a3 3 0 1 0 3 3V0Z"/>
                    </svg>
                </a>
                <a
                    class="hero-social text-[#F3ECDD]/55 hover:text-[#FF0000] transition-colors"
                    href="https://www.youtube.com/@RutaDoradaFilms"
                    target="_blank"
                    rel="noopener noreferrer"
                    title="YouTube"
                    aria-label="YouTube"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                      <path d="M8.051 1.999h.089c.822.003 4.987.033 6.11.335a2.01 2.01 0 0 1 1.415 1.42c.101.38.172.883.22 1.402l.01.104.022.26.008.104c.065.914.073 1.77.074 1.957v.075c-.001.194-.01 1.052-.072 1.964l-.008.104-.022.26-.01.104c-.048.519-.119 1.023-.22 1.402a2.007 2.007 0 0 1-1.415 1.42c-1.16.312-5.569.334-6.18.335h-.142c-.309 0-1.587-.006-2.927-.052l-.17-.006-.087-.004-.171-.007-.171-.007c-1.11-.049-2.167-.128-2.654-.26a2.007 2.007 0 0 1-1.415-1.419c-.111-.417-.185-.986-.235-1.558L.09 9.82l-.008-.104A31.4 31.4 0 0 1 0 7.68v-.123c.002-.215.01-.958.064-1.778l.007-.103.003-.052.008-.104.022-.26.01-.104c.048-.519.119-1.023.22-1.402a2.007 2.007 0 0 1 1.415-1.42c.487-.13 1.544-.21 2.654-.26l.17-.007.172-.006.086-.003.171-.007A99.788 99.788 0 0 1 7.858 2h.193zM6.4 5.209v4.818l4.157-2.408L6.4 5.209z"/>
                    </svg>
                </a>
                <a
                    class="hero-social text-[#F3ECDD]/55 hover:text-white transition-colors"
                    href="https://x.com/rutadoradafilms"
                    target="_blank"
                    rel="noopener noreferrer"
                    title="X (Twitter)"
                    aria-label="X"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                      <path d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865l8.875 11.633Z"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>

    <!-- Marquee ticker -->
    <div
        class="marquee absolute bottom-0 inset-x-0 z-20 border-t border-black/10 bg-white/90 dark:border-[#F3ECDD]/10 dark:bg-[#0c0a09]/70 backdrop-blur-sm overflow-hidden"
    >
        <div class="marquee-track ff-mono text-[11px] sm:text-xs uppercase tracking-[0.18em] py-3">
            {
                [0, 1].map((dup) => (
                    <div
                        class="marquee-group flex items-center shrink-0"
                        aria-hidden={dup === 1 ? "true" : undefined}
                    >
                        {marquee.map((m) => (
                            <a href={m.href} class="marquee-item">
                                <span class="text-[#F2AF0D] mx-4 sm:mx-6">&#10038;</span>
                                <span class="text-[#0c0a09]/70 hover:text-[#0c0a09] dark:text-[#F3ECDD]/70 dark:hover:text-[#F3ECDD] transition-colors">
                                    {m.title}
                                </span>
                            </a>
                        ))}
                    </div>
                ))
            }
        </div>
    </div>

    {
        featured.length > 1 && (
            <div class="hero-nav hidden md:block">
                <button
                    id="hero-prev"
                    type="button"
                    class="hero-nav-btn absolute left-4 lg:left-6 top-1/2 -translate-y-1/2 z-30"
                    aria-label="Artículo anterior"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="m15 18-6-6 6-6" />
                    </svg>
                </button>
                <button
                    id="hero-next"
                    type="button"
                    class="hero-nav-btn absolute right-4 lg:right-6 top-1/2 -translate-y-1/2 z-30"
                    aria-label="Artículo siguiente"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="m9 18 6-6-6-6" />
                    </svg>
                </button>
            </div>
        )
    }

    <!-- Hidden trigger reusing the global VideoModal -->
    <a
        id="hero-video-trigger"
        class="video-trigger hidden"
        data-video-url=""
        aria-hidden="true"
        tabindex="-1"></a>
</section>

<style>
    .ff-display {
        font-family: "Manrope", system-ui, sans-serif;
    }
    .ff-mono {
        font-family: "DM Mono", ui-monospace, SFMono-Regular, monospace;
    }
    .ff-sans {
        font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    }

    /* Título: interlineado que respeta descendentes (g, j, p, y) y
       padding extra para que line-clamp no recorte la última línea */
    .hero-title {
        line-height: 1.08;
        padding-bottom: 0.16em;
        margin-bottom: -0.16em;
    }

    /* Stills crossfade + slow drift */
    .hero-slide {
        opacity: 0;
        transition: opacity 1.2s ease;
    }
    .hero-slide.is-active {
        opacity: 1;
    }
    .kb-img {
        transform: scale(1.05);
        will-change: transform;
    }
    .hero-slide.is-active .kb-img {
        animation: kb 9s ease-out forwards;
    }
    @keyframes kb {
        from {
            transform: scale(1.05);
        }
        to {
            transform: scale(1.15);
        }
    }

    /* Film grain texture */
    .hero-grain {
        background-image: url("https://www.transparenttextures.com/patterns/film-grain.png");
        opacity: 0.04;
    }

    /* Live indicator */
    .live-dot {
        width: 7px;
        height: 7px;
        border-radius: 9999px;
        background: #F2AF0D;
        animation: live-pulse 2.4s ease-out infinite;
    }
    @keyframes live-pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(242, 175, 13, 0.5);
        }
        70% {
            box-shadow: 0 0 0 7px rgba(242, 175, 13, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(242, 175, 13, 0);
        }
    }

    /* Social icons */
    .hero-social {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition:
            color 0.25s ease,
            transform 0.25s ease;
    }
    .hero-social:hover {
        transform: translateY(-2px);
    }

    /* Carousel nav arrows (desktop) */
    .hero-nav-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 9999px;
        color: #F3ECDD;
        background: rgba(12, 10, 9, 0.35);
        border: 1px solid rgba(243, 236, 221, 0.18);
        backdrop-filter: blur(6px);
        cursor: pointer;
        opacity: 0.7;
        transition:
            opacity 0.25s ease,
            background-color 0.25s ease,
            border-color 0.25s ease,
            transform 0.25s ease;
    }
    .hero-nav-btn:hover {
        opacity: 1;
        background: rgba(12, 10, 9, 0.6);
        border-color: rgba(242, 175, 13, 0.7);
        color: #F2AF0D;
    }
    .hero-nav-btn:focus-visible {
        outline: 2px solid #F2AF0D;
        outline-offset: 2px;
        opacity: 1;
    }

    .hero-arrow {
        transition: transform 0.3s ease;
    }
    .hero-link:hover .hero-arrow {
        transform: translateX(4px);
    }
    .archive-link:hover {
        color: #F2AF0D;
    }

    /* Marquee */
    .marquee-track {
        display: flex;
        width: max-content;
        animation: marquee 48s linear infinite;
    }
    .marquee:hover .marquee-track {
        animation-play-state: paused;
    }
    .marquee-item {
        white-space: nowrap;
    }
    @keyframes marquee {
        to {
            transform: translateX(-50%);
        }
    }

    /* Entrance reveal */
    .hero-reveal {
        opacity: 0;
        transform: translateY(26px);
        animation: reveal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .hero-reveal-2 {
        animation-delay: 0.12s;
    }
    @keyframes reveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-slide,
        .kb-img,
        .live-dot,
        .hero-arrow,
        .marquee-track,
        .hero-reveal {
            animation: none !important;
            transition: none;
        }
        .hero-reveal {
            opacity: 1;
            transform: none;
        }
        .kb-img {
            transform: scale(1.02);
        }
    }
</style>

<script define:vars={{ featured }}>
    (() => {
        const section = document.getElementById("hero");
        if (!section || featured.length === 0) return;

        const figs = Array.from(section.querySelectorAll("[data-slide]"));
        const link = document.getElementById("hero-link");
        const titleEl = document.getElementById("hero-title");
        const ctaText = document.getElementById("hero-cta-text");
        const arrowIcon = document.getElementById("hero-arrow-icon");
        const playIcon = document.getElementById("hero-play-icon");
        const prevBtn = document.getElementById("hero-prev");
        const nextBtn = document.getElementById("hero-next");
        const videoTrigger = document.getElementById("hero-video-trigger");

        const reduce = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;
        const INTERVAL = 7000;
        let current = 0;
        let elapsed = 0;
        let last = performance.now();

        function show(i) {
            current = i;
            const s = featured[i];
            figs.forEach((el, n) => el.classList.toggle("is-active", n === i));
            if (titleEl) titleEl.textContent = s.title;
            if (ctaText)
                ctaText.textContent = s.isTrailer ? "Ver tráiler" : "Leer la nota";
            if (arrowIcon) arrowIcon.classList.toggle("hidden", s.isTrailer);
            if (playIcon) playIcon.classList.toggle("hidden", !s.isTrailer);
            if (link) {
                link.setAttribute("href", s.href);
                link.setAttribute("target", s.isTrailer ? "_blank" : "_self");
            }
        }

        function go(dir) {
            elapsed = 0;
            last = performance.now();
            show((current + dir + featured.length) % featured.length);
        }

        function loop(now) {
            const dt = now - last;
            last = now;
            elapsed += dt;
            if (elapsed >= INTERVAL) {
                elapsed = 0;
                show((current + 1) % featured.length);
            }
            requestAnimationFrame(loop);
        }

        // Trailers open the modal; notes navigate
        if (link) {
            link.addEventListener("click", (e) => {
                const s = featured[current];
                if (!s.isTrailer || !s.videoUrl || !videoTrigger) return;
                e.preventDefault();
                videoTrigger.setAttribute("data-video-url", s.videoUrl);
                videoTrigger.click();
            });
        }

        // Manual navigation — desktop arrows
        if (prevBtn) prevBtn.addEventListener("click", () => go(-1));
        if (nextBtn) nextBtn.addEventListener("click", () => go(1));

        // Manual navigation — mobile swipe
        let touchX = 0;
        let touchY = 0;
        section.addEventListener(
            "touchstart",
            (e) => {
                touchX = e.changedTouches[0].clientX;
                touchY = e.changedTouches[0].clientY;
            },
            { passive: true },
        );
        section.addEventListener(
            "touchend",
            (e) => {
                const dx = e.changedTouches[0].clientX - touchX;
                const dy = e.changedTouches[0].clientY - touchY;
                if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) {
                    go(dx < 0 ? 1 : -1);
                }
            },
            { passive: true },
        );

        document.addEventListener("visibilitychange", () => {
            if (!document.hidden) last = performance.now();
        });

        if (!reduce && featured.length > 1) {
            last = performance.now();
            requestAnimationFrame(loop);
        }
    })();
</script>
