---
import { getCollection } from "astro:content";

const baseUrl = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL;

const allPosts = await getCollection("posts");
const latest = allPosts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 8);

const fmtDate = (d: Date) =>
    d
        .toLocaleDateString("es-ES", {
            day: "numeric",
            month: "short",
            year: "numeric",
        })
        .replace(/\./g, "");

const featured = latest.slice(0, 5).map((p) => {
    const videoUrl = p.data.videoUrl || "";
    const isTrailer = videoUrl !== "";
    return {
        title: p.data.title,
        category: p.data.category,
        date: fmtDate(p.data.pubDate),
        read: (p.data.readTime || "").replace(/read/i, "").trim() || "—",
        image: p.data.image.startsWith("/")
            ? `${baseUrl}${p.data.image}`
            : p.data.image,
        videoUrl,
        isTrailer,
        href: isTrailer ? videoUrl : `${baseUrl}/posts/${p.slug}`,
    };
});

const marquee = latest.map((p) => ({
    title: p.data.title,
    href: p.data.videoUrl || `${baseUrl}/posts/${p.slug}`,
}));

const first = featured[0];
const archiveHref = `${baseUrl}/archive`;
---

<section
    id="hero"
    class="hero-cover relative w-full overflow-hidden bg-[#0c0a09] text-[#F3ECDD] h-[80svh] min-h-[600px] lg:h-[84svh] lg:max-h-[820px]"
    aria-label="En cartelera — últimas noticias"
>
    <!-- Full-bleed stills -->
    <div class="absolute inset-0 z-0">
        {
            featured.map((s, i) => (
                <figure
                    data-slide={i}
                    class={`hero-slide absolute inset-0 ${i === 0 ? "is-active" : ""}`}
                >
                    <img
                        src={s.image}
                        alt=""
                        class="kb-img h-full w-full object-cover"
                        loading={i === 0 ? "eager" : "lazy"}
                        decoding="async"
                        aria-hidden="true"
                    />
                </figure>
            ))
        }
    </div>

    <!-- Cinematic light grade -->
    <div
        class="absolute inset-0 z-10 bg-gradient-to-t from-[#0c0a09]/90 via-[#0c0a09]/35 to-transparent dark:from-[#0c0a09] dark:via-[#0c0a09]/75 dark:to-[#0c0a09]/25"
    >
    </div>
    <div
        class="absolute inset-0 z-10 bg-gradient-to-b from-black/30 via-transparent to-transparent dark:from-black/55"
    >
    </div>
    <div class="hero-grain absolute inset-0 z-10 pointer-events-none"></div>

    <!-- Content -->
    <div
        class="relative z-20 h-full max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 flex flex-col justify-between pt-7 sm:pt-9 pb-16 sm:pb-20"
    >
        <!-- Eyebrow row -->
        <div class="hero-reveal flex items-start justify-end gap-4">
            <div class="text-right shrink-0">
                <p
                    class="ff-mono inline-flex items-center gap-2 text-[10px] sm:text-[11px] uppercase tracking-[0.28em] text-[#F2AF0D]"
                >
                    <span class="live-dot"></span>
                    En cartelera
                </p>
                <a
                    href={archiveHref}
                    class="archive-link ff-mono block mt-2 text-[10px] sm:text-[11px] uppercase tracking-[0.2em] text-[#F3ECDD]/45 transition-colors"
                >
                    Archivo &#8599;
                </a>
            </div>
        </div>

        <!-- Protagonist -->
        <div class="hero-reveal hero-reveal-2 max-w-5xl">
            <a id="hero-link" href={first.href} class="hero-link block group">
                <span
                    class="ff-mono inline-flex items-center gap-2 text-[10px] sm:text-[11px] uppercase tracking-[0.3em] text-[#F2AF0D] mb-4"
                >
                    Lo último
                </span>

                <h1
                    id="hero-title"
                    class="ff-display font-semibold normal-case tracking-[-0.02em] leading-[0.95] text-[2.1rem] sm:text-6xl lg:text-7xl xl:text-[5.2rem] text-[#F3ECDD] [text-wrap:balance] line-clamp-3"
                >
                    {first.title}
                </h1>

                <span
                    class="hero-cta ff-mono mt-6 inline-flex items-center gap-2.5 text-xs sm:text-sm uppercase tracking-[0.18em] text-[#F3ECDD] border-b border-[#F2AF0D]/40 pb-1"
                >
                    <span id="hero-cta-text"
                        >{first.isTrailer ? "Ver tráiler" : "Leer la nota"}</span
                    >
                    <svg
                        id="hero-arrow-icon"
                        class={`hero-arrow ${first.isTrailer ? "hidden" : ""}`}
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M5 12h14"></path>
                        <path d="m12 5 7 7-7 7"></path>
                    </svg>
                    <svg
                        id="hero-play-icon"
                        class={`hero-arrow ${first.isTrailer ? "" : "hidden"}`}
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                    >
                        <path d="M8 5.14v14l11-7-11-7z"></path>
                    </svg>
                </span>
            </a>

            <!-- Ficha técnica -->
            <div
                class="ff-mono mt-8 sm:mt-10 flex flex-wrap items-end gap-x-6 gap-y-4 sm:gap-x-9"
            >
                <div class="ficha-cell">
                    <span class="ficha-label">Sección</span>
                    <span id="hero-cat" class="ficha-value">{first.category}</span
                    >
                </div>
                <span class="ficha-div"></span>
                <div class="ficha-cell">
                    <span class="ficha-label">Publicado</span>
                    <span id="hero-date" class="ficha-value">{first.date}</span>
                </div>
                <span class="ficha-div"></span>
                <div class="ficha-cell">
                    <span class="ficha-label">Lectura</span>
                    <span id="hero-read" class="ficha-value">{first.read}</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Marquee ticker -->
    <div
        class="marquee absolute bottom-0 inset-x-0 z-20 border-t border-black/10 bg-white/90 dark:border-[#F3ECDD]/10 dark:bg-[#0c0a09]/70 backdrop-blur-sm overflow-hidden"
    >
        <div class="marquee-track ff-mono text-[11px] sm:text-xs uppercase tracking-[0.18em] py-3">
            {
                [0, 1].map((dup) => (
                    <div
                        class="marquee-group flex items-center shrink-0"
                        aria-hidden={dup === 1 ? "true" : undefined}
                    >
                        {marquee.map((m) => (
                            <a href={m.href} class="marquee-item">
                                <span class="text-[#F2AF0D] mx-4 sm:mx-6">&#10038;</span>
                                <span class="text-[#0c0a09]/70 hover:text-[#0c0a09] dark:text-[#F3ECDD]/70 dark:hover:text-[#F3ECDD] transition-colors">
                                    {m.title}
                                </span>
                            </a>
                        ))}
                    </div>
                ))
            }
        </div>
    </div>

    {
        featured.length > 1 && (
            <div class="hero-nav hidden md:block">
                <button
                    id="hero-prev"
                    type="button"
                    class="hero-nav-btn absolute left-4 lg:left-6 top-1/2 -translate-y-1/2 z-30"
                    aria-label="Artículo anterior"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="m15 18-6-6 6-6" />
                    </svg>
                </button>
                <button
                    id="hero-next"
                    type="button"
                    class="hero-nav-btn absolute right-4 lg:right-6 top-1/2 -translate-y-1/2 z-30"
                    aria-label="Artículo siguiente"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="m9 18 6-6-6-6" />
                    </svg>
                </button>
            </div>
        )
    }

    <!-- Hidden trigger reusing the global VideoModal -->
    <a
        id="hero-video-trigger"
        class="video-trigger hidden"
        data-video-url=""
        aria-hidden="true"
        tabindex="-1"></a>
</section>

<style>
    .ff-display {
        font-family: "Manrope", system-ui, sans-serif;
    }
    .ff-mono {
        font-family: "DM Mono", ui-monospace, SFMono-Regular, monospace;
    }

    /* Stills crossfade + slow drift */
    .hero-slide {
        opacity: 0;
        transition: opacity 1.2s ease;
    }
    .hero-slide.is-active {
        opacity: 1;
    }
    .kb-img {
        transform: scale(1.05);
        will-change: transform;
    }
    .hero-slide.is-active .kb-img {
        animation: kb 9s ease-out forwards;
    }
    @keyframes kb {
        from {
            transform: scale(1.05);
        }
        to {
            transform: scale(1.15);
        }
    }

    /* Film grain texture */
    .hero-grain {
        background-image: url("https://www.transparenttextures.com/patterns/film-grain.png");
        opacity: 0.04;
    }

    /* Live indicator */
    .live-dot {
        width: 7px;
        height: 7px;
        border-radius: 9999px;
        background: #F2AF0D;
        animation: live-pulse 2.4s ease-out infinite;
    }
    @keyframes live-pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.5);
        }
        70% {
            box-shadow: 0 0 0 7px rgba(212, 175, 55, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(212, 175, 55, 0);
        }
    }

    /* Ficha técnica */
    .ficha-cell {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }
    .ficha-label {
        font-size: 9px;
        letter-spacing: 0.26em;
        text-transform: uppercase;
        color: rgba(243, 236, 221, 0.38);
    }
    .ficha-value {
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: rgba(243, 236, 221, 0.92);
    }
    .ficha-div {
        width: 1px;
        align-self: stretch;
        min-height: 2.1rem;
        background: rgba(243, 236, 221, 0.16);
    }

    /* Carousel nav arrows (desktop) */
    .hero-nav-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 9999px;
        color: #F3ECDD;
        background: rgba(12, 10, 9, 0.35);
        border: 1px solid rgba(243, 236, 221, 0.18);
        backdrop-filter: blur(6px);
        cursor: pointer;
        opacity: 0.7;
        transition:
            opacity 0.25s ease,
            background-color 0.25s ease,
            border-color 0.25s ease,
            transform 0.25s ease;
    }
    .hero-nav-btn:hover {
        opacity: 1;
        background: rgba(12, 10, 9, 0.6);
        border-color: rgba(242, 175, 13, 0.7);
        color: #F2AF0D;
    }
    .hero-nav-btn:focus-visible {
        outline: 2px solid #F2AF0D;
        outline-offset: 2px;
        opacity: 1;
    }

    .hero-arrow {
        transition: transform 0.3s ease;
    }
    .hero-link:hover .hero-arrow {
        transform: translateX(4px);
    }
    .archive-link:hover {
        color: #F2AF0D;
    }

    /* Marquee */
    .marquee-track {
        display: flex;
        width: max-content;
        animation: marquee 48s linear infinite;
    }
    .marquee:hover .marquee-track {
        animation-play-state: paused;
    }
    .marquee-item {
        white-space: nowrap;
    }
    @keyframes marquee {
        to {
            transform: translateX(-50%);
        }
    }

    /* Entrance reveal */
    .hero-reveal {
        opacity: 0;
        transform: translateY(26px);
        animation: reveal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .hero-reveal-2 {
        animation-delay: 0.12s;
    }
    @keyframes reveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-slide,
        .kb-img,
        .live-dot,
        .hero-arrow,
        .marquee-track,
        .hero-reveal {
            animation: none !important;
            transition: none;
        }
        .hero-reveal {
            opacity: 1;
            transform: none;
        }
        .kb-img {
            transform: scale(1.02);
        }
    }
</style>

<script define:vars={{ featured }}>
    (() => {
        const section = document.getElementById("hero");
        if (!section || featured.length === 0) return;

        const figs = Array.from(section.querySelectorAll("[data-slide]"));
        const link = document.getElementById("hero-link");
        const titleEl = document.getElementById("hero-title");
        const catEl = document.getElementById("hero-cat");
        const dateEl = document.getElementById("hero-date");
        const readEl = document.getElementById("hero-read");
        const ctaText = document.getElementById("hero-cta-text");
        const arrowIcon = document.getElementById("hero-arrow-icon");
        const playIcon = document.getElementById("hero-play-icon");
        const prevBtn = document.getElementById("hero-prev");
        const nextBtn = document.getElementById("hero-next");
        const videoTrigger = document.getElementById("hero-video-trigger");

        const reduce = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;
        const INTERVAL = 7000;
        let current = 0;
        let elapsed = 0;
        let last = performance.now();

        function show(i) {
            current = i;
            const s = featured[i];
            figs.forEach((el, n) => el.classList.toggle("is-active", n === i));
            if (titleEl) titleEl.textContent = s.title;
            if (catEl) catEl.textContent = s.category;
            if (dateEl) dateEl.textContent = s.date;
            if (readEl) readEl.textContent = s.read;
            if (ctaText)
                ctaText.textContent = s.isTrailer ? "Ver tráiler" : "Leer la nota";
            if (arrowIcon) arrowIcon.classList.toggle("hidden", s.isTrailer);
            if (playIcon) playIcon.classList.toggle("hidden", !s.isTrailer);
            if (link) {
                link.setAttribute("href", s.href);
                link.setAttribute("target", s.isTrailer ? "_blank" : "_self");
            }
        }

        function go(dir) {
            elapsed = 0;
            last = performance.now();
            show((current + dir + featured.length) % featured.length);
        }

        function loop(now) {
            const dt = now - last;
            last = now;
            elapsed += dt;
            if (elapsed >= INTERVAL) {
                elapsed = 0;
                show((current + 1) % featured.length);
            }
            requestAnimationFrame(loop);
        }

        // Trailers open the modal; notes navigate
        if (link) {
            link.addEventListener("click", (e) => {
                const s = featured[current];
                if (!s.isTrailer || !s.videoUrl || !videoTrigger) return;
                e.preventDefault();
                videoTrigger.setAttribute("data-video-url", s.videoUrl);
                videoTrigger.click();
            });
        }

        // Manual navigation — desktop arrows
        if (prevBtn) prevBtn.addEventListener("click", () => go(-1));
        if (nextBtn) nextBtn.addEventListener("click", () => go(1));

        // Manual navigation — mobile swipe
        let touchX = 0;
        let touchY = 0;
        section.addEventListener(
            "touchstart",
            (e) => {
                touchX = e.changedTouches[0].clientX;
                touchY = e.changedTouches[0].clientY;
            },
            { passive: true },
        );
        section.addEventListener(
            "touchend",
            (e) => {
                const dx = e.changedTouches[0].clientX - touchX;
                const dy = e.changedTouches[0].clientY - touchY;
                if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) {
                    go(dx < 0 ? 1 : -1);
                }
            },
            { passive: true },
        );

        document.addEventListener("visibilitychange", () => {
            if (!document.hidden) last = performance.now();
        });

        if (!reduce && featured.length > 1) {
            last = performance.now();
            requestAnimationFrame(loop);
        }
    })();
</script>
