---
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
const latestPost = allPosts.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)[0];
---

<section
    class="relative min-h-[70vh] flex items-center justify-center overflow-hidden bg-[#0c0a09] text-white"
>
    <!-- Simplified Background -->
    <div class="absolute inset-0 z-0 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-t from-[#0c0a09] to-[#1c1917] z-10"></div>
        <!-- Subtle pattern remains -->
        <div class="absolute inset-0 opacity-[0.03] pointer-events-none z-20 bg-[url('https://www.transparenttextures.com/patterns/film-grain.png')]"></div>
    </div>

    <!-- Theatrical Accent Lines -->
    <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#d97706]/60 to-transparent z-20"></div>
    <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#d97706]/60 to-transparent z-20"></div>

    <div class="relative z-30 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <!-- Badge -->
        <div class="inline-flex items-center px-6 py-2 rounded-full border border-[#d97706]/40 bg-[#d97706]/10 text-[#d97706] text-[11px] font-black uppercase tracking-[0.4em] mb-12 animate-fade-in shadow-[0_0_25px_rgba(217,119,6,0.15)]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#d97706] mr-3 animate-pulse"></span>
            Ruta Dorada Film
        </div>

        <!-- Main Heading -->
        <h1 class="text-6xl md:text-[8rem] font-black tracking-tighter mb-10 leading-[0.9] uppercase select-none">
            Celebremos <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-tr from-[#d97706] via-amber-200 to-white drop-shadow-2xl">
                el cine juntos
            </span>
        </h1>

        <!-- CTA Buttons -->
        <div class="mt-20 flex flex-col sm:flex-row justify-center gap-10">
            <a
                class="group relative px-14 py-6 overflow-hidden bg-[#d97706] text-white font-black tracking-[0.3em] uppercase transition-all hover:scale-105 active:scale-95 shadow-[0_20px_50px_-15px_rgba(217,119,6,0.6)]"
                href={latestPost ? `${import.meta.env.BASE_URL}/posts/${latestPost.slug}` : `${import.meta.env.BASE_URL}/archive`}
            >
                <span class="relative z-10">Lo último</span>
                <div class="absolute inset-0 bg-white/30 translate-x-[-100%] group-hover:translate-x-0 transition-transform duration-500 cubic-bezier(0.85, 0, 0.15, 1)"></div>
            </a>
            <a
                class="px-14 py-6 border-2 border-white/40 hover:border-white text-white font-black tracking-[0.3em] uppercase transition-all hover:bg-white/5 backdrop-blur-lg"
                href={`${import.meta.env.BASE_URL}/archive`}
            >
                Archivo de publicaciones
            </a>
        </div>
    </div>

</section>

<style>
    @keyframes fade-in {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
        animation: fade-in 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .animate-bounce-slow {
        animation: bounce-slow 3s infinite;
    }
    @keyframes bounce-slow {
        0%, 100% { transform: translate(-50%, 0); }
        50% { transform: translate(-50%, 10px); }
    }
</style>
