---
// Modal de calificaciones de un festival. Se instancia una vez por festival:
// el script se emite una sola vez y recorre todos los diálogos de la página,
// así que la configuración viaja en data-attributes y no en ids fijos.
type Source = { name: string; url?: string };

interface Props {
    festival: string;
    kicker: string;
    titleLead: string;
    titleAccent: string;
    footer: string;
    sources: Source[];
    hash: string;
    /** Columna del promedio: se pinta en dorado. */
    highlightColumn: number;
}

const { festival, kicker, titleLead, titleAccent, footer, sources, hash, highlightColumn } = Astro.props;
---

<dialog
    data-ratings-modal
    data-festival={festival}
    data-hash={hash}
    data-highlight={String(highlightColumn)}
    class="bg-transparent m-auto p-0 backdrop:backdrop-blur-md backdrop:bg-black/80 w-full max-w-5xl rounded-2xl shadow-2xl border border-white/10 outline-none"
>
    <div class="bg-background-dark text-white max-h-[90vh] flex flex-col rounded-2xl overflow-hidden relative">
        <!-- Header -->
        <!-- En móvil el encabezado se apila: si la fila se mantiene, el bloque de
             fuentes (que no encoge) deja al título con ~70px y las palabras largas
             se desbordan encima del texto de al lado. -->
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 px-6 sm:px-8 pt-6 pb-5 border-b border-white/10">
            <!-- Title block -->
            <div class="order-2 sm:order-1 w-full min-w-0 sm:flex-1">
                <span class="inline-block text-[10px] font-bold uppercase tracking-[0.25em] text-primary mb-2">
                    {kicker}
                </span>
                <h2 class="font-display font-bold text-2xl sm:text-3xl leading-tight">
                    {titleLead} <span class="text-primary">{titleAccent}</span>
                </h2>
                <p data-role="updated" class="text-xs text-slate-400 mt-2 uppercase tracking-widest">
                    Cargando…
                </p>
            </div>

            <!-- Right column: buttons + sources -->
            <div class="order-1 sm:order-2 w-full sm:w-auto flex flex-row-reverse items-center justify-between sm:flex-col sm:items-end sm:justify-start gap-3 flex-shrink-0">
                <div class="flex items-center gap-2">
                    <button
                        data-role="share"
                        type="button"
                        class="bg-white/5 hover:bg-white/10 text-white rounded-full p-2 transition-colors border border-white/10"
                        aria-label="Copiar link"
                        title="Copiar link"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="18" cy="5" r="3"></circle>
                            <circle cx="6" cy="12" r="3"></circle>
                            <circle cx="18" cy="19" r="3"></circle>
                            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                        </svg>
                    </button>
                    <button
                        data-role="close"
                        type="button"
                        class="bg-white/5 hover:bg-white/10 text-white rounded-full p-2 transition-colors border border-white/10"
                        aria-label="Cerrar"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
                <div class="min-w-0 text-left sm:text-right">
                    <p class="text-[10px] uppercase tracking-[0.18em] text-slate-500 mb-1.5 font-bold">
                        Fuentes
                    </p>
                    <p class="text-xs text-slate-400 leading-tight">
                        {sources.map((source, i) => (
                            <>
                                {i > 0 && <span class="text-slate-600 mx-1">·</span>}
                                {source.url ? (
                                    <a
                                        href={source.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="hover:text-primary transition-colors underline-offset-2 hover:underline"
                                    >{source.name}</a>
                                ) : (
                                    <span>{source.name}</span>
                                )}
                            </>
                        ))}
                    </p>
                </div>
            </div>
        </div>

        <!-- Toast for share feedback -->
        <div
            data-role="toast"
            class="hidden absolute top-5 left-1/2 -translate-x-1/2 z-50 bg-primary text-background-dark text-xs font-bold py-2 px-4 rounded-full shadow-lg pointer-events-none"
        >
            Link copiado
        </div>

        <!-- Body -->
        <div class="flex-1 overflow-y-auto px-4 sm:px-8 py-6">
            <div data-role="loading" class="text-center py-12 text-slate-400 text-sm">
                Cargando calificaciones…
            </div>
            <div data-role="error" class="hidden text-center py-12 text-red-400 text-sm"></div>
            <div data-role="empty" class="hidden text-center py-12 text-slate-400 text-sm">
                Aún no hay calificaciones cargadas.
            </div>
            <div data-role="table-wrap" class="hidden overflow-x-auto rounded-xl border border-white/10">
                <table class="w-full text-sm">
                    <thead class="bg-card-dark">
                        <tr data-role="thead" class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary"></tr>
                    </thead>
                    <tbody data-role="tbody" class="bg-background-dark"></tbody>
                </table>
            </div>
        </div>

        <!-- Footer -->
        <div class="px-6 sm:px-8 py-4 border-t border-white/10 text-[11px] text-slate-500 uppercase tracking-widest text-center">
            {footer}
        </div>
    </div>
</dialog>

<script>
    function setupRatingsModal(modal: HTMLDialogElement) {
        if (modal.dataset.ready === '1') return;
        modal.dataset.ready = '1';

        const festival = modal.dataset.festival || 'cannes';
        const hash = modal.dataset.hash || '';
        const highlight = Number(modal.dataset.highlight ?? '1');

        const trigger = document.querySelector('[data-ratings-trigger="' + festival + '"]');
        const closeBtn = modal.querySelector('[data-role="close"]');
        const shareBtn = modal.querySelector('[data-role="share"]');
        const shareToast = modal.querySelector('[data-role="toast"]');
        const loadingEl = modal.querySelector('[data-role="loading"]');
        const errorEl = modal.querySelector('[data-role="error"]');
        const emptyEl = modal.querySelector('[data-role="empty"]');
        const tableWrap = modal.querySelector('[data-role="table-wrap"]');
        const thead = modal.querySelector('[data-role="thead"]');
        const tbody = modal.querySelector('[data-role="tbody"]');
        const updatedEl = modal.querySelector('[data-role="updated"]');

        if (!closeBtn) return;

        let loaded = false;
        let loading = false;

        function escapeHtml(s: string) {
            return String(s)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function showState(state: 'loading' | 'error' | 'empty' | 'table', message?: string) {
            loadingEl?.classList.toggle('hidden', state !== 'loading');
            errorEl?.classList.toggle('hidden', state !== 'error');
            emptyEl?.classList.toggle('hidden', state !== 'empty');
            tableWrap?.classList.toggle('hidden', state !== 'table');
            if (state === 'error' && errorEl && message) errorEl.textContent = message;
        }

        async function loadSnapshot() {
            if (loaded || loading) return;
            loading = true;
            showState('loading');
            try {
                const res = await fetch('/api/cannes/latest?festival=' + encodeURIComponent(festival), {
                    headers: { 'Accept': 'application/json' },
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || !data.ok) {
                    showState('error', data.error || 'No se pudieron cargar las calificaciones.');
                    return;
                }
                const snapshot = data.snapshot as {
                    headers: string[];
                    rows: Array<Array<{ runs: Array<{ text: string; bold: boolean }> }>>;
                    updatedAt: string;
                };

                if (updatedEl) {
                    if (snapshot.updatedAt) {
                        const d = new Date(snapshot.updatedAt).toLocaleDateString('es-ES', {
                            year: 'numeric', month: 'long', day: 'numeric'
                        });
                        updatedEl.textContent = 'Actualizado · ' + d;
                    } else {
                        updatedEl.textContent = 'Sin datos aún';
                    }
                }

                if (!snapshot.headers.length || !snapshot.rows.length) {
                    showState('empty');
                    return;
                }

                function cellToHtml(cell: { runs?: Array<{ text: string; bold: boolean }> }) {
                    if (!cell || !cell.runs || cell.runs.length === 0) return '—';
                    const hasContent = cell.runs.some((r) => (r.text || '').trim() !== '');
                    if (!hasContent) return '—';
                    return cell.runs.map((r) => {
                        const t = escapeHtml(r.text || '');
                        return r.bold ? '<strong>' + t + '</strong>' : t;
                    }).join('');
                }

                if (thead) {
                    thead.innerHTML = snapshot.headers.map((h, i) => {
                        const headerCls = i === 0
                            ? 'text-left'
                            : i === highlight
                                ? 'text-center text-primary bg-primary/8'
                                : 'text-center';
                        return '<th class="' + headerCls + ' py-3 px-3 sm:px-4 font-bold whitespace-nowrap">' + escapeHtml(h) + '</th>';
                    }).join('');
                }
                if (tbody) {
                    tbody.innerHTML = snapshot.rows.map((row, idx) => {
                        const stripe = idx % 2 === 0 ? 'bg-background-dark' : 'bg-card-dark/60';
                        return '<tr class="border-t border-white/5 ' + stripe + ' hover:bg-primary/5 transition-colors">' +
                            row.map((cell: any, i: number) => {
                                const cls = i === 0
                                    ? 'text-white font-normal'
                                    : i === highlight
                                        ? 'text-center text-primary font-bold tabular-nums bg-primary/5'
                                        : 'text-center text-slate-200 tabular-nums font-medium';
                                return '<td class="py-3 px-3 sm:px-4 ' + cls + '">' + cellToHtml(cell) + '</td>';
                            }).join('') +
                            '</tr>';
                    }).join('');
                }
                showState('table');
                loaded = true;
            } catch (err) {
                showState('error', 'No pude conectar con el servidor.');
            } finally {
                loading = false;
            }
        }

        const openModal = () => {
            if (!modal.open) {
                modal.showModal();
                loadSnapshot();
            }
        };

        trigger?.addEventListener('click', (e) => {
            e.preventDefault();
            openModal();
        });

        closeBtn.addEventListener('click', () => modal.close());

        modal.addEventListener('click', (e: MouseEvent) => {
            const rect = modal.getBoundingClientRect();
            const inDialog = rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
                             rect.left <= e.clientX && e.clientX <= rect.left + rect.width;
            if (!inDialog) modal.close();
        });

        // Share button: Web Share API on mobile, clipboard fallback on desktop
        function getShareUrl() {
            return window.location.origin + window.location.pathname + hash;
        }

        function showToast(text: string) {
            if (!shareToast) return;
            shareToast.textContent = text;
            shareToast.classList.remove('hidden');
            window.setTimeout(() => shareToast.classList.add('hidden'), 2000);
        }

        async function copyToClipboard(url: string) {
            try {
                await navigator.clipboard.writeText(url);
                showToast('Link copiado');
            } catch (e) {
                // Fallback ultraconservador: input temporal + execCommand
                const tmp = document.createElement('input');
                tmp.value = url;
                tmp.style.position = 'fixed';
                tmp.style.opacity = '0';
                document.body.appendChild(tmp);
                tmp.select();
                try { document.execCommand('copy'); showToast('Link copiado'); }
                catch (err) { showToast('No se pudo copiar'); }
                tmp.remove();
            }
        }

        shareBtn?.addEventListener('click', async () => {
            await copyToClipboard(getShareUrl());
        });

        // Auto-abrir si el hash lo solicita
        function checkHashAutoOpen() {
            if (hash && window.location.hash === hash) {
                openModal();
            }
        }
        checkHashAutoOpen();
        window.addEventListener('hashchange', checkHashAutoOpen);
    }

    function setupRatingsModals() {
        document.querySelectorAll<HTMLDialogElement>('dialog[data-ratings-modal]').forEach(setupRatingsModal);
    }

    document.addEventListener('DOMContentLoaded', setupRatingsModals);
    document.addEventListener('astro:page-load', setupRatingsModals);
</script>
