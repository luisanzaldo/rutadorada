---
interface Props {
  rating: number;
}
const { rating } = Astro.props;

// Calculate rotation for the needle
// A standard arc from -120 deg (0) to +120 deg (100) -> 240 degrees span
const arcRotation = (rating / 100) * 240 - 120;
---

<div class="flex flex-col items-center justify-center mt-16 mb-8 py-10 px-4 bg-[#D4AF37]/5 rounded-3xl border border-[#D4AF37]/20 relative overflow-hidden">
    <div class="absolute top-0 left-0 h-full w-1 bg-[#D4AF37]"></div>
    
    <div class="text-center mb-6 relative z-10">
        <h3 class="text-2xl sm:text-3xl font-extrabold font-display text-slate-900 dark:text-white uppercase tracking-widest">
            Calificación
        </h3>
        <p class="text-xs sm:text-sm text-[#D4AF37] uppercase tracking-widest font-bold mt-2">
            Ruta Dorada Score
        </p>
    </div>
    
    <div class="relative w-64 h-64 sm:w-72 sm:h-72 flex items-center justify-center">
        <!-- SVG Speedometer Graphic -->
        <svg class="w-full h-full drop-shadow-2xl" viewBox="0 0 200 200">
            <defs>
                <linearGradient id="gaugeGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#ef4444" /> <!-- Red -->
                    <stop offset="40%" stop-color="#eab308" /> <!-- Yellow -->
                    <stop offset="100%" stop-color="#2bb24c" /> <!-- Green -->
                </linearGradient>
                <linearGradient id="goldGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#FCEECA" />
                    <stop offset="50%" stop-color="#D4AF37" />
                    <stop offset="100%" stop-color="#997A15" />
                </linearGradient>
                <radialGradient id="dialBackground" cx="50%" cy="50%" r="50%">
                    <stop offset="70%" stop-color="#111827" stop-opacity="1" class="dark:stop-color-[#091215]" />
                    <stop offset="100%" stop-color="#020617" stop-opacity="1" class="dark:stop-color-[#040809]" />
                </radialGradient>
                <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                    <feGaussianBlur stdDeviation="2" result="blur" />
                    <feComposite in="SourceGraphic" in2="blur" operator="over" />
                </filter>
            </defs>

            <!-- Outer Bezel -->
            <circle cx="100" cy="100" r="95" fill="#1e293b" class="dark:fill-[#0c1214]" />
            <circle cx="100" cy="100" r="92" fill="url(#dialBackground)" />
            <circle cx="100" cy="100" r="95" fill="none" stroke="url(#goldGradient)" stroke-width="3" />
            
            <!-- Metallic inner dashed ring -->
            <circle cx="100" cy="100" r="80" fill="none" stroke="#D4AF37" stroke-opacity="0.3" stroke-width="1" stroke-dasharray="2 4" />
            
            <!-- Arc track background -->
            <path d="M 30.7 140 A 80 80 0 1 1 169.3 140" fill="none" stroke="#D4AF37" stroke-opacity="0.1" stroke-width="10" stroke-linecap="round" />
            
            <!-- Colored rating gradient arc -->
            <path d="M 30.7 140 A 80 80 0 1 1 169.3 140" fill="none" stroke="url(#gaugeGradient)" stroke-width="10" stroke-linecap="round" />

            <!-- Tick marks and Text -->
            {Array.from({ length: 11 }).map((_, i) => {
                const tickVal = i * 10;
                const angle = (tickVal / 100) * 240 - 120;
                const rad = (angle - 90) * (Math.PI / 180);
                const x1 = 100 + 70 * Math.cos(rad);
                const y1 = 100 + 70 * Math.sin(rad);
                const x2 = 100 + 64 * Math.cos(rad);
                const y2 = 100 + 64 * Math.sin(rad);
                const tx = 100 + 52 * Math.cos(rad);
                const ty = 100 + 52 * Math.sin(rad);
                return (
                    <g key={i}>
                        <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="#D4AF37" stroke-opacity="0.6" stroke-width="2" />
                        <text x={tx} y={ty} fill="#D4AF37" font-size="8" font-family="sans-serif" font-weight="bold" text-anchor="middle" dominant-baseline="central">{tickVal}</text>
                    </g>
                );
            })}

            <!-- Digital readout -->
            <!-- Digital readout -->
            <rect x="75" y="135" width="50" height="24" rx="4" fill="#000000" stroke="#D4AF37" stroke-opacity="0.4" stroke-width="1" />
            <text x="100" y="152" fill="url(#goldGradient)" font-size="16" font-family="monospace" font-weight="900" text-anchor="middle" filter="url(#glow)">{rating}</text>
            <text x="100" y="172" fill="#D4AF37" stroke-opacity="0.8" font-size="7" font-family="sans-serif" font-weight="bold" text-anchor="middle" letter-spacing="2">RATING</text>

            <!-- The needle group (this rotates dynamically based on rating) -->
            <g transform={`rotate(${arcRotation}, 100, 100)`}>
                <!-- Needle body -->
                <polygon points="98,105 102,105 100,25" fill="url(#goldGradient)" filter="url(#glow)" />
                <polygon points="99,105 101,105 100,25" fill="#FFF2C8" />
                <!-- Center cap -->
                <circle cx="100" cy="100" r="12" fill="#111827" stroke="#D4AF37" stroke-width="1.5" />
                <circle cx="100" cy="100" r="8" fill="url(#goldGradient)" />
                <!-- Center pin -->
                <circle cx="100" cy="100" r="3" fill="#111827" />
            </g>
        </svg>
    </div>
</div>
