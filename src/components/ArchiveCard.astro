---
interface Props {
    title: string;
    description: string;
    image: string;
    category: string;
    date: string;
    readTime: string;
    slug: string;
    videoUrl?: string;
    tags?: string[];
}

const { title, description, image, category, date, readTime, slug, videoUrl, tags } =
    Astro.props;
const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const url = videoUrl || `${baseUrl}/posts/${slug}`;
const triggerClass = videoUrl ? "video-trigger" : "";
---

<article
    class="archive-card-container relative flex flex-col h-full rounded-xl overflow-hidden bg-background-card border border-transparent"
>
    <a
        href={url}
        class={`archive-card-link flex flex-col h-full w-full ${triggerClass}`}
        data-video-url={videoUrl}
    >
        <div
            class="w-full h-48 bg-cover bg-center relative block"
            style={`background-image: url("${image}");`}
        >
            <div
                class="absolute inset-0 bg-gradient-to-t from-background-card to-transparent opacity-80"
            >
            </div>
            <div class="absolute top-3 left-3 flex flex-wrap gap-2">
                {tags && tags.length > 0 ? (
                    tags.slice(0, 1).map((tag) => (
                        <span class="bg-background-dark/80 backdrop-blur-md text-primary text-xs font-bold px-3 py-1 rounded-full border border-primary/20">
                            {tag}
                        </span>
                    ))
                ) : (
                    <span class="bg-background-dark/80 backdrop-blur-md text-primary text-xs font-bold px-3 py-1 rounded-full border border-primary/20">
                        {category}
                    </span>
                )}
            </div>
        </div>
        <div class="flex flex-col flex-1 p-5 gap-3 text-left">
            <h3
                class="archive-title text-white text-xl font-bold leading-tight transition-colors"
            >
                {title}
            </h3>
            <p class="text-text-muted text-sm line-clamp-2">
                {description}
            </p>
            <div
                class="mt-auto pt-4 flex items-center justify-between border-t border-[#224249]/50"
            >
                <span class="text-text-muted text-xs font-mono"
                    >{date} • {readTime}</span
                >
                <div
                    class={`archive-arrow material-symbols-outlined text-[#D4AF37] text-[20px] transition-transform`}
                >
                    arrow_forward
                </div>
            </div>
        </div>
    </a>
</article>

<style>
    /* Prevent hover effects on touch devices to avoid double-tap requirement on iOS */
    @media (hover: hover) and (pointer: fine) {
        .archive-card-container {
            transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
        }

        .archive-card-link:hover .archive-title {
            color: #D4AF37;
        }

        .archive-card-link:hover .archive-arrow {
            transform: translateX(4px);
        }

        .archive-card-container:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(212, 175, 55, 0.1), 0 10px 10px -5px rgba(212, 175, 55, 0.04);
            border-color: rgba(212, 175, 55, 0.2);
        }
        
        .archive-title {
            transition: color 0.3s ease;
        }

        .archive-arrow {
            transition: transform 0.3s ease;
        }
    }

    .archive-card-link {
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
        cursor: pointer;
    }
</style>



