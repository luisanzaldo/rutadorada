---
import { renderRichText } from "../lib/richText";
import { getTagUrl } from "../lib/tags";

interface Props {
    title: string;
    description: string;
    image: string;
    category: string;
    date: string;
    readTime: string;
    slug: string;
    videoUrl?: string;
    tags?: string[];
}

const { title, description, image, category, date, readTime, slug, videoUrl, tags } =
    Astro.props;
const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const url = videoUrl || `${baseUrl}/posts/${slug}`;
const triggerClass = videoUrl ? "video-trigger" : "";

// El título y la descripción admiten negrita e itálica en línea
const titleHtml = renderRichText(title);
const descriptionHtml = renderRichText(description);
---

<article
    class="archive-card-container relative flex flex-col h-full rounded-xl overflow-hidden bg-card-light dark:bg-background-card border border-slate-200 dark:border-transparent shadow-sm dark:shadow-none"
>
    <a
        href={url}
        class={`archive-card-link flex flex-col h-full w-full ${triggerClass}`}
        data-video-url={videoUrl}
    >
        <div
            class="w-full h-48 bg-cover bg-center relative block"
            style={`background-image: url("${image}");`}
        >
            <div
                class="absolute inset-0 bg-gradient-to-t from-transparent dark:from-background-card to-transparent opacity-80"
            >
            </div>
        </div>
        <div class="flex flex-col flex-1 p-5 gap-3 text-left">
            <h3
                class="archive-title text-slate-900 dark:text-white text-xl font-bold leading-tight transition-colors"
                set:html={titleHtml}
            />
            <p
                class="text-slate-600 dark:text-text-muted text-sm line-clamp-2"
                set:html={descriptionHtml}
            />
            <div
                class="mt-auto pt-4 flex items-center justify-between border-t border-slate-200 dark:border-[#224249]/50"
            >
                <span class="text-slate-500 dark:text-text-muted text-xs font-mono"
                    >{date} • {readTime}</span
                >
                <div
                    class={`archive-arrow material-symbols-outlined text-gold text-[20px] transition-transform`}
                >
                    arrow_forward
                </div>
            </div>
        </div>
    </a>
    <!-- El badge vive fuera del enlace de la tarjeta para poder ser un enlace
         propio (no se permiten <a> anidados); se posiciona sobre la imagen. -->
    <div class="absolute top-3 left-3 z-10 flex flex-wrap gap-2">
        {tags && tags.length > 0 ? (
            tags.slice(0, 1).map((tag) => (
                <a
                    href={getTagUrl(tag)}
                    class="bg-background-dark/80 backdrop-blur-md text-primary text-xs font-bold px-3 py-1 rounded-full border border-primary/20 hover:bg-primary hover:text-background-dark transition-colors"
                    title={`Ver todos los posts con la etiqueta ${tag}`}
                >
                    {tag}
                </a>
            ))
        ) : (
            <span class="bg-background-dark/80 backdrop-blur-md text-primary text-xs font-bold px-3 py-1 rounded-full border border-primary/20">
                {category}
            </span>
        )}
    </div>
</article>

<style>
    /* Prevent hover effects on touch devices to avoid double-tap requirement on iOS */
    @media (hover: hover) and (pointer: fine) {
        .archive-card-container {
            transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
        }

        .archive-card-link:hover .archive-title {
            color: var(--gold-readable, #F2AF0D);
        }

        .archive-card-link:hover .archive-arrow {
            transform: translateX(4px);
        }

        .archive-card-container:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(242, 175, 13, 0.1), 0 10px 10px -5px rgba(242, 175, 13, 0.04);
            border-color: rgba(242, 175, 13, 0.2);
        }
        
        .archive-title {
            transition: color 0.3s ease;
        }

        .archive-arrow {
            transition: transform 0.3s ease;
        }
    }

    .archive-card-link {
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
        cursor: pointer;
    }
</style>



