---
interface Props {
    title: string;
    description: string;
    image: string;
    category: string;
    date: string;
    readTime: string;
    slug: string;
    videoUrl?: string;
    tags?: string[];
}

const { title, description, image, category, date, readTime, slug, videoUrl, tags } =
    Astro.props;
const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const url = videoUrl || `${baseUrl}/posts/${slug}`;
const triggerClass = videoUrl ? "video-trigger" : "";
const finalImage = image.startsWith('/') ? `${baseUrl}${image}` : image;
---

<article
    class="flex flex-col h-full rounded-xl overflow-hidden bg-background-card shadow-lg hover:-translate-y-1 hover:shadow-[#D4AF37]/10 hover:shadow-xl transition-all duration-300 group cursor-pointer border border-transparent hover:border-[#D4AF37]/20"
>
    <a
        href={url}
        class={`w-full h-48 relative block overflow-hidden ${triggerClass}`}
        data-video-url={videoUrl}
    >
        <img
            src={finalImage}
            alt={title}
            class="absolute inset-0 w-full h-full object-cover z-0"
            loading="lazy"
            decoding="async"
        />
        <div
            class="absolute inset-0 bg-gradient-to-t from-background-card to-transparent opacity-80 z-10 pointer-events-none"
        >
        </div>
        <div class="absolute top-3 left-3 flex flex-wrap gap-2 z-20">
            {tags && tags.length > 0 ? (
                tags.slice(0, 1).map((tag) => (
                    <span class="bg-background-dark/80 backdrop-blur-md text-primary text-xs font-bold px-3 py-1 rounded-full border border-primary/20">
                        {tag}
                    </span>
                ))
            ) : (
                <span class="bg-background-dark/80 backdrop-blur-md text-primary text-xs font-bold px-3 py-1 rounded-full border border-primary/20">
                    {category}
                </span>
            )}
        </div>
    </a>
    <div class="flex flex-col flex-1 p-5 gap-3">
        <a href={url} class={`video-trigger-link ${triggerClass}`} data-video-url={videoUrl}>
            <h3
                class="text-white text-xl font-bold leading-tight group-hover:text-[#D4AF37] transition-colors"
            >
                {title}
            </h3>
        </a>
        <p class="text-text-muted text-sm line-clamp-2">
            {description}
        </p>
        <div
            class="mt-auto pt-4 flex items-center justify-between border-t border-[#224249]/50"
        >
            <span class="text-text-muted text-xs font-mono"
                >{date} • {readTime}</span
            >
            <a
                href={url}
                class={`material-symbols-outlined text-[#D4AF37] text-[20px] group-hover:translate-x-1 transition-transform ${triggerClass}`}
                data-video-url={videoUrl}
            >
                arrow_forward
            </a>
        </div>
    </div>
</article>
