---
// ShareModal.astro
---
<dialog id="share-modal" class="bg-white dark:bg-background-card m-auto p-6 backdrop:backdrop-blur-md backdrop:bg-black/60 w-[90%] max-w-sm rounded-2xl shadow-xl border border-slate-200 dark:border-[#224249] outline-none">
    <div class="relative w-full flex flex-col gap-6">
        <!-- Header -->
        <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Compartir artículo</h3>
            <button id="close-share" class="text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors p-1" aria-label="Cerrar">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <!-- URL and Copy -->
        <div class="flex items-center gap-2 bg-slate-100 dark:bg-background-dark p-2 rounded-xl border border-slate-200 dark:border-[#224249]">
            <input type="text" id="share-url-input" class="w-full bg-transparent border-none text-sm text-slate-600 dark:text-slate-300 focus:outline-none px-2 truncate" readonly />
            <button id="modal-copy-btn" class="shrink-0 rounded-lg bg-primary py-1.5 px-3 text-xs font-bold text-[#102023] hover:bg-primary/90 transition-colors relative">
                Copiar
                <span class="absolute -top-8 left-1/2 -translate-x-1/2 bg-slate-800 dark:bg-slate-700 text-white text-[10px] py-1 px-2 rounded opacity-0 transition-opacity whitespace-nowrap modal-copy-tooltip pointer-events-none shadow-sm font-normal">Copiado</span>
            </button>
        </div>

        <!-- Social Buttons -->
        <div class="flex items-center justify-center gap-4">
            <!-- X -->
            <button class="size-10 flex items-center justify-center rounded-full bg-slate-100 dark:bg-surface-dark text-slate-600 dark:text-slate-300 hover:bg-black dark:hover:bg-white hover:text-white dark:hover:text-black transition-all modal-share-btn" data-network="x" aria-label="Compartir en X">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 1200 1227"><path d="M714.163 519.284L1160.89 0H1055.03L667.137 450.887L357.328 0H0L468.492 681.821L0 1226.37H105.866L515.491 750.218L842.672 1226.37H1200L714.137 519.284H714.163ZM569.165 687.828L521.697 619.934L144.011 79.6944H306.615L611.412 515.685L658.88 583.579L1055.08 1150.3H892.476L569.165 687.854V687.828Z"></path></svg>
            </button>
            <!-- WhatsApp -->
            <button class="size-10 flex items-center justify-center rounded-full bg-slate-100 dark:bg-surface-dark text-slate-600 dark:text-slate-300 hover:bg-[#25D366] hover:text-white transition-all modal-share-btn" data-network="whatsapp" aria-label="Compartir en WhatsApp">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg>
            </button>
            <!-- Instagram -->
            <button class="size-10 flex items-center justify-center rounded-full bg-slate-100 dark:bg-surface-dark text-slate-600 dark:text-slate-300 hover:bg-gradient-to-tr hover:from-[#f09433] hover:via-[#dc2743] hover:to-[#bc1888] hover:text-white transition-all modal-share-btn relative" data-network="instagram" aria-label="Compartir en Instagram">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </button>
        </div>
    </div>
</dialog>

<script>
    function setupShareModal() {
        const modal = document.getElementById('share-modal') as HTMLDialogElement | null;
        const closeBtn = document.getElementById('close-share');
        const urlInput = document.getElementById('share-url-input') as HTMLInputElement | null;
        const copyBtn = document.getElementById('modal-copy-btn');
        const modalShareBtns = document.querySelectorAll('.modal-share-btn');
        
        if (!modal) return;

        // Find all share buttons and attach open modal event
        const triggers = document.querySelectorAll('.trigger-share-modal');
        triggers.forEach(trigger => {
            // Need to remove any old listeners via astros view transition behavior. Safest is cloning, but eventListener works fine if tracking isn't messed up.
            trigger.removeEventListener('click', openModal);
            trigger.addEventListener('click', openModal);
        });

        function openModal(e: Event) {
            e.preventDefault();
            if (modal && urlInput) {
                const rawUrl = window.location.origin + window.location.pathname;
                urlInput.value = rawUrl;
                modal.showModal();
            }
        }

        // Close logic
        if (closeBtn) {
            closeBtn.removeEventListener('click', closeModal);
            closeBtn.addEventListener('click', closeModal);
        }
        function closeModal() {
            modal?.close();
        }

        const onModalClick = (e: MouseEvent) => {
            const rect = modal.getBoundingClientRect();
            const isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
                                rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
            if (!isInDialog) {
                closeModal();
            }
        };
        modal.removeEventListener('click', onModalClick as EventListener);
        modal.addEventListener('click', onModalClick as EventListener);

        // Copy logic
        if (copyBtn && urlInput) {
            copyBtn.removeEventListener('click', performCopy);
            copyBtn.addEventListener('click', performCopy);
        }
        function performCopy() {
            if (urlInput) {
                urlInput.select();
                urlInput.setSelectionRange(0, 99999);
                navigator.clipboard.writeText(urlInput.value).then(() => {
                    const tooltip = copyBtn?.querySelector('.modal-copy-tooltip') as HTMLElement;
                    if (tooltip) {
                        tooltip.style.opacity = '1';
                        setTimeout(() => tooltip.style.opacity = '0', 2000);
                    }
                });
            }
        }

        // Social Networks Logic
        modalShareBtns.forEach(btn => {
            const newBtn = btn.cloneNode(true) as HTMLElement;
            btn.parentNode?.replaceChild(newBtn, btn);

            newBtn.addEventListener("click", () => {
                const network = newBtn.getAttribute("data-network");
                const rawUrl = window.location.origin + window.location.pathname;
                const url = encodeURIComponent(rawUrl);
                const title = encodeURIComponent(document.title);
                const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
                
                const openWithFallback = (appUrl: string, webUrl: string) => {
                    if (isMobile) {
                        try { window.location.href = appUrl; } catch(e) {}
                        setTimeout(() => {
                            if (document.visibilityState !== 'hidden') {
                                window.location.href = webUrl;
                            }
                        }, 800);
                    } else {
                        window.open(webUrl, 'share_popup', 'width=600,height=500,noopener,noreferrer');
                    }
                };

                switch(network) {
                    case 'x':
                        openWithFallback(
                            `twitter://post?message=${title}%20${url}`,
                            `https://twitter.com/intent/tweet?url=${url}&text=${title}`
                        );
                        break;
                    case 'whatsapp':
                        openWithFallback(
                            `whatsapp://send?text=${title}%20-%20${url}`,
                            `https://api.whatsapp.com/send?text=${title}%20-%20${url}`
                        );
                        break;
                    case 'instagram':
                        const isAndroidIG = /Android/i.test(navigator.userAgent);
                        if (isAndroidIG) {
                            // Usar el Intent nativo de Android de "Compartir" (SEND) dirigido específicamente a Instagram
                            // Esto invoca la misma pantalla de "Compartir enlace" que usa el sistema operativo.
                            const intentUrl = `intent://share/#Intent;action=android.intent.action.SEND;type=text/plain;S.android.intent.extra.TEXT=${url};package=com.instagram.android;scheme=intent;end`;
                            window.location.href = intentUrl;
                        } else {
                            // iOS y escritorio: Instagram no tiene URL scheme oficial para auto-completar DMs desde la web.
                            // Copiamos al portapapeles y mandamos a la bandeja para que el usuario pegue.
                            try { navigator.clipboard.writeText(rawUrl); } catch(e) {}
                            if (isMobile) {
                                window.location.href = 'instagram://direct-inbox';
                            } else {
                                window.open('https://www.instagram.com/direct/inbox/', 'share_popup', 'width=600,height=500,noopener,noreferrer');
                            }
                            
                            // Mostrar pista visual sutil de copia
                            const tooltip = newBtn.querySelector('.ig-tooltip') as HTMLElement;
                            if (tooltip) {
                                tooltip.style.opacity = '1';
                                setTimeout(() => tooltip.style.opacity = '0', 2000);
                            }
                        }
                        break;
                }
            });
        });
    }

    document.addEventListener('DOMContentLoaded', setupShareModal);
    document.addEventListener('astro:page-load', setupShareModal);
</script>
