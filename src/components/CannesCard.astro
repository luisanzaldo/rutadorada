---
import CannesModal from "./CannesModal.astro";
---

<div
    class="bg-card-light dark:bg-card-dark rounded-xl p-6 border border-slate-200 dark:border-white/5 shadow-sm"
>
    <span class="inline-block text-[10px] font-bold uppercase tracking-[0.2em] text-gold mb-2">
        Festival de Cannes
    </span>
    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2 leading-snug">
        Calificaciones <span class="text-gold">Cannes 2026</span>
    </h3>
    <p class="text-slate-600 dark:text-slate-400 text-sm mb-4 leading-relaxed">
        Conoce el promedio de las críticas de las películas en competencia del Festival de Cannes 2026.
    </p>
    <button
        id="cannes-card-trigger"
        type="button"
        class="inline-flex items-center gap-2 bg-primary hover:bg-primary/90 text-background-dark font-bold py-2 px-4 rounded text-sm transition-colors"
    >
        Ver calificaciones
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
    </button>
</div>

<CannesModal />
