            <a
                class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-600 dark:text-slate-400 hover:bg-primary hover:text-[#102023] transition-colors"
                href="#"
            >
                <span class="text-xs font-bold">Fb</span>
            </a>
            <a
