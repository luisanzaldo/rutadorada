    <!-- Trending Tags -->
    <div
        class="bg-card-light dark:bg-card-dark rounded-xl p-6 border border-slate-200 dark:border-white/5 shadow-sm"
    >
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">
            Trending Tags
        </h3>
        <div class="flex flex-wrap gap-2">
            {
                trendingTags.map((tag) => (
                    <a
                        class="px-3 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-medium hover:bg-primary hover:text-[#102023] transition-colors capitalize"
                        href={getTagUrl(tag.name)}
                    >
                        #{tag.name}
                    </a>
                ))
            }
        </div>
    </div>

    <!-- Calificaciones Cannes 2026 -->
    <CannesCard />

    <!-- Weekly Tech Digest -->
    <div
        class="hidden relative bg-gradient-to-br from-cyan-900 to-background-dark rounded-xl p-6 border border-primary/20 shadow-lg overflow-hidden"
    >
        <div
            class="absolute -top-10 -right-10 w-32 h-32 bg-primary/20 rounded-full blur-3xl"
        >
        </div>
        <h3 class="relative text-lg font-bold text-white mb-2">
            Lo más nuevo cada semana
        </h3>
        <p class="relative text-slate-300 text-sm mb-4">
            Recibe los últimos artículos en tu buzón de entrada cada lunes.
        </p>
        <form class="relative space-y-3">
            <input
                class="w-full bg-black/30 border border-white/10 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-primary placeholder-slate-500"
                placeholder="email@ejemplo.com"
                type="email"
            />
            <button
                class="w-full bg-[#F2AF0D] hover:bg-[#F2AF0D]/90 text-background-dark font-bold py-2 rounded text-sm transition-colors shadow-lg shadow-[#F2AF0D]/20"
            >
                Suscríbete
            </button>
        </form>
    </div>

    <!-- Most Popular -->
    <div
        id="most-popular-container"
        class="bg-card-light dark:bg-card-dark rounded-xl p-6 border border-slate-200 dark:border-white/5 shadow-sm"
        data-posts={JSON.stringify(
            allPosts
                .filter((p) => ["Artículos", "Críticas", "Premios"].includes(p.data.category))
                // El título viaja como HTML porque la lista se pinta con innerHTML
                .map((p) => ({ slug: p.slug, title: renderRichText(p.data.title), category: p.data.category }))
        )}
    >
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">
            Más popular
        </h3>
        <div class="space-y-4" id="most-popular-list">
            <div class="animate-pulse space-y-3">
              <div class="h-16 bg-gray-200 dark:bg-gray-700 rounded"></div>
              <div class="h-16 bg-gray-200 dark:bg-gray-700 rounded"></div>
              <div class="h-16 bg-gray-200 dark:bg-gray-700 rounded"></div>
            </div>
        </div>
    </div>
</aside>

<script>
    let supabase: any;

    async function updateMostPopular() {
        const container = document.getElementById("most-popular-container");
        const list = document.getElementById("most-popular-list");
        if (!container || !list) return;

        const postsData = container.getAttribute("data-posts");
        if (!postsData) return;

        const posts = JSON.parse(postsData);
        const categoriesToTrack = ["Artículos", "Críticas", "Premios"];

        try {
            if (!supabase) return;
            const { data: likesData, error } = await supabase.from("likes").select("articulo_id, created_at");
            if (error || !likesData) return;

            const popularByCategory = categoriesToTrack.map((cat) => {
                const catPosts = posts.filter((p: any) => p.category === cat);

                let mostPopularPost = null;
                let maxLikes = -1;
                let mostRecentLike = 0;

                for (const p of catPosts) {
                    const articuloId = "posts/" + p.slug;
                    const postLikes = likesData.filter((l: any) => l.articulo_id === articuloId);
                    const count = postLikes.length;
                    const maxCreated = postLikes.reduce((max: number, l: any) => {
                        const time = l.created_at ? new Date(l.created_at).getTime() : 0;
                        return time > max ? time : max;
                    }, 0);

                    if (count > maxLikes || (count === maxLikes && maxCreated > mostRecentLike)) {
                        maxLikes = count;
                        mostRecentLike = maxCreated;
                        mostPopularPost = p;
                    }
                }

                return {
                    category: cat,
                    title: mostPopularPost?.title || "",
                    slug: mostPopularPost?.slug || "",
                };
            }).filter((item) => item.slug !== "");

            const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
            if (popularByCategory.length > 0) {
                list.innerHTML = popularByCategory.map((item, index) => `
                    <a class="group block" href="${baseUrl}/posts/${item.slug}">
                        <span class="text-gold text-xs font-bold uppercase mb-1 block">
                            ${item.category}
                        </span>
                        <h4 class="text-sm font-semibold text-slate-800 dark:text-slate-200 group-hover:text-gold transition-colors">
                            ${item.title}
                        </h4>
                    </a>
                    ${index < popularByCategory.length - 1 ? '<div class="h-px bg-slate-100 dark:bg-slate-800"></div>' : ''}
                `).join('');
            }
        } catch (e) {
            console.error("Error fetching dynamic likes for most popular", e);
        }
    }

    const loadSupabaseAndUpdate = async () => {
        if (supabase) return;
        const module = await import("../lib/supabase");
        supabase = module.supabase;
        await updateMostPopular();
    };

    const interactionEvents = ["mouseenter", "scroll", "touchstart", "click", "keydown"];
    
    const onUserInteraction = () => {
        interactionEvents.forEach((e) => document.removeEventListener(e, onUserInteraction));
        loadSupabaseAndUpdate();
    };

    interactionEvents.forEach((e) => document.addEventListener(e, onUserInteraction, { once: true }));

    document.addEventListener("astro:page-load", () => {
        if (!supabase) {
            loadSupabaseAndUpdate();
        } else {
            updateMostPopular();
        }
    });
</script>
