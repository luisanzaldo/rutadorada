---
import { getCollection } from "astro:content";
const allPosts = await getCollection("posts");

const tagCategoryMap = new Map<string, string>();
allPosts.forEach(post => {
    const category = post.data.category;
    (post.data.tags || []).forEach(tag => {
        if (!tagCategoryMap.has(tag)) {
            tagCategoryMap.set(tag, category);
        }
    });
});

const uniqueTags = Array.from(tagCategoryMap.keys());
// Sort by frequency (simple version: show top 8)
const trendingTags = uniqueTags.slice(0, 8).map(tag => ({
    name: tag,
    category: tagCategoryMap.get(tag) as string
}));

const getCategoryUrl = (category: string) => {
    let path = "";
    switch (category) {
        case "Artículos": path = "/articulos"; break;
        case "Críticas": path = "/criticas"; break;
        case "Premios": path = "/premios"; break;
        case "Tráilers": path = "/trailers"; break;
        default: path = "/archive"; break;
    }
    const base = import.meta.env.BASE_URL;
    return `${base === '/' ? '' : base}${path}`;
};


---

<aside class="lg:w-1/3 space-y-8 lg:mt-16">
