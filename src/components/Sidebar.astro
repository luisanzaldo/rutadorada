---
import { getCollection } from "astro:content";
import { supabase } from "../lib/supabase";

const allPosts = await getCollection("posts");
const allTags = allPosts.flatMap((post) => post.data.tags || []);
const uniqueTags = [...new Set(allTags)];
// Sort by frequency (simple version: show top 8)
const trendingTags = uniqueTags.slice(0, 8);

const { data: likesData } = await supabase.from("likes").select("articulo_id, created_at");

const categoriesToTrack = ["Artículos", "Críticas", "Premios"];
const popularByCategory = categoriesToTrack.map((cat) => {
    const catPosts = allPosts.filter((p) => p.data.category === cat);

    let mostPopularPost = null;
    let maxLikes = -1;
    let mostRecentLike = 0;

    for (const p of catPosts) {
        const articuloId = "posts/" + p.slug;
        const postLikes = (likesData || []).filter((l) => l.articulo_id === articuloId);
        const count = postLikes.length;
        const maxCreated = postLikes.reduce((max, l) => {
            const time = l.created_at ? new Date(l.created_at).getTime() : 0;
            return time > max ? time : max;
        }, 0);

        if (count > maxLikes || (count === maxLikes && maxCreated > mostRecentLike)) {
            maxLikes = count;
            mostRecentLike = maxCreated;
            mostPopularPost = p;
        }
    }

    return {
        category: cat,
        title: mostPopularPost?.data.title || "",
        slug: mostPopularPost?.slug || "",
    };
}).filter((item) => item.slug !== "");
---

<aside class="lg:w-1/3 space-y-8 lg:mt-16">
    <!-- About DevBlog -->
    <div
        class="bg-card-light dark:bg-card-dark rounded-xl p-6 border border-slate-200 dark:border-white/5 shadow-sm"
    >
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">
            Sobre ruta<span class="text-primary">dorada</span>
        </h3>
        <p
            class="text-slate-600 dark:text-slate-400 text-sm mb-4 leading-relaxed"
        >
            Somos una plataforma que ama el cine y comparte la información más relevante del séptimo arte a través de artículos y críticas.
        </p>
        <div class="flex gap-3">
            <a
                class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-600 dark:text-slate-400 hover:bg-primary hover:text-white transition-colors"
                href="#"
            >
                <span class="text-xs font-bold">X</span>
            </a>
            <a
                class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-600 dark:text-slate-400 hover:bg-primary hover:text-white transition-colors"
                href="#"
            >
                <span class="text-xs font-bold">Fb</span>
            </a>
            <a
                class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-600 dark:text-slate-400 hover:bg-primary hover:text-white transition-colors"
                href="#"
            >
                <span class="text-xs font-bold">Ig</span>
            </a>
        </div>
    </div>

    <!-- Trending Tags -->
    <div
        class="bg-card-light dark:bg-card-dark rounded-xl p-6 border border-slate-200 dark:border-white/5 shadow-sm"
    >
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">
            Trending Tags
        </h3>
        <div class="flex flex-wrap gap-2">
            {
                trendingTags.map((tag) => (
                    <a
                        class="px-3 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-medium hover:bg-primary hover:text-white transition-colors capitalize"
                        href={`/archive?tag=${tag.toLowerCase()}`}
                    >
                        #{tag}
                    </a>
                ))
            }
        </div>
    </div>

    <!-- Weekly Tech Digest -->
    <div
        class="relative bg-gradient-to-br from-cyan-900 to-background-dark rounded-xl p-6 border border-primary/20 shadow-lg overflow-hidden"
    >
        <div
            class="absolute -top-10 -right-10 w-32 h-32 bg-primary/20 rounded-full blur-3xl"
        >
        </div>
        <h3 class="relative text-lg font-bold text-white mb-2">
            Lo más nuevo cada semana
        </h3>
        <p class="relative text-slate-300 text-sm mb-4">
            Recibe los últimos artículos en tu buzón de entrada cada lunes.
        </p>
        <form class="relative space-y-3">
            <input
                class="w-full bg-black/30 border border-white/10 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-primary placeholder-slate-500"
                placeholder="email@ejemplo.com"
                type="email"
            />
            <button
                class="w-full bg-primary hover:bg-cyan-400 text-background-dark font-bold py-2 rounded text-sm transition-colors shadow-lg shadow-primary/20"
            >
                Suscríbete
            </button>
        </form>
    </div>

    <!-- Most Popular -->
    <div
        id="most-popular-container"
        class="bg-card-light dark:bg-card-dark rounded-xl p-6 border border-slate-200 dark:border-white/5 shadow-sm"
        data-posts={JSON.stringify(
            allPosts
                .filter((p) => ["Artículos", "Críticas", "Premios"].includes(p.data.category))
                .map((p) => ({ slug: p.slug, title: p.data.title, category: p.data.category }))
        )}
    >
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">
            Más popular
        </h3>
        <div class="space-y-4" id="most-popular-list">
            {
                popularByCategory.map((item, index) => (
                    <>
                        <a class="group block" href={`/posts/${item.slug}`}>
                            <span class="text-primary text-xs font-bold uppercase mb-1 block">
                                {item.category}
                            </span>
                            <h4 class="text-sm font-semibold text-slate-800 dark:text-slate-200 group-hover:text-primary transition-colors">
                                {item.title}
                            </h4>
                        </a>
                        {index < popularByCategory.length - 1 && (
                            <div class="h-px bg-slate-100 dark:bg-slate-800" />
                        )}
                    </>
                ))
            }
        </div>
    </div>
</aside>

<script>
    import { supabase } from "../lib/supabase";

    async function updateMostPopular() {
        const container = document.getElementById("most-popular-container");
        const list = document.getElementById("most-popular-list");
        if (!container || !list) return;

        const postsData = container.getAttribute("data-posts");
        if (!postsData) return;

        const posts = JSON.parse(postsData);
        const categoriesToTrack = ["Artículos", "Críticas", "Premios"];

        try {
            const { data: likesData, error } = await supabase.from("likes").select("articulo_id, created_at");
            if (error || !likesData) return;

            const popularByCategory = categoriesToTrack.map((cat) => {
                const catPosts = posts.filter((p: any) => p.category === cat);

                let mostPopularPost = null;
                let maxLikes = -1;
                let mostRecentLike = 0;

                for (const p of catPosts) {
                    const articuloId = "posts/" + p.slug;
                    const postLikes = likesData.filter((l: any) => l.articulo_id === articuloId);
                    const count = postLikes.length;
                    const maxCreated = postLikes.reduce((max: number, l: any) => {
                        const time = l.created_at ? new Date(l.created_at).getTime() : 0;
                        return time > max ? time : max;
                    }, 0);

                    if (count > maxLikes || (count === maxLikes && maxCreated > mostRecentLike)) {
                        maxLikes = count;
                        mostRecentLike = maxCreated;
                        mostPopularPost = p;
                    }
                }

                return {
                    category: cat,
                    title: mostPopularPost?.title || "",
                    slug: mostPopularPost?.slug || "",
                };
            }).filter((item) => item.slug !== "");

            if (popularByCategory.length > 0) {
                list.innerHTML = popularByCategory.map((item, index) => `
                    <a class="group block" href="/posts/${item.slug}">
                        <span class="text-primary text-xs font-bold uppercase mb-1 block">
                            ${item.category}
                        </span>
                        <h4 class="text-sm font-semibold text-slate-800 dark:text-slate-200 group-hover:text-primary transition-colors">
                            ${item.title}
                        </h4>
                    </a>
                    ${index < popularByCategory.length - 1 ? '<div class="h-px bg-slate-100 dark:bg-slate-800"></div>' : ''}
                `).join('');
            }
        } catch (e) {
            console.error("Error fetching dynamic likes for most popular", e);
        }
    }

    // Run on load and navigation
    document.addEventListener("DOMContentLoaded", updateMostPopular);
    document.addEventListener("astro:page-load", updateMostPopular);
</script>
