            <button
                class="w-full bg-[#D4AF37] hover:bg-[#D4AF37]/90 text-background-dark font-bold py-2 rounded text-sm transition-colors shadow-lg shadow-[#D4AF37]/20"
            >
                Suscríbete
            </button>
        </form>
