---
import { renderRichText, stripRichText } from "../lib/richText";

interface Props {
    title: string;
    description: string;
    image: string;
    category: string;
    author: string;
    authorImage?: string;
    date: string;
    readTime: string;
    featured?: boolean;
    slug?: string;
    videoUrl?: string;
}

const {
    title,
    description,
    image,
    category,
    author,
    authorImage,
    date,
    readTime,
    featured = false,
    slug,
    videoUrl,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const url = videoUrl || `${baseUrl}/posts/${slug}`;
const triggerClass = videoUrl ? "video-trigger" : "";
const finalImage = image.startsWith('/') ? `${baseUrl}${image}` : image;

// El título y la descripción admiten negrita e itálica en línea
const titleHtml = renderRichText(title);
const descriptionHtml = renderRichText(description);
const plainTitle = stripRichText(title);
---

{
    featured ? (
        <article class="article-card-container relative bg-card-light dark:bg-card-dark rounded-xl overflow-hidden mb-8 border border-slate-200 dark:border-white/5">
            <a href={url} class={`video-trigger-link ${triggerClass} block w-full h-full relative z-20`} data-video-url={videoUrl}>
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent z-10 pointer-events-none" />
                <div class="aspect-w-16 aspect-h-9 h-[28rem] sm:h-96 md:h-[32rem] w-full relative">
                    <img
    src={finalImage}
    alt={plainTitle}
    class="article-image object-cover w-full h-full"
    loading="lazy"
    decoding="async"
/>
                </div>
                <div class="absolute bottom-0 left-0 p-5 sm:p-6 md:p-8 z-20 w-full">
                    <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-2 sm:mb-3">
                        <span class="px-2 sm:px-3 py-1 rounded-full bg-primary text-background-dark text-[10px] sm:text-xs font-bold uppercase tracking-wider">
                            {category}
                        </span>
                        <span class="text-slate-300 text-[10px] sm:text-xs flex items-center">
                            <svg data-lucide="clock" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1">
                                <circle cx="12" cy="12" r="10" />
                                <polyline points="12 6 12 12 16 14" />
                            </svg>
                            {readTime}
                        </span>
                    </div>
                    <h3
                        class="article-title text-xl sm:text-2xl md:text-3xl font-bold text-white mb-2 transition-colors break-words line-clamp-3 sm:line-clamp-4"
                        set:html={titleHtml}
                    />
                    <p
                        class="text-slate-200 sm:text-slate-300 text-sm sm:text-base mb-3 sm:mb-4 line-clamp-2 max-w-2xl"
                        set:html={descriptionHtml}
                    />
                    <div class="flex items-center">
                        {authorImage && (
                            <img
                                src={authorImage}
                                alt={author}
                                class="w-8 h-8 rounded-full border-2 border-primary mr-3"
                                loading="lazy"
                                decoding="async"
                            />
                        )}
                        <div class="text-sm">
                            <p class="text-white font-medium">{author}</p>
                            <p class="text-slate-400 text-xs">{date}</p>
                        </div>
                    </div>
                </div>
            </a>
        </article>
    ) : (
        <article class="article-card-container flex flex-col h-full bg-card-light dark:bg-card-dark rounded-xl overflow-hidden border border-slate-200 dark:border-white/5 relative">
            <a href={url} class={`video-trigger-link ${triggerClass} flex flex-col h-full w-full`} data-video-url={videoUrl}>
                <div class="h-48 overflow-hidden relative block z-10">
                    <div class="absolute top-4 left-4 z-10">
                        <span class="px-2 py-1 rounded-md bg-black/60 backdrop-blur-sm text-primary text-xs font-bold border border-primary/30">
                            {category}
                        </span>
                    </div>
                    <img
    src={finalImage}
    alt={plainTitle}
    class="article-image w-full h-full object-cover"
    loading="lazy"
    decoding="async"
/>
                </div>
                <div class="p-6 flex flex-col flex-grow">
                    <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1">
                            <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
                            <line x1="16" x2="16" y1="2" y2="6" />
                            <line x1="8" x2="8" y1="2" y2="6" />
                            <line x1="3" x2="21" y1="10" y2="10" />
                        </svg>
                        {date}
                        <span class="mx-1">•</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1">
                            <line x1="10" x2="14" y1="2" y2="2" />
                            <line x1="12" x2="12" y1="14" y2="11" />
                            <circle cx="12" cy="14" r="8" />
                        </svg>
                        {readTime}
                    </div>
                    <h3
                        class="article-title text-lg sm:text-xl font-bold text-slate-900 dark:text-white mb-2 sm:mb-3 transition-colors leading-tight break-words"
                        set:html={titleHtml}
                    />
                    <p
                        class="text-slate-600 dark:text-slate-400 text-sm mb-4 line-clamp-3 flex-grow"
                        set:html={descriptionHtml}
                    />
                    <div class="mt-auto pt-4 border-t border-slate-100 dark:border-white/5 flex items-center justify-between">
                        <div class="flex items-center">
                            <span class="text-xs font-medium text-slate-700 dark:text-slate-300">
                                Por {author}
                            </span>
                        </div>
                        <div class="article-arrow text-[#F2AF0D] transition-transform">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 12h14" />
                                <path d="m12 5 7 7-7 7" />
                            </svg>
                        </div>
                    </div>
                </div>
            </a>
        </article>
    )
}

<style>
    /* Prevent hover effects on touch devices to avoid double-tap requirement on iOS */
    @media (hover: hover) and (pointer: fine) {
        .article-card-container {
            transition: box-shadow 0.3s ease, border-color 0.3s ease;
        }

        .video-trigger-link:hover .article-image {
            transform: scale(1.05);
        }

        .video-trigger-link:hover .article-title {
            color: #F2AF0D;
        }

        .video-trigger-link:hover .article-arrow {
            transform: translateX(4px);
        }

        .video-trigger-link:hover ~ .article-card-container,
        .article-card-container:hover {
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
            border-color: rgba(242, 175, 13, 0.5);
        }
        
        .article-image {
            transition: transform 0.7s ease;
        }

        .article-title {
            transition: color 0.3s ease;
        }

        .article-arrow {
            transition: transform 0.3s ease;
        }
    }

    .video-trigger-link {
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
        cursor: pointer;
    }
</style>



