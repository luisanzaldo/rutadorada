---
import { renderRichText, stripRichText } from "../lib/richText";
import { getTrailerUrl } from "../lib/trailers";

interface RelatedPost {
    title: string;
    date: string;
    readTime: string;
    image: string;
    slug: string;
    category?: string;
    videoUrl?: string;
}

interface Props {
    headings: { depth: number; slug: string; text: string }[];
    relatedPosts: RelatedPost[];
    category?: string;
    fichaTecnica?: {
        sinopsis: string;
        director: string;
        cast: string;
        duracion: string;
    };
}

const { headings, relatedPosts, category, fichaTecnica } = Astro.props;
---

<aside class="hidden lg:block lg:col-span-3 sticky top-24 self-start space-y-8">
        <!-- Ficha Técnica (Only for 'Críticas') -->
        {
            category === "Críticas" && fichaTecnica && (
                <div class="rounded-xl bg-slate-50 dark:bg-background-card p-6 border border-transparent dark:border-[#224249] shadow-sm">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-[#90c1cb] mb-4">
                        Ficha Técnica
                    </h3>
                    <div class="space-y-4 text-sm text-slate-600 dark:text-slate-300">
                        <div>
                            <span class="font-bold text-gold block mb-1">Sinopsis:</span>
                            <p class="text-xs leading-relaxed">{fichaTecnica.sinopsis}</p>
                        </div>
                        <div>
                            <span class="font-bold text-gold block mb-1">Director:</span>
                            <p class="text-xs">{fichaTecnica.director}</p>
                        </div>
                        <div>
                            <span class="font-bold text-gold block mb-1">Cast:</span>
                            <p class="text-xs">{fichaTecnica.cast}</p>
                        </div>
                        <div>
                            <span class="font-bold text-gold block mb-1">Duración:</span>
                            <p class="text-xs">{fichaTecnica.duracion}</p>
                        </div>
                    </div>
                </div>
            )
        }

        <!-- Table of Contents -->
        {
            headings.length > 0 && (
                <div class="rounded-xl bg-slate-50 dark:bg-background-card p-6 border border-transparent dark:border-[#224249] shadow-sm">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-[#90c1cb] mb-4">
                        Tabla de contenidos
                    </h3>
                    <div class="relative w-full">
                        <nav class="space-y-1 relative max-h-[50vh] overflow-y-auto pr-2 pb-4" id="toc-nav" style="scrollbar-width: thin; scrollbar-color: #cbd5e1 transparent;">
                            {headings.map((heading) => (
                                <a
                                    href={`#${heading.slug}`}
                                    data-slug={heading.slug}
                                    class={`toc-link block pl-6 text-sm text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all py-1.5`}
                                >
                                    {heading.text}
                                </a>
                            ))}
                            <!-- Active Indicator -->
                            <div id="toc-indicator" class="absolute left-0 w-0.5 bg-primary transition-all duration-300 hidden"></div>
                        </nav>
                        
                        <!-- Scroll action button -->
                        <button 
                            id="toc-scroll-down" 
                            class="absolute -bottom-2 left-1/2 -translate-x-1/2 bg-white dark:bg-[#162a2f] w-7 h-7 rounded-full shadow border border-slate-200 dark:border-[#224249] flex items-center justify-center text-gold hover:scale-110 transition-all opacity-0 pointer-events-none z-10"
                            aria-label="Ver más contenidos"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                    </div>
                </div>
            )
        }

        <!-- Related Articles -->
        {
            relatedPosts.length > 0 && (
                <div>
                    <h3
                        class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-[#90c1cb] mb-4"
                    >
                        Artículos relacionados
                    </h3>
                    <div class="space-y-4">
                        {
                            relatedPosts.map((post) => {
                                const isTrailer = post.category === "Tráilers" && post.videoUrl;
                                const url = isTrailer ? getTrailerUrl(post.slug) : `/posts/${post.slug}`;
                                const triggerClass = isTrailer ? "video-trigger" : "";
                                return (
                                    <a
                                        href={url}
                                        class={`group block rounded-xl bg-slate-50 dark:bg-background-card p-4 border border-transparent hover:border-[#F2AF0D]/50 transition-all shadow-sm ${triggerClass}`}
                                        { ...(isTrailer ? { "data-video-url": post.videoUrl, "data-video-slug": post.slug } : {}) }
                                    >
                                        <div class="mb-3 overflow-hidden rounded-lg h-32 w-full bg-slate-200 dark:bg-[#102023] relative">
                                            <div class="absolute inset-0 bg-gradient-to-tr from-slate-900 to-transparent opacity-60" />
                                            <picture>
                                                <source srcset={(post.image.startsWith('/') ? `${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}${post.image}` : post.image).replace('.jpg', '-mobile.jpg')} media="(max-width: 640px)" />
                                                <img
                                                    src={post.image.startsWith('/') ? `${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}${post.image}` : post.image}
                                                    alt={stripRichText(post.title)}
                                                    class="h-full w-full object-cover transition-transform group-hover:scale-105"
                                                    loading="lazy"
                                                    decoding="async"
                                                />
                                            </picture>
                                            {isTrailer && (
                                                <div class="absolute inset-0 flex items-center justify-center opacity-80 group-hover:opacity-100 transition-opacity">
                                                    <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center pl-1">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                                                            <polygon points="5 3 19 12 5 21 5 3"></polygon>
                                                        </svg>
                                                    </div>
                                                </div>
                                            )}
                                        </div>
                                        <h4
                                            class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-gold transition-colors leading-snug"
                                            set:html={renderRichText(post.title)}
                                        />
                                        <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
                                            {post.date} • {post.readTime}
                                        </p>
                                    </a>
                                );
                            })
                        }
                    </div>
                </div>
            )
        }

        <!-- Newsletter Widget -->
        <div class="hidden rounded-xl bg-primary/10 p-5 border border-primary/20">
            <h4 class="text-sm font-bold text-slate-900 dark:text-white mb-2">
                Lo más nuevo cada semana
            </h4>
            <p class="text-xs text-slate-600 dark:text-slate-300 mb-4">
                Recibe los últimos artículos en tu buzón de entrada cada lunes
            </p>
            <input
                class="w-full rounded-lg border-0 bg-white dark:bg-background-dark py-2 px-3 text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:ring-1 focus:ring-primary mb-2"
                placeholder="email@ejemplo.com"
                type="email"
            />
            <button
                class="w-full rounded-lg bg-[#F2AF0D] py-2 text-xs font-bold text-[#102023] hover:bg-[#F2AF0D]/90 transition-colors"
                >Suscríbete</button
            >
        </div>
</aside>

<script>
    const observerOptions = {
        root: null,
        rootMargin: '-5% 0px -85% 0px',
        threshold: 0
    };

    const tocLinks = document.querySelectorAll('.toc-link');
    const indicator = document.getElementById('toc-indicator');
    const nav = document.getElementById('toc-nav');
    const scrollBtn = document.getElementById('toc-scroll-down');

    let activeId = '';

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                activeId = entry.target.getAttribute('id') || '';
                updateActiveLink();
            }
        });
    }, observerOptions);

    function updateActiveLink() {
        if (!activeId) return;

        const activeLink = document.querySelector(`.toc-link[data-slug="${activeId}"]`) as HTMLElement;
        
        if (activeLink && indicator && nav) {
            // Update classes
            tocLinks.forEach(link => link.classList.remove('text-gold', 'font-bold'));
            activeLink.classList.add('text-gold', 'font-bold');
            
            const linkTop = activeLink.offsetTop;
            const linkHeight = activeLink.offsetHeight;
            
            indicator.style.display = 'block';
            indicator.style.top = `${linkTop}px`;
            indicator.style.height = `${linkHeight}px`;

            // Scroll nav if needed (so active link is visible)
            const navScrollTop = nav.scrollTop;
            const navHeight = nav.clientHeight;
            if (Math.abs((linkTop + linkHeight / 2) - (navScrollTop + navHeight / 2)) > navHeight / 3) {
                nav.scrollTo({
                    top: linkTop - navHeight / 2 + linkHeight / 2,
                    behavior: 'smooth'
                });
            }
        }
    }

    // Observe all headings
    tocLinks.forEach(link => {
        const slug = link.getAttribute('data-slug');
        if (slug) {
            const target = document.getElementById(slug);
            if (target) observer.observe(target);
        }
    });

    // Handle scroll to check which one is truly active if multiple intersect
    window.addEventListener('scroll', () => {
        let current = '';
        const headings = Array.from(tocLinks).map(link => {
            const slug = link.getAttribute('data-slug');
            return slug ? document.getElementById(slug) : null;
        }).filter(h => h !== null) as HTMLElement[];

        for (const heading of headings) {
            const top = heading.getBoundingClientRect().top;
            if (top < 150) {
                current = heading.getAttribute('id') || '';
            } else {
                break;
            }
        }

        if (current && current !== activeId) {
            activeId = current;
            updateActiveLink();
        }
    }, { passive: true });

    function checkTocScroll() {
        if (!nav || !scrollBtn) return;
        
        const canScroll = nav.scrollHeight > nav.clientHeight;
        const notAtBottom = Math.ceil(nav.scrollTop + nav.clientHeight) < nav.scrollHeight - 2;
        
        if (canScroll && notAtBottom) {
            scrollBtn.style.opacity = '1';
            scrollBtn.style.pointerEvents = 'auto';
        } else {
            scrollBtn.style.opacity = '0';
            scrollBtn.style.pointerEvents = 'none';
        }
    }

    if (nav) {
        nav.addEventListener('scroll', checkTocScroll, { passive: true });
        window.addEventListener('resize', checkTocScroll);
        setTimeout(checkTocScroll, 100);
    }

    if (scrollBtn && nav) {
        scrollBtn.addEventListener('click', () => {
            nav.scrollBy({ top: nav.clientHeight / 2, behavior: 'smooth' });
        });
    }
</script>

<style>
    /* TOC specific styles handled by script */
</style>
