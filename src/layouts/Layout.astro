---
import "../styles/global.css";
import VideoModal from "../components/VideoModal.astro";
import RssModal from "../components/RssModal.astro";

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const {
	title,
	description = "Sigue la carrera de premios del séptimo arte y lee los análisis que tenemos para ti.",
	image = "/images/RutaDorada-web.png",
} = Astro.props;

// Ensure absolute URL for social images
const socialImageURL = image.startsWith('http')
	? image
	: new URL(image, Astro.site || Astro.url).href;

// Analytics — solo se cargan en producción y si los IDs están definidos
const GA4_ID = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
const CLARITY_ID = import.meta.env.PUBLIC_CLARITY_PROJECT_ID;
const COOKIEYES_ID = import.meta.env.PUBLIC_COOKIEYES_ID;
const analyticsEnabled = import.meta.env.PROD;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<!-- Tema (claro/oscuro): se aplica antes de pintar para evitar parpadeo -->
		<script is:inline>
			(function () {
				try {
					if (localStorage.getItem("theme") === "dark") {
						document.documentElement.classList.add("dark");
					} else {
						document.documentElement.classList.remove("dark");
					}
				} catch (e) {}
			})();
		</script>
		<link rel="icon" type="image/png" href={import.meta.env.BASE_URL + "icons/favicon-96x96.png?v=2"} sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + "icons/favicon.svg?v=2"} />
		<link rel="shortcut icon" href={import.meta.env.BASE_URL + "icons/favicon.ico?v=2"} />
		<link rel="apple-touch-icon" sizes="180x180" href={import.meta.env.BASE_URL + "icons/apple-touch-icon.png?v=2"} />
		<meta name="apple-mobile-web-app-title" content="RutaDorada" />
		<link rel="manifest" href={import.meta.env.BASE_URL + "icons/site.webmanifest?v=2"} />
		<meta name="generator" content={Astro.generator} />
		<link rel="alternate" type="application/rss+xml" title="Ruta Dorada Films" href={new URL("rss.xml", Astro.site || Astro.url)} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={Astro.url} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="article" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta property="og:site_name" content="RutaDorada Films" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@rutadoradafilms" />
		<meta name="twitter:creator" content="@rutadoradafilms" />
		<meta name="twitter:url" content={Astro.url} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />
		<meta name="twitter:image:alt" content={title} />


		<!-- Fonts & Icons (Migrated to self-hosted) -->
		<link rel="preload" href="/fonts/cinzel-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
		<link rel="preload" href="/fonts/plus-jakarta-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
		
		<style>
		  @font-face {
		    font-family: 'Cinzel';
		    src: url('/fonts/cinzel-latin-wght-normal.woff2') format('woff2');
		    font-weight: 400 900;
		    font-style: normal;
		    font-display: swap;
		  }
		</style>
		
		<!-- Preconnects -->
		<link rel="preconnect" href="https://www.transparenttextures.com" crossorigin="anonymous" />

		{analyticsEnabled && (
			<script is:inline>
				window.dataLayer = window.dataLayer || [];
				function gtag(){dataLayer.push(arguments);}
				gtag('consent', 'default', {
					ad_storage: 'denied',
					ad_user_data: 'denied',
					ad_personalization: 'denied',
					analytics_storage: 'denied',
					functionality_storage: 'granted',
					security_storage: 'granted',
					wait_for_update: 500
				});
			</script>
		)}

		{analyticsEnabled && COOKIEYES_ID && (
			<script id="cookieyes" type="text/javascript" src={`https://cdn-cookieyes.com/client_data/${COOKIEYES_ID}/script.js`}></script>
		)}

		{analyticsEnabled && GA4_ID && (
			<>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
				<script is:inline define:vars={{ ga4Id: GA4_ID }}>
					gtag('js', new Date());
					gtag('config', ga4Id);
				</script>
			</>
		)}

		{analyticsEnabled && CLARITY_ID && (
			<script is:inline define:vars={{ clarityId: CLARITY_ID }}>
				(function(){
					var loaded = false;
					function loadClarity(){
						if (loaded) return;
						loaded = true;
						(function(c,l,a,r,i,t,y){
							c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
							t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
							y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
						})(window, document, "clarity", "script", clarityId);
					}
					function hasAnalyticsConsent(){
						return document.cookie.split('; ').some(function(c){
							return c.indexOf('cookieyes-consent=') === 0 && c.indexOf('analytics:yes') > -1;
						});
					}
					if (hasAnalyticsConsent()) {
						loadClarity();
					} else {
						document.addEventListener('cookieyes_consent_update', function(){
							if (hasAnalyticsConsent()) loadClarity();
						});
					}
				})();
			</script>
		)}
	</head>
	<body
		class="bg-background-light dark:bg-background-dark text-slate-800 dark:text-slate-200 transition-colors duration-300 font-body min-h-screen flex flex-col"
	>
		<slot />
		<VideoModal />
		<RssModal />
		<script>
			// Evitar que el navegador restaure la posición del scroll al recargar
			if ('scrollRestoration' in history) {
				history.scrollRestoration = 'manual';
			}
			// Asegurar que la página empiece siempre desde arriba a menos que haya un hash de sección
			if (!window.location.hash) {
				window.scrollTo(0, 0);
			}
		</script>
	</body>
</html>
