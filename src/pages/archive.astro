---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ArchiveCard from "../components/ArchiveCard.astro";

const allPosts = (await getCollection("posts")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date: Date) => {
    return date.toLocaleDateString("en-US", {
        year: "numeric",
        month: "short",
        day: "numeric",
    });
};

// Initial state for progress bar (example: 12 posts out of 20)
// In a real app, this would be dynamic.
const totalArticlesCount = 50; // Mock total
const currentArticlesCount = allPosts.length;
const progressPercentage = (currentArticlesCount / totalArticlesCount) * 100;
---

<Layout title="Archivo de publicaciones | RutaDorada">
    <Header />

    <main class="flex-1 flex justify-center py-8 px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col w-full max-w-[1200px] gap-8">
            <!-- Title Section -->
            <div class="flex flex-col gap-4 border-b border-slate-200 dark:border-[#224249] pb-8">
                <h1
                    class="text-slate-900 dark:text-white text-4xl md:text-5xl font-bold leading-tight tracking-[-0.033em]"
                >
                    Archivo de publicaciones
                </h1>
                <p
                    class="text-slate-500 dark:text-text-muted text-lg font-normal leading-normal max-w-2xl"
                >
                    Explora las últimas perspectivas en cine, desde críticas profundas
                    hasta los premios más importantes y los trailers más esperados.
                </p>
            </div>

            <!-- Filters & Sorting -->
            <div
                class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 w-full overflow-hidden"
            >
                <div class="relative flex items-center w-full min-w-0 md:max-w-[calc(100%-160px)]">
                    <button
                        id="scroll-left"
                        class="absolute left-0 z-10 flex h-full w-12 items-center justify-start bg-gradient-to-r from-[#fafaf9] via-[#fafaf9] dark:from-[#0c0a09] dark:via-[#0c0a09] to-transparent text-[#F2AF0D] hover:text-[#b8952b] transition-opacity duration-300 opacity-0 pointer-events-none"
                        aria-label="Scroll left"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m15 18-6-6 6-6"/>
                        </svg>
                    </button>

                    <div class="flex gap-2 overflow-x-auto flex-nowrap scroll-smooth w-full py-1 px-1" id="topic-filters" style="-ms-overflow-style:none; scrollbar-width:none;">
                        <button
                            class="topic-filter flex h-9 shrink-0 items-center justify-center gap-x-2 rounded-lg bg-slate-100 dark:bg-background-input hover:bg-[#F2AF0D] text-slate-700 dark:text-slate-300 hover:text-[#0c0a09] dark:hover:text-white border border-transparent px-4 transition-all group active"
                            data-topic="all"
                        >
                            <span class="text-sm font-medium">Todos los temas</span>
                        </button>
                        <button
                            class="topic-filter flex h-9 shrink-0 items-center justify-center gap-x-2 rounded-lg bg-slate-100 dark:bg-background-input hover:bg-[#F2AF0D] text-slate-700 dark:text-slate-300 hover:text-[#0c0a09] dark:hover:text-white border border-transparent px-4 transition-all group"
                            data-topic="Artículos"
                        >
                            <span class="text-sm font-medium">Artículos</span>
                        </button>
                        <button
                            class="topic-filter flex h-9 shrink-0 items-center justify-center gap-x-2 rounded-lg bg-slate-100 dark:bg-background-input hover:bg-[#F2AF0D] text-slate-700 dark:text-slate-300 hover:text-[#0c0a09] dark:hover:text-white border border-transparent px-4 transition-all group"
                            data-topic="Críticas"
                        >
                            <span class="text-sm font-medium">Críticas</span>
                        </button>
                        <button
                            class="topic-filter flex h-9 shrink-0 items-center justify-center gap-x-2 rounded-lg bg-slate-100 dark:bg-background-input hover:bg-[#F2AF0D] text-slate-700 dark:text-slate-300 hover:text-[#0c0a09] dark:hover:text-white border border-transparent px-4 transition-all group"
                            data-topic="Premios"
                        >
                            <span class="text-sm font-medium">Premios</span>
                        </button>
                        <button
                            class="topic-filter flex h-9 shrink-0 items-center justify-center gap-x-2 rounded-lg bg-slate-100 dark:bg-background-input hover:bg-[#F2AF0D] text-slate-700 dark:text-slate-300 hover:text-[#0c0a09] dark:hover:text-white border border-transparent px-4 transition-all group"
                            data-topic="Tráilers"
                        >
                            <span class="text-sm font-medium">Tráilers</span>
                        </button>
                    </div>

                    <button
                        id="scroll-right"
                        class="absolute right-0 z-10 flex h-full w-12 items-center justify-end bg-gradient-to-l from-[#fafaf9] via-[#fafaf9] dark:from-[#0c0a09] dark:via-[#0c0a09] to-transparent text-[#F2AF0D] hover:text-[#b8952b] transition-opacity duration-300 opacity-0 pointer-events-none"
                        aria-label="Scroll right"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m9 18 6-6-6-6"/>
                        </svg>
                    </button>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                    <span class="text-slate-500 dark:text-text-muted text-sm">Ordenar por:</span>
                    <button
                        class="flex items-center gap-1 text-slate-900 dark:text-white text-sm font-medium hover:text-[#F2AF0D] transition-colors"
                        id="sort-toggle"
                    >
                        <span id="sort-label">Más recientes</span>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="text-[#F2AF0D]"
                        >
                            <path d="m6 9 6 6 6-6"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Article Grid -->
            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 opacity-100 transition-opacity duration-300"
                id="archive-grid"
            >
                {
                    allPosts.map((post) => (
                        <div
                            class="archive-item h-full"
                            data-topic={post.data.category}
                            data-date={post.data.pubDate.getTime()}
                            data-tags={
                                post.data.tags?.join(",").toLowerCase() || ""
                            }
                        >
                            <ArchiveCard
                                title={post.data.title}
                                description={post.data.description}
                                image={post.data.image}
                                category={post.data.category}
                                date={formatDate(post.data.pubDate)}
                                readTime={post.data.readTime}
                                slug={post.slug}
                                videoUrl={post.data.videoUrl}
                            />
                        </div>
                    ))
                }
            </div>

            <!-- Pagination Section -->
            <div
                class="flex flex-col items-center justify-center gap-6 pt-12 pb-8 border-t border-slate-200 dark:border-[#224249] mt-8"
            >
                <div class="flex items-center gap-2" id="pagination-controls">
                    <button
                        id="prev-page"
                        class="flex items-center justify-center w-10 h-10 rounded-lg bg-slate-100 dark:bg-background-input border border-[#F2AF0D]/20 text-slate-900 dark:text-white hover:bg-[#F2AF0D]/10 hover:border-[#F2AF0D] transition-all disabled:opacity-30 disabled:cursor-not-allowed group"
                        aria-label="Previous page"
                    >
                        <span
                            class="material-symbols-outlined text-[20px] group-hover:-translate-x-0.5 transition-transform"
                            >chevron_left</span
                        >
                    </button>

                    <div id="page-numbers" class="flex items-center gap-2">
                        <!-- Numbers will be injected here -->
                    </div>

                    <button
                        id="next-page"
                        class="flex items-center justify-center w-10 h-10 rounded-lg bg-slate-100 dark:bg-background-input border border-[#F2AF0D]/20 text-slate-900 dark:text-white hover:bg-[#F2AF0D]/10 hover:border-[#F2AF0D] transition-all disabled:opacity-30 disabled:cursor-not-allowed group"
                        aria-label="Next page"
                    >
                        <span
                            class="material-symbols-outlined text-[20px] group-hover:translate-x-0.5 transition-transform"
                            >chevron_right</span
                        >
                    </button>
                </div>
                <div
                    class="text-xs font-medium text-slate-500 dark:text-text-muted uppercase tracking-widest"
                    id="pagination-info"
                >
                    Page 1 of 1
                </div>
            </div>
        </div>
    </main>

    <Footer />
</Layout>

<script>
    const topicButtons = document.querySelectorAll(".topic-filter");
    const archiveGrid = document.getElementById("archive-grid");
    const getArchiveItems = () => document.querySelectorAll(".archive-item") as NodeListOf<HTMLElement>;
    const sortToggle = document.getElementById("sort-toggle");
    const sortLabel = document.getElementById("sort-label");

    // Pagination Elements
    const prevBtn = document.getElementById("prev-page") as HTMLButtonElement;
    const nextBtn = document.getElementById("next-page") as HTMLButtonElement;
    const pageNumbersContainer = document.getElementById("page-numbers");
    const paginationInfo = document.getElementById("pagination-info");

    let currentSort = "newest";
    let currentTopic = "all";
    let currentTag: string | null = null;
    let currentPage = 1;
    const itemsPerPage = 9;

    // Filtered items based on topic and tag
    let filteredItems: HTMLElement[] = Array.from(getArchiveItems());

    const updatePagination = () => {
        const totalPages = Math.ceil(filteredItems.length / itemsPerPage) || 1;
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        // Update Info
        if (paginationInfo)
            paginationInfo.textContent = `Page ${currentPage} of ${totalPages}`;

        // Update Buttons
        if (prevBtn) prevBtn.disabled = currentPage === 1;
        if (nextBtn) nextBtn.disabled = currentPage === totalPages;

        // Render Page Numbers
        if (pageNumbersContainer) {
            pageNumbersContainer.innerHTML = "";
            for (let i = 1; i <= totalPages; i++) {
                const btn = document.createElement("button");
                btn.className = `w-10 h-10 rounded-lg border transition-all text-sm font-bold ${
                    i === currentPage
                        ? "bg-[#F2AF0D] text-slate-900 dark:text-white border-[#F2AF0D] shadow-[0_0_15px_rgba(212,175,55,0.3)]"
                        : "bg-slate-100 dark:bg-background-input border-[#F2AF0D]/20 text-slate-900 dark:text-white hover:bg-[#F2AF0D]/10 hover:border-[#F2AF0D]"
                }`;
                btn.textContent = i.toString();
                btn.addEventListener("click", () => {
                    currentPage = i;
                    updatePagination();
                    window.scrollTo({ top: 0, behavior: "smooth" });
                });
                pageNumbersContainer.appendChild(btn);
            }
        }

        renderCurrentPage();
    };

    const renderCurrentPage = () => {
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;

        // Fade effect
        if (archiveGrid) archiveGrid.style.opacity = "0";

        setTimeout(() => {
            getArchiveItems().forEach((item) => (item.style.display = "none"));

            filteredItems.forEach((item, index) => {
                if (index >= start && index < end) {
                    item.style.display = "block";
                }
            });

            if (archiveGrid) archiveGrid.style.opacity = "1";
        }, 200);
    };

    const applyFilter = (topic: string | null, tag: string | null = null) => {
        if (!topic) topic = "all";
        currentTopic = topic;
        currentTag = tag;

        // Update active states
        topicButtons.forEach((btn) => {
            const btnTopic = btn.getAttribute("data-topic");
            if (btnTopic === topic) {
                btn.classList.add("active");
            } else {
                btn.classList.remove("active");
            }
        });

        // Filter items
        filteredItems = Array.from(getArchiveItems()).filter((item) => {
            const matchesTopic =
                topic === "all" || item.getAttribute("data-topic") === topic;

            if (tag) {
                const itemTags =
                    item.getAttribute("data-tags")?.split(",") || [];
                return matchesTopic && itemTags.includes(tag.toLowerCase());
            }

            return matchesTopic;
        });

        currentPage = 1;
        updatePagination();
    };

    prevBtn?.addEventListener("click", () => {
        if (currentPage > 1) {
            currentPage--;
            updatePagination();
            window.scrollTo({ top: 0, behavior: "smooth" });
        }
    });

    nextBtn?.addEventListener("click", () => {
        const totalPages = Math.ceil(filteredItems.length / itemsPerPage);
        if (currentPage < totalPages) {
            currentPage++;
            updatePagination();
            window.scrollTo({ top: 0, behavior: "smooth" });
        }
    });

    // Check for query parameters on load
    const urlParams = new URLSearchParams(window.location.search);
    const initialTopic = urlParams.get("topic");
    const initialTag = urlParams.get("tag");
    applyFilter(initialTopic, initialTag);

    // Topic Filtering Click Events
    topicButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const topic = button.getAttribute("data-topic");
            applyFilter(topic, currentTag);

            let newUrl =
                topic === "all" ? window.location.pathname : `?topic=${topic}`;
            if (currentTag) {
                newUrl += (topic === "all" ? "?" : "&") + `tag=${currentTag}`;
            }
            window.history.pushState({ topic, tag: currentTag }, "", newUrl);
        });
    });

    // Sorting
    sortToggle?.addEventListener("click", () => {
        currentSort = currentSort === "newest" ? "oldest" : "newest";
        if (sortLabel)
            sortLabel.textContent =
                currentSort === "newest" ? "Más recientes" : "Más antiguos";

        const sortedItems = Array.from(getArchiveItems()).sort((a, b) => {
            const dateA = parseInt(a.getAttribute("data-date") || "0");
            const dateB = parseInt(b.getAttribute("data-date") || "0");
            return currentSort === "newest" ? dateB - dateA : dateA - dateB;
        });

        // Update items in the DOM and re-filter
        sortedItems.forEach((item) => archiveGrid?.appendChild(item));
        applyFilter(currentTopic, currentTag);
    });
    // Carousel logic
    const topicFiltersContainer = document.getElementById("topic-filters");
    const scrollLeftBtn = document.getElementById("scroll-left");
    const scrollRightBtn = document.getElementById("scroll-right");

    if (topicFiltersContainer && scrollLeftBtn && scrollRightBtn) {
        const checkScroll = () => {
            if (topicFiltersContainer.scrollLeft > 0) {
                scrollLeftBtn.classList.remove("opacity-0", "pointer-events-none");
            } else {
                scrollLeftBtn.classList.add("opacity-0", "pointer-events-none");
            }
            if (topicFiltersContainer.scrollLeft + topicFiltersContainer.clientWidth < topicFiltersContainer.scrollWidth - 1) {
                scrollRightBtn.classList.remove("opacity-0", "pointer-events-none");
            } else {
                scrollRightBtn.classList.add("opacity-0", "pointer-events-none");
            }
        };

        topicFiltersContainer.addEventListener("scroll", checkScroll);
        window.addEventListener("resize", checkScroll);
        setTimeout(checkScroll, 100);

        scrollLeftBtn.addEventListener("click", () => {
            topicFiltersContainer.scrollBy({ left: -200, behavior: "smooth" });
        });

        scrollRightBtn.addEventListener("click", () => {
            topicFiltersContainer.scrollBy({ left: 200, behavior: "smooth" });
        });
    }
</script>

<style>
    @reference "../styles/global.css";

    .topic-filter.active {
        @apply bg-[#F2AF0D] text-slate-900 dark:text-white font-bold;
        box-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
    }

    #archive-grid {
        transition-property: opacity;
    }

    #topic-filters::-webkit-scrollbar {
        display: none;
    }
</style>
