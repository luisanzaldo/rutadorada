---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";

const title = "Restablecer contraseña | RutaDorada";
---

<Layout title={title}>
    <Header />
    <main
        class="flex-grow grid place-items-center relative overflow-hidden py-20 px-4"
    >
        <!-- Background Elements -->
        <div class="absolute inset-0 pointer-events-none">
            <div
                class="absolute top-[-10%] left-[-5%] w-[500px] h-[500px] bg-primary/20 rounded-full blur-[120px] mix-blend-screen opacity-30"
            >
            </div>
            <div
                class="absolute bottom-[-10%] right-[-5%] w-[500px] h-[500px] bg-purple-500/10 rounded-full blur-[120px] mix-blend-screen opacity-30"
            >
            </div>
        </div>

        <div class="w-full max-w-md relative z-10">
            <div
                class="bg-white/80 dark:bg-[#0b1618] border border-slate-200 dark:border-[#224249] rounded-2xl p-8 shadow-2xl backdrop-blur-sm"
            >
                <!-- Loading State -->
                <div id="loading-state" class="py-8 text-center">
                    <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-primary border-t-transparent mb-4"></div>
                    <h2 class="font-display font-bold text-xl text-slate-900 dark:text-white">Verificando enlace...</h2>
                    <p class="text-slate-500 text-sm mt-2">Por favor esperá un momento.</p>
                </div>

                <!-- Form State -->
                <div id="form-state" class="hidden">
                    <div class="text-center mb-8">
                        <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-primary/10 mb-5">
                            <svg class="h-8 w-8 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>
                        </div>
                        <h1
                            class="font-display font-bold text-3xl text-slate-900 dark:text-white mb-2"
                        >
                            Nueva contraseña
                        </h1>
                        <p class="text-slate-500 text-sm">
                            Ingresá tu nueva contraseña para restablecer el acceso.
                        </p>
                    </div>

                    <form class="space-y-5" id="reset-password-form">
                        <div>
                            <label
                                for="new-password"
                                class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2"
                                >Nueva contraseña</label
                            >
                            <div class="relative">
                                <input
                                    type="password"
                                    id="new-password"
                                    required
                                    minlength="6"
                                    class="w-full bg-slate-50 dark:bg-[#162a2f] text-slate-900 dark:text-white px-4 py-3 pr-12 rounded-xl border border-slate-200 dark:border-transparent focus:border-primary/50 focus:ring-2 focus:ring-primary/20 outline-none transition-all placeholder:text-slate-400"
                                    placeholder="••••••••"
                                />
                                <button
                                    type="button"
                                    id="toggle-new-password"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors p-1"
                                    aria-label="Mostrar contraseña"
                                >
                                    <svg id="eye-icon-new" class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                    </svg>
                                    <svg id="eye-off-icon-new" class="w-5 h-5 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <div>
                            <label
                                for="confirm-password"
                                class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2"
                                >Confirmar contraseña</label
                            >
                            <div class="relative">
                                <input
                                    type="password"
                                    id="confirm-password"
                                    required
                                    minlength="6"
                                    class="w-full bg-slate-50 dark:bg-[#162a2f] text-slate-900 dark:text-white px-4 py-3 pr-12 rounded-xl border border-slate-200 dark:border-transparent focus:border-primary/50 focus:ring-2 focus:ring-primary/20 outline-none transition-all placeholder:text-slate-400"
                                    placeholder="••••••••"
                                />
                                <button
                                    type="button"
                                    id="toggle-confirm-password"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors p-1"
                                    aria-label="Mostrar contraseña"
                                >
                                    <svg id="eye-icon-confirm" class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                    </svg>
                                    <svg id="eye-off-icon-confirm" class="w-5 h-5 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <div
                            id="error-message"
                            class="hidden text-red-500 text-sm text-center bg-red-500/10 p-2 rounded-lg border border-red-500/20"
                        >
                        </div>

                        <button
                            type="submit"
                            id="submit-btn"
                            class="w-full bg-primary hover:bg-primary/90 text-[#102023] font-bold py-3.5 rounded-xl shadow-lg shadow-primary/25 hover:shadow-primary/40 transform hover:-translate-y-0.5 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
                        >
                            Restablecer contraseña
                        </button>
                    </form>
                </div>

                <!-- Success State -->
                <div id="success-state" class="hidden py-4 text-center">
                    <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-green-100 dark:bg-green-900/30 mb-6 transition-transform duration-500 scale-110">
                        <svg class="h-10 w-10 text-green-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <h2 class="font-display font-bold text-2xl text-slate-900 dark:text-white mb-3">
                        ¡Contraseña actualizada!
                    </h2>
                    <p class="text-slate-500 text-sm animate-pulse">Redirigiendo al login...</p>
                </div>

                <!-- Expired/Invalid Token State -->
                <div id="expired-state" class="hidden py-4 text-center">
                    <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-red-100 dark:bg-red-900/20 mb-6">
                        <svg class="h-10 w-10 text-red-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.5 0L4.27 16.5c-.77.833.192 2.5 1.732 2.5z" />
                        </svg>
                    </div>
                    <h2 class="font-display font-bold text-2xl text-slate-900 dark:text-white mb-3">
                        Enlace inválido o expirado
                    </h2>
                    <p class="text-slate-500 text-sm leading-relaxed mb-8">
                        El enlace para restablecer tu contraseña ya no es válido. Esto puede ocurrir si expiró o ya fue utilizado.
                    </p>
                    <a
                        href="/forgot-password"
                        class="inline-flex justify-center items-center w-full bg-primary hover:bg-primary/90 text-[#102023] font-bold py-3.5 rounded-xl shadow-lg shadow-primary/25 hover:shadow-primary/40 transition-all duration-200"
                    >
                        Solicitar un nuevo enlace
                    </a>
                </div>

            </div>
        </div>

        <!--
            We removed the inline script here. Supabase SDK will establish the session naturally,
            and we'll handle the event below to clear local storage so the session
            doesn't persist if the user leaves the page without resetting.
        -->
    </main>
</Layout>

<script>
    import { supabase } from "../lib/supabase";

    const loadingState = document.getElementById("loading-state");
    const formState = document.getElementById("form-state");
    const successState = document.getElementById("success-state");
    const expiredState = document.getElementById("expired-state");
    const form = document.getElementById("reset-password-form") as HTMLFormElement;
    const newPasswordInput = document.getElementById("new-password") as HTMLInputElement;
    const confirmPasswordInput = document.getElementById("confirm-password") as HTMLInputElement;
    const errorMessage = document.getElementById("error-message");
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

    let resetCompleted = false;

    function clearSupabaseStorage() {
        try {
            for (let i = localStorage.length - 1; i >= 0; i--) {
                const key = localStorage.key(i);
                if (key && key.startsWith('sb-') && key.endsWith('-auth-token')) {
                    localStorage.removeItem(key);
                }
            }
            for (let i = sessionStorage.length - 1; i >= 0; i--) {
                const key = sessionStorage.key(i);
                if (key && key.startsWith('sb-') && key.endsWith('-auth-token')) {
                    sessionStorage.removeItem(key);
                }
            }
        } catch(e) {}
    }

    // Process initial URL quickly to see if it's completely invalid (no token/code)
    const hash = window.location.hash;
    const search = window.location.search;
    if (!hash.includes('type=recovery') && !search.includes('code=')) {
        setTimeout(() => {
            if (loadingState) loadingState.classList.add("hidden");
            if (expiredState) expiredState.classList.remove("hidden");
        }, 500);
    }

    // Wait for Supabase to process URL and emit its event (either PASSWORD_RECOVERY or SIGNED_IN)
    supabase.auth.onAuthStateChange(async (event, session) => {
        if (event === "PASSWORD_RECOVERY" || event === "SIGNED_IN") {
            if (loadingState) loadingState.classList.add("hidden");
            if (formState) formState.classList.remove("hidden");
            if (expiredState) expiredState.classList.add("hidden");
        }
    });

    // Handle form submission
    form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        const newPassword = newPasswordInput.value;
        const confirmPassword = confirmPasswordInput.value;

        // Reset error
        if (errorMessage) {
            errorMessage.textContent = "";
            errorMessage.classList.add("hidden");
        }

        // Validate passwords match
        if (newPassword !== confirmPassword) {
            if (errorMessage) {
                errorMessage.textContent = "Las contraseñas no coinciden.";
                errorMessage.classList.remove("hidden");
            }
            return;
        }

        // Validate password length
        if (newPassword.length < 6) {
            if (errorMessage) {
                errorMessage.textContent = "La contraseña debe tener al menos 6 caracteres.";
                errorMessage.classList.remove("hidden");
            }
            return;
        }

        // Disable button
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = "Actualizando...";
        }

        try {
            // WE ALREADY HAVE AN ACTIVE SESSION IN MEMORY (Supabase SDK), so just call updateUser!
            const { error } = await supabase.auth.updateUser({
                password: newPassword,
            });

            if (error) {
                throw error;
            }

            // Mark as completed
            resetCompleted = true;

            // Fully sign out and clear everything
            await supabase.auth.signOut();
            clearSupabaseStorage();

            // Show success and redirect
            if (formState) formState.classList.add("hidden");
            if (successState) successState.classList.remove("hidden");

            setTimeout(() => {
                window.location.href = "/login";
            }, 2000);

        } catch (error: any) {
            if (errorMessage) {
                let msg = error.message || "Hubo un problema al actualizar la contraseña. Intentá de nuevo.";
                if (msg.includes("should be different") || msg.includes("different from the old")) {
                    msg = "Tu nueva contraseña debe ser diferente a tus anteriores contraseñas.";
                }
                errorMessage.textContent = msg;
                errorMessage.classList.remove("hidden");
            }
        } finally {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = "Restablecer contraseña";
            }
        }
    });

    // Toggle password visibility
    function setupToggle(toggleId: string, inputId: string, eyeId: string, eyeOffId: string) {
        const toggle = document.getElementById(toggleId);
        const input = document.getElementById(inputId) as HTMLInputElement;
        const eyeIcon = document.getElementById(eyeId);
        const eyeOffIcon = document.getElementById(eyeOffId);

        toggle?.addEventListener("click", () => {
            const isPassword = input.type === "password";
            input.type = isPassword ? "text" : "password";
            eyeIcon?.classList.toggle("hidden", isPassword);
            eyeOffIcon?.classList.toggle("hidden", !isPassword);
        });
    }

    setupToggle("toggle-new-password", "new-password", "eye-icon-new", "eye-off-icon-new");
    setupToggle("toggle-confirm-password", "confirm-password", "eye-icon-confirm", "eye-off-icon-confirm");

    // Safety net: if the user navigates away without completing the reset, clean up
    window.addEventListener("beforeunload", () => {
        if (!resetCompleted) {
            try { supabase.auth.signOut(); } catch(e) {}
            clearSupabaseStorage();
        }
    });
</script>

