---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPosts = sortedPosts.filter((post) => post.data.featured).slice(0, 5);
const mainFeaturedPost = featuredPosts[0];
const otherFeaturedPosts = featuredPosts.slice(1);

const featuredSlugs = new Set(featuredPosts.map(p => p.slug));
const regularPosts = sortedPosts.filter((post) => !featuredSlugs.has(post.slug));

const formatDate = (date: Date) => {
	return date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
};
---

<Layout title="RutaDorada | El Arte del Cine">
	<Header />
	<Hero />

	<main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full">
		<div class="flex flex-col lg:flex-row gap-12">
			<!-- Main Content -->
			<div class="lg:w-2/3">
				<div class="flex items-center justify-between mb-8">
					<h2
						class="text-2xl font-bold text-slate-900 dark:text-white border-l-4 border-primary pl-3"
					>
						Descubre las últimas noticias
					</h2>

				</div>

				<!-- Featured Post -->
				{
					mainFeaturedPost && (
						<ArticleCard
							featured={true}
							title={mainFeaturedPost.data.title}
							description={mainFeaturedPost.data.description}
							image={mainFeaturedPost.data.image}
							category={mainFeaturedPost.data.category}
							author={mainFeaturedPost.data.author}
							authorImage={mainFeaturedPost.data.authorImage}
							date={formatDate(mainFeaturedPost.data.pubDate)}
							readTime={mainFeaturedPost.data.readTime}
							slug={mainFeaturedPost.slug}
						/>
					)
				}

				<!-- Post Grid (Other Featured + Regular) -->
				<div class="grid md:grid-cols-2 gap-6">
					{
						otherFeaturedPosts.map((post) => (
							<ArticleCard
								title={post.data.title}
								description={post.data.description}
								image={post.data.image}
								category={post.data.category}
								author={post.data.author}
								date={formatDate(post.data.pubDate)}
								readTime={post.data.readTime}
								slug={post.slug}
							/>
						))
					}
					{
						regularPosts.map((post) => (
							<ArticleCard
								title={post.data.title}
								description={post.data.description}
								image={post.data.image}
								category={post.data.category}
								author={post.data.author}
								date={formatDate(post.data.pubDate)}
								readTime={post.data.readTime}
								slug={post.slug}
							/>
						))
					}
				</div>

				<div class="mt-12 text-center">
					<a
						href={`${import.meta.env.BASE_URL}/archive`}
						class="inline-block px-6 py-2 rounded-full border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:border-primary hover:text-primary dark:hover:border-primary dark:hover:text-primary transition-all text-sm font-medium"
					>
						Archivo de publicaciones
					</a>
				</div>
			</div>

			<!-- Sidebar -->
			<Sidebar />
		</div>
	</main>

	<Footer />
</Layout>
