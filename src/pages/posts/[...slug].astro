---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PostSidebarLeft from "../../components/PostSidebarLeft.astro";
import PostSidebarRight from "../../components/PostSidebarRight.astro";
import Comments from "../../components/Comments.astro";

export async function getStaticPaths() {
    const posts = await getCollection("posts");
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

const allPosts = await getCollection("posts");

// Get the latest 3 posts that share at least one tag
const finalRelatedPosts = allPosts
    .filter((p) => {
        if (p.slug === post.slug) return false;
        if (!p.data.tags || !post.data.tags) return false;
        return p.data.tags.some((tag: string) => post.data.tags.includes(tag));
    })
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);

const formattedRelatedPosts = finalRelatedPosts.map((p) => ({
    title: p.data.title,
    date: p.data.pubDate.toLocaleDateString("en-US", {
        month: "short",
        day: "2-digit",
        year: "numeric",
    }),
    readTime: p.data.readTime,
    image: p.data.image,
    slug: p.slug,
    category: p.data.category,
    videoUrl: p.data.videoUrl,
}));

const formatDate = (date: Date) => {
    return date.toLocaleDateString("en-US", {
        year: "numeric",
        month: "short",
        day: "numeric",
    });
};
---

<Layout title={`${post.data.title} | RutaDorada`}>
    <Header />

    <main class="relative flex min-h-screen flex-col">
        <div
            class="w-full max-w-[1440px] mx-auto flex-1 px-4 sm:px-6 lg:px-8 py-10"
        >
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 relative">
                <!-- Left Sidebar -->
                <PostSidebarLeft slug={post.slug} />

                <!-- Article Content -->
                <article class="col-span-1 lg:col-span-8 w-full">
                    <div class="mb-10">
                        <div class="flex flex-wrap gap-2 mb-6">
                            <span
                                class="inline-flex items-center rounded-lg bg-primary/10 px-3 py-1 text-sm font-medium text-primary ring-1 ring-inset ring-primary/20"
                            >
                                {post.data.category}
                            </span>
                            {
                                post.data.subCategory && (
                                    <span class="inline-flex items-center rounded-lg bg-slate-100 dark:bg-[#224249]/50 px-3 py-1 text-sm font-medium text-slate-600 dark:text-slate-300">
                                        {post.data.subCategory}
                                    </span>
                                )
                            }
                        </div>

                        <h1
                            class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15] mb-6"
                        >
                            {post.data.title}
                        </h1>

                        {
                            post.data.tags && post.data.tags.length > 0 && (
                                <div class="flex flex-wrap gap-2 mb-6">
                                    {post.data.tags.map((tag: string) => (
                                        <span class="px-3 py-1 rounded-lg bg-primary text-sm font-bold text-white shadow-sm cursor-default">
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                            )
                        }

                        <div
                            class="flex items-center gap-4 py-4 border-b border-slate-200 dark:border-[#224249]"
                        >
                            <div class="relative">
                                {
                                    post.data.authorImage && (
                                        <img
                                            src={post.data.authorImage}
                                            alt={post.data.author}
                                            class="h-12 w-12 rounded-full ring-2 ring-white dark:ring-[#102023] object-cover"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                    )
                                }
                                <span
                                    class="absolute bottom-0 right-0 block h-3 w-3 rounded-full bg-green-500 ring-2 ring-white dark:ring-[#102023]"
                                ></span>
                            </div>
                            <div class="flex flex-col">
                                <span
                                    class="text-sm font-bold text-slate-900 dark:text-white"
                                    >{post.data.author}</span
                                >
                                <div
                                    class="flex items-center gap-2 text-sm text-slate-500 dark:text-[#90c1cb]"
                                >
                                    <span>{formatDate(post.data.pubDate)}</span>
                                    <span>•</span>
                                    <span>{post.data.readTime}</span>
                                </div>
                            </div>
                            <div class="ml-auto flex gap-2">
                                <button
                                    class="rounded-full p-2 text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors lg:hidden"
                                    aria-label="Share"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path
                                            d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"
                                        ></path>
                                        <polyline points="16 6 12 2 8 6"
                                        ></polyline>
                                        <line x1="12" x2="12" y1="2" y2="15"
                                        ></line>
                                    </svg>
                                </button>
                                <button
                                    class="rounded-full p-2 text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors lg:hidden"
                                    aria-label="Bookmark"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path
                                            d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"
                                        ></path>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>

                    {
                        post.data.category !== "Tráilers" && post.data.image && (
                            <div class="relative w-full rounded-2xl overflow-hidden mb-12 shadow-[0_20px_50px_-15px_rgba(217,119,6,0.3)] border border-slate-200 dark:border-white/10 group">
                                <img
                                    src={post.data.image}
                                    alt={`Portada de ${post.data.title}`}
                                    class="w-full h-[300px] sm:h-[400px] md:h-[500px] object-cover transition-transform duration-1000 group-hover:scale-105"
                                    loading="lazy"
                                    decoding="async"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-[#0c0a09]/60 via-transparent to-transparent opacity-80 pointer-events-none"></div>
                                <div class="absolute inset-x-0 bottom-0 p-6 flex justify-end pointer-events-none">
                                     <div class="w-12 h-1 bg-primary/80 rounded-full blur-[1px]"></div>
                                </div>
                            </div>
                        )
                    }

                    <div
                        class="prose prose-lg dark:prose-invert max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl"
                    >
                        <Content />
                    </div>

                    <div
                        class="mt-12 pt-8"
                    >
                        <div
                            class="flex flex-col sm:flex-row justify-end items-center gap-6"
                        >
                            <!-- Social Share -->
                            <div class="flex items-center gap-4">
                                <span
                                    class="text-sm font-medium text-slate-900 dark:text-white"
                                    >Compartir</span
                                >
                                <div class="flex gap-2">
                                    <button
                                        class="size-8 flex items-center justify-center rounded-full bg-slate-100 dark:bg-surface-dark text-slate-600 dark:text-slate-300 hover:bg-black dark:hover:bg-white hover:text-white dark:hover:text-black transition-all share-btn"
                                        aria-label="Compartir en X"
                                        data-network="x"
                                    >
                                        <svg
                                            class="w-3.5 h-3.5"
                                            fill="currentColor"
                                            viewBox="0 0 1200 1227"
                                            ><path
                                                d="M714.163 519.284L1160.89 0H1055.03L667.137 450.887L357.328 0H0L468.492 681.821L0 1226.37H105.866L515.491 750.218L842.672 1226.37H1200L714.137 519.284H714.163ZM569.165 687.828L521.697 619.934L144.011 79.6944H306.615L611.412 515.685L658.88 583.579L1055.08 1150.3H892.476L569.165 687.854V687.828Z"
                                            ></path></svg
                                        >
                                    </button>
                                    <button
                                        class="size-8 flex items-center justify-center rounded-full bg-slate-100 dark:bg-surface-dark text-slate-600 dark:text-slate-300 hover:bg-[#25D366] hover:text-white transition-all share-btn"
                                        aria-label="Compartir en WhatsApp"
                                        data-network="whatsapp"
                                    >
                                        <svg
                                            class="w-4 h-4"
                                            fill="currentColor"
                                            viewBox="0 0 24 24"
                                            ><path
                                                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                                            ></path></svg
                                        >
                                    </button>
                                    <button
                                        class="size-8 relative flex items-center justify-center rounded-full bg-slate-100 dark:bg-surface-dark text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all share-btn"
                                        aria-label="Copiar enlace"
                                        data-network="copy"
                                    >
                                        <svg
                                            class="w-4 h-4"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                            ><path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
                                            ></path></svg>
                                        <span class="absolute -top-8 bg-slate-800 text-white text-[10px] py-1 px-2 rounded opacity-0 transition-opacity whitespace-nowrap copy-tooltip pointer-events-none">¡Copiado!</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Comments Section -->
                    <Comments slug={post.slug} />
                </article>

                <!-- Right Sidebar -->
                <div class="hidden lg:block lg:col-span-3">
                    <PostSidebarRight
                        headings={headings}
                        relatedPosts={formattedRelatedPosts}
                        category={post.data.category}
                        fichaTecnica={post.data.fichaTecnica}
                    />
                </div>
            </div>
        </div>
    </main>

    <Footer />

    <script>
        // Copy to clipboard functionality
        const copyButtons = document.querySelectorAll(".copy-button");
        copyButtons.forEach((button) => {
            button.addEventListener("click", async () => {
                // Find the nearest code block relative to the button's wrapper
                const wrapper = button.closest(".code-block-wrapper");
                const codeElement = wrapper?.querySelector("pre");
                const code = codeElement?.innerText || "";

                const textSpan = button.querySelector("span:last-child");
                const iconElement =
                    button.querySelector(".material-symbols-outlined") ||
                    button.querySelector("svg") ||
                    button.querySelector(".icon-container");

                if (code && textSpan) {
                    try {
                        await navigator.clipboard.writeText(code);

                        // Visual feedback
                        if (textSpan) textSpan.textContent = "Copied!";

                        if (iconElement) {
                            iconElement.innerHTML = `
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            `;
                        }

                        button.classList.add("text-primary");

                        setTimeout(() => {
                            if (textSpan) textSpan.textContent = "Copy";
                            if (iconElement) {
                                iconElement.innerHTML = `
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>
                                `;
                            }
                            button.classList.remove("text-primary");
                        }, 2000);
                    } catch (err) {
                        console.error("Failed to copy text: ", err);
                    }
                }
            });
        });
        // Social Share functionality
        const shareButtons = document.querySelectorAll(".share-btn");
        shareButtons.forEach(btn => {
            btn.addEventListener("click", () => {
                const network = btn.getAttribute("data-network");
                const url = encodeURIComponent(window.location.href);
                const title = encodeURIComponent(document.title);
                let shareUrl = '';

                switch(network) {
                    case 'x':
                        shareUrl = `https://twitter.com/intent/tweet?url=${url}&text=${title}`;
                        window.open(shareUrl, '_blank', 'noopener,noreferrer');
                        break;
                    case 'whatsapp':
                        shareUrl = `https://api.whatsapp.com/send?text=${title} - ${url}`;
                        window.open(shareUrl, '_blank', 'noopener,noreferrer');
                        break;
                    case 'copy':
                        navigator.clipboard.writeText(window.location.href).then(() => {
                            const tooltip = btn.querySelector('.copy-tooltip') as HTMLElement;
                            if (tooltip) {
                                tooltip.style.opacity = '1';
                                setTimeout(() => tooltip.style.opacity = '0', 2000);
                            }
                        });
                        break;
                }
            });
        });
    </script>
</Layout>
