---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PostSidebarLeft from "../../components/PostSidebarLeft.astro";
import PostSidebarRight from "../../components/PostSidebarRight.astro";
import Comments from "../../components/Comments.astro";
import ShareModal from "../../components/ShareModal.astro";
import Speedometer from "../../components/Speedometer.astro";

export async function getStaticPaths() {
    const posts = await getCollection("posts");
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

const allPosts = await getCollection("posts");

// Get the latest 3 posts that share at least one tag
const finalRelatedPosts = allPosts
    .filter((p) => {
        if (p.slug === post.slug) return false;
        if (!p.data.tags || !post.data.tags) return false;
        return p.data.tags.some((tag: string) => post.data.tags.includes(tag));
    })
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);

const formattedRelatedPosts = finalRelatedPosts.map((p) => ({
    title: p.data.title,
    date: p.data.pubDate.toLocaleDateString("en-US", {
        month: "short",
        day: "2-digit",
        year: "numeric",
    }),
    readTime: p.data.readTime,
    image: p.data.image,
    slug: p.slug,
    category: p.data.category,
    videoUrl: p.data.videoUrl,
}));

const formatDate = (date: Date) => {
    return date.toLocaleDateString("en-US", {
        year: "numeric",
        month: "short",
        day: "numeric",
    });
};

const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const finalImage = post.data.image ? (post.data.image.startsWith('/') ? `${baseUrl}${post.data.image}` : post.data.image) : '';
---

<Layout 
    title={`${post.data.title} | RutaDorada`} 
    description={post.data.description}
    image={finalImage}
>
    <Header />

    <main class="relative flex min-h-screen flex-col">
        <div
            class="w-full max-w-[1440px] mx-auto flex-1 px-4 sm:px-6 lg:px-8 py-10"
        >
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 relative">
                <!-- Left Sidebar -->
                <PostSidebarLeft slug={post.slug} />

                <!-- Article Content -->
                <article class="col-span-1 lg:col-span-8 w-full">
                    <div class="mb-10">
                        <div class="flex flex-wrap gap-2 mb-6">
                            <span
                                class="inline-flex items-center rounded-lg bg-primary/10 px-3 py-1 text-sm font-medium text-primary ring-1 ring-inset ring-primary/20"
                            >
                                {post.data.category}
                            </span>
                            {
                                post.data.subCategory && (
                                    <span class="inline-flex items-center rounded-lg bg-slate-100 dark:bg-[#224249]/50 px-3 py-1 text-sm font-medium text-slate-600 dark:text-slate-300">
                                        {post.data.subCategory}
                                    </span>
                                )
                            }
                        </div>

                        <h1
                            class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15] mb-6"
                        >
                            {post.data.title}
                        </h1>

                        {
                            post.data.tags && post.data.tags.length > 0 && (
                                <div class="flex flex-wrap gap-2 mb-6">
                                    {post.data.tags.map((tag: string) => (
                                        <span class="px-3 py-1 rounded-lg bg-primary text-sm font-bold text-[#102023] shadow-sm cursor-default">
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                            )
                        }

                        <div
                            class="flex items-center gap-4 py-4 border-b border-slate-200 dark:border-[#224249]"
                        >
                            <div class="relative">
                                {
                                    post.data.authorImage && (
                                        <img
                                            src={post.data.authorImage}
                                            alt={post.data.author}
                                            class="h-12 w-12 rounded-full ring-2 ring-white dark:ring-[#102023] object-cover"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                    )
                                }
                                <span
                                    class="absolute bottom-0 right-0 block h-3 w-3 rounded-full bg-green-500 ring-2 ring-white dark:ring-[#102023]"
                                ></span>
                            </div>
                            <div class="flex flex-col">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-bold text-slate-900 dark:text-white">
                                        {post.data.author}
                                    </span>
                                    {
                                        post.data.letterboxd && (
                                            <a
                                                href={post.data.letterboxd}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="flex items-center justify-center hover:opacity-80 transition-opacity"
                                                title={`Perfil de Letterboxd de ${post.data.author}`}
                                                aria-label="Perfil en Letterboxd"
                                            >
                                                <svg width="24" height="24" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <rect width="100" height="100" rx="20" fill="#14181C"/>
                                                    <circle cx="30" cy="50" r="12" fill="#FF8000"/>
                                                    <circle cx="50" cy="50" r="12" fill="#00E054"/>
                                                    <circle cx="70" cy="50" r="12" fill="#40BCF4"/>
                                                </svg>
                                            </a>
                                        )
                                    }
                                </div>
                                <div
                                    class="flex items-center gap-2 text-sm text-slate-500 dark:text-[#90c1cb]"
                                >
                                    <span>{formatDate(post.data.pubDate)}</span>
                                    <span>•</span>
                                    <span>{post.data.readTime}</span>
                                </div>
                            </div>
                            <div class="ml-auto flex gap-2">
                                <button
                                    class="rounded-full p-2 text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors lg:hidden trigger-share-modal"
                                    aria-label="Share"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path
                                            d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"
                                        ></path>
                                        <polyline points="16 6 12 2 8 6"
                                        ></polyline>
                                        <line x1="12" x2="12" y1="2" y2="15"
                                        ></line>
                                    </svg>
                                </button>
                                <button
                                    id="bookmark-btn-mobile-top"
                                    class="rounded-full p-2 text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors lg:hidden"
                                    aria-label="Bookmark"
                                >
                                    <svg
                                        id="bookmark-icon-mobile-top"
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path
                                            d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"
                                        ></path>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>

                    {
                        post.data.category !== "Tráilers" && finalImage && (
                            <div class="relative w-full rounded-2xl overflow-hidden mb-12 shadow-[0_20px_50px_-15px_rgba(217,119,6,0.3)] border border-slate-200 dark:border-white/10 group">
                                <img
    src={finalImage}
    alt={`Portada de ${post.data.title}`}
    class="w-full h-[300px] sm:h-[400px] md:h-[500px] object-cover transition-transform duration-1000 group-hover:scale-105"
    loading="lazy"
    decoding="async"
/>
                                <div class="absolute inset-0 bg-gradient-to-t from-[#0c0a09]/60 via-transparent to-transparent opacity-80 pointer-events-none"></div>

                            </div>
                        )
                    }

                    <div
                        class="prose prose-lg dark:prose-invert max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-h2:text-lg sm:prose-h2:text-xl prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl [&_strong]:!text-primary [&_b]:!text-primary"
                    >
                        <Content />
                    </div>

                    {
                        (post.data.category === "Artículos" || post.data.category === "Premios") && post.data.fuente && (
                            <div class="mt-8 pt-6 border-t border-slate-200 dark:border-[#224249] text-sm text-slate-500 dark:text-slate-400">
                                <span class="font-bold text-slate-700 dark:text-slate-300">Fuente:</span>
                                <a
                                    href={post.data.fuente.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-primary hover:underline ml-1"
                                >
                                    {post.data.fuente.nombre}
                                </a>
                            </div>
                        )
                    }

                    {
                        post.data.category === "Críticas" && post.data.fichaTecnica && (
                            <div class="mt-12 lg:hidden rounded-xl bg-slate-50 dark:bg-background-card p-6 border border-slate-100 dark:border-[#224249]">
                                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-[#90c1cb] mb-4">
                                    Ficha Técnica
                                </h3>
                                <div class="space-y-4 text-sm text-slate-600 dark:text-slate-300">
                                    <div>
                                        <span class="font-bold text-primary block mb-1">Sinopsis:</span>
                                        <p class="text-xs leading-relaxed">{post.data.fichaTecnica.sinopsis}</p>
                                    </div>
                                    <div>
                                        <span class="font-bold text-primary block mb-1">Director:</span>
                                        <p class="text-xs">{post.data.fichaTecnica.director}</p>
                                    </div>
                                    <div>
                                        <span class="font-bold text-primary block mb-1">Cast:</span>
                                        <p class="text-xs">{post.data.fichaTecnica.cast}</p>
                                    </div>
                                    <div>
                                        <span class="font-bold text-primary block mb-1">Duración:</span>
                                        <p class="text-xs">{post.data.fichaTecnica.duracion}</p>
                                    </div>
                                </div>
                            </div>
                        )
                    }

                    {
                        post.data.category === "Críticas" && post.data.rating !== undefined && (
                            <Speedometer rating={post.data.rating} />
                        )
                    }

                    <div
                        class="mt-12 pt-8"
                    >
                        <div
                            class="flex flex-col sm:flex-row justify-end items-center gap-6"
                        >
                            <!-- Space preserved for layout stability -->
                        </div>
                    </div>

                    <!-- Comments Section -->
                    <Comments slug={post.slug} />
                </article>

                <!-- Right Sidebar -->
                <div class="hidden lg:block lg:col-span-3">
                    <PostSidebarRight
                        headings={headings}
                        relatedPosts={formattedRelatedPosts}
                        category={post.data.category}
                        fichaTecnica={post.data.fichaTecnica}
                    />
                </div>
            </div>
        </div>
    </main>

    <Footer />
    <ShareModal />

    <script>
        // Copy to clipboard functionality
        const copyButtons = document.querySelectorAll(".copy-button");
        copyButtons.forEach((button) => {
            button.addEventListener("click", async () => {
                // Find the nearest code block relative to the button's wrapper
                const wrapper = button.closest(".code-block-wrapper");
                const codeElement = wrapper?.querySelector("pre");
                const code = codeElement?.innerText || "";

                const textSpan = button.querySelector("span:last-child");
                const iconElement =
                    button.querySelector(".material-symbols-outlined") ||
                    button.querySelector("svg") ||
                    button.querySelector(".icon-container");

                if (code && textSpan) {
                    try {
                        await navigator.clipboard.writeText(code);

                        // Visual feedback
                        if (textSpan) textSpan.textContent = "Copied!";

                        if (iconElement) {
                            iconElement.innerHTML = `
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            `;
                        }

                        button.classList.add("text-primary");

                        setTimeout(() => {
                            if (textSpan) textSpan.textContent = "Copy";
                            if (iconElement) {
                                iconElement.innerHTML = `
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>
                                `;
                            }
                            button.classList.remove("text-primary");
                        }, 2000);
                    } catch (err) {
                        console.error("Failed to copy text: ", err);
                    }
                }
            });
        });
    </script>
</Layout>
