---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const title = "Mis Favoritos | RutaDorada";

// Get all currently valid slugs to avoid showing deleted posts that still have 'favorites' in Supabase
const allPosts = await getCollection("posts");
const validSlugs = allPosts.map(p => `posts/${p.slug}`);
---

<Layout title={title}>
    <Header />

    <main
        class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full min-h-[60vh]"
    >
        <div class="mb-10">
            <h1
                class="text-3xl font-extrabold text-slate-900 dark:text-white flex items-center gap-3"
            >
                Mis favoritos
            </h1>
            <p class="text-slate-500 mt-2">Artículos que has guardado para más tarde.</p>
        </div>

        <div
            id="favorites-grid"
            data-valid-slugs={JSON.stringify(validSlugs)}
            class="grid md:grid-cols-2 lg:grid-cols-3 gap-8"
        >
            <!-- Posts will be injected here -->
            <div class="col-span-full py-20 text-center animate-pulse">
                <p class="text-slate-400">Cargando tus favoritos...</p>
            </div>
        </div>

        <div id="no-favorites" class="hidden py-20 text-center">
            <div
                class="w-20 h-20 bg-slate-100 dark:bg-[#162a2f] rounded-full flex items-center justify-center mx-auto mb-4"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400">
                    <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path>
                </svg>
            </div>
            <h2 class="text-xl font-bold text-slate-700 dark:text-slate-300">
                Aún no tienes favoritos
            </h2>
            <p class="text-slate-500 mt-2">
                ¡Guarda los artículos que quieras leer más tarde y aparecerán aquí!
            </p>
            <a
                href={`${import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL}/archive`}
                class="mt-6 inline-block px-6 py-2 bg-primary text-[#102023] rounded-full font-bold hover:bg-primary/90 transition-all"
                >Explorar artículos</a
            >
        </div>
    </main>

    <Footer />

    <script>
        import { supabase } from "../lib/supabase";

        const favoritesGrid = document.getElementById("favorites-grid");
        const noFavorites = document.getElementById("no-favorites");

        async function loadFavorites() {
            const {
                data: { session },
            } = await supabase.auth.getSession();

            if (!session) {
                const basePath = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
                window.location.href = `${basePath}/login?redirect=${encodeURIComponent(window.location.pathname)}`;
                return;
            }

            const { data: favorites, error } = await supabase
                .from("favoritos")
                .select("articulo_id")
                .eq("user_id", session.user.id)
                .order("created_at", { ascending: false });

            // Ensure we do not show posts that have been deleted locally
            const validSlugsStr = favoritesGrid?.getAttribute("data-valid-slugs");
            const validSlugs = validSlugsStr ? JSON.parse(validSlugsStr) : [];
            const filteredFavorites = favorites ? favorites.filter(fav => validSlugs.includes(fav.articulo_id)) : [];

            if (error || filteredFavorites.length === 0) {
                if (favoritesGrid) favoritesGrid.classList.add("hidden");
                if (noFavorites) noFavorites.classList.remove("hidden");
                return;
            }

            renderFavorites(filteredFavorites);
        }

        function renderFavorites(favorites) {
            if (!favoritesGrid) return;

            const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;

            favoritesGrid.innerHTML = favorites
                .map(
                    (fav) => {
                        const slug = fav.articulo_id.replace(/^posts\//, '');
                        return `
                <a href="${baseUrl}/posts/${slug}" class="group bg-white dark:bg-[#162a2f] border border-slate-200 dark:border-[#224249] rounded-2xl overflow-hidden hover:shadow-xl hover:shadow-primary/10 transition-all p-6">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-xs font-bold text-primary uppercase tracking-widest">Artículo guardado</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary/40 group-hover:text-primary transition-colors">
                            <path d="M5 12h14"></path>
                            <path d="m12 5 7 7-7 7"></path>
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-primary transition-colors mb-2 truncate">
                        ${slug
                            .split("-")
                            .map(
                                (word) =>
                                    word.charAt(0).toUpperCase() +
                                    word.slice(1),
                            )
                            .join(" ")}
                    </h3>
                    <p class="text-sm text-slate-500 line-clamp-2">Continúa leyendo este artículo guardado.</p>
                </a>
            `})
                .join("");
        }

        loadFavorites();
    </script>
</Layout>
