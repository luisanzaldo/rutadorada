---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";

const title = "Confirmar Cuenta | RutaDorada";
---

<Layout title={title}>
    <Header />
    <main class="flex-grow grid place-items-center relative overflow-hidden py-20 px-4">
        <!-- Background Elements -->
        <div class="absolute inset-0 pointer-events-none">
            <div class="absolute top-[-10%] left-[-5%] w-[500px] h-[500px] bg-primary/20 rounded-full blur-[120px] mix-blend-screen opacity-30"></div>
            <div class="absolute bottom-[-10%] right-[-5%] w-[500px] h-[500px] bg-purple-500/10 rounded-full blur-[120px] mix-blend-screen opacity-30"></div>
        </div>

        <div class="w-full max-w-md relative z-10">
            <div class="bg-white/80 dark:bg-[#0b1618] border border-slate-200 dark:border-[#224249] rounded-2xl p-8 shadow-2xl backdrop-blur-sm text-center">
                
                <!-- Loading State -->
                <div id="loading-state" class="py-8">
                    <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-primary border-t-transparent mb-4"></div>
                    <h2 class="font-display font-bold text-xl text-slate-900 dark:text-white">Verificando...</h2>
                    <p class="text-slate-500 text-sm mt-2">Por favor espera un momento.</p>
                </div>

                <!-- Success State -->
                <div id="success-state" class="hidden py-4">
                    <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-green-100 dark:bg-green-900/30 mb-6">
                        <svg class="h-10 w-10 text-green-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <h1 class="font-display font-bold text-3xl text-slate-900 dark:text-white mb-4">
                        ¡Cuenta Confirmada!
                    </h1>
                    <p class="text-slate-600 dark:text-slate-300 text-sm mb-8 leading-relaxed">
                        Tu dirección de correo electrónico ha sido verificada con éxito. Ya puedes acceder a todas las funciones de tu cuenta en Ruta Dorada.
                    </p>
                    <a href="/login" class="inline-flex justify-center items-center w-full bg-primary hover:bg-primary/90 text-[#102023] font-bold py-3.5 rounded-xl shadow-lg shadow-primary/25 hover:shadow-primary/40 transform hover:-translate-y-0.5 transition-all duration-200">
                        Iniciar Sesión
                    </a>
                </div>

                <!-- Neutral/Direct Access State -->
                <div id="neutral-state" class="hidden py-4">
                    <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-slate-100 dark:bg-slate-800 mb-6 border border-slate-200 dark:border-[#224249]">
                        <svg class="h-10 w-10 text-slate-400 dark:text-slate-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h1 class="font-display font-bold text-2xl text-slate-900 dark:text-white mb-4">
                        Confirmación de Cuenta
                    </h1>
                    <p class="text-slate-600 dark:text-slate-300 text-sm mb-8 leading-relaxed">
                        No detectamos una cuenta recién confirmada. Es posible que tu enlace de confirmación haya expirado o ya hayas activado tu cuenta anteriormente.
                    </p>
                    <div class="flex flex-col gap-3">
                        <a href="/login" class="inline-flex justify-center items-center w-full bg-primary hover:bg-primary/90 text-[#102023] font-bold py-3.5 rounded-xl shadow-lg shadow-primary/25 hover:shadow-primary/40 transition-all duration-200">
                            Ir a Iniciar Sesión
                        </a>
                        <a href="/" class="inline-flex justify-center items-center w-full bg-transparent border border-slate-200 dark:border-[#224249] hover:bg-slate-50 dark:hover:bg-[#162a2f] text-slate-700 dark:text-slate-300 font-bold py-3.5 rounded-xl transition-all duration-200">
                            Volver al Inicio
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </main>
</Layout>

<script>
    import { supabase } from "../lib/supabase";

    document.addEventListener("DOMContentLoaded", async () => {
        const loadingState = document.getElementById("loading-state");
        const successState = document.getElementById("success-state");
        const neutralState = document.getElementById("neutral-state");

        try {
            // Supabase client automáticamente intenta establecer la sesión 
            // tras redirigir del correo
            const { data: { session }, error } = await supabase.auth.getSession();

            if (loadingState) {
                loadingState.classList.add("hidden");
            }

            // Consideramos éxito si existe una sesión activa
            if (session) {
                if (successState) successState.classList.remove("hidden");
                // Limpiamos los tokens mágicos de la URL
                if (window.location.hash) {
                    window.history.replaceState(null, "", window.location.pathname + window.location.search);
                }
            } else {
                if (neutralState) neutralState.classList.remove("hidden");
            }
        } catch (error) {
            console.error("Error validando la sesión:", error);
            if (loadingState) loadingState.classList.add("hidden");
            if (neutralState) neutralState.classList.remove("hidden");
        }
    });
</script>
