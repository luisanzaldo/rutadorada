---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { getSession } from "../../lib/auth";
import { USERS } from "../../lib/users";

export const prerender = false;

// 1. Verificar la sesión usando getSession
const session = await getSession(Astro.request);

// Si no hay sesión válida, redirigir automáticamente al login
if (!session) {
    return Astro.redirect("/admin/login");
}

// 2. Obtener los datos del usuario logueado
const user = USERS.find((u) => u.username === session.username);

const title = "Nuevo Post | Panel Admin RutaDorada";
---

<Layout title={title}>
    <Header />
    <main class="flex-grow py-12 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto w-full">
        <!-- Background Elements para coherencia visual -->
        <div class="absolute inset-0 pointer-events-none overflow-hidden -z-10">
            <div class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-primary/10 rounded-full blur-[120px] mix-blend-screen opacity-20"></div>
            <div class="absolute bottom-[-10%] left-[-5%] w-[500px] h-[500px] bg-blue-500/5 rounded-full blur-[120px] mix-blend-screen opacity-20"></div>
        </div>

        <div class="bg-white/80 dark:bg-[#0b1618] border border-slate-200 dark:border-[#224249] rounded-3xl p-6 sm:p-10 shadow-2xl backdrop-blur-sm relative z-10">
            
            <!-- Encabezado de la página -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10 border-b border-slate-100 dark:border-[#224249] pb-6">
                <div>
                    <h1 class="font-display font-bold text-3xl text-slate-900 dark:text-white flex items-center gap-3">
                        <a href="/admin" class="flex items-center text-slate-400 hover:text-primary transition-colors hover:-translate-x-1" title="Volver al Panel">
                            <span class="material-symbols-outlined text-[28px]">arrow_back</span>
                        </a>
                        Escribir un nuevo artículo
                    </h1>
                    <p class="text-slate-500 text-sm mt-3 sm:ml-[42px] flex items-center gap-2">
                        <span>Autor asignado:</span> 
                        <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#162a2f] border border-[#224249] text-white">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            <span class="font-medium text-xs tracking-wide">{user?.displayName}</span>
                        </span>
                        {user?.letterboxdUrl && (
                            <a href={user.letterboxdUrl} target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex text-xs text-slate-400 hover:text-[#00E054] transition-colors ml-2" title="Ver perfil de Letterboxd">
                                (Letterboxd)
                            </a>
                        )}
                    </p>
                </div>
            </div>

            <!-- Formulario Principal -->
            <form class="space-y-8" id="nuevo-post-form">
                
                <!-- Sección 1: Información Principal -->
                <div class="space-y-6 bg-slate-50/50 dark:bg-[#162a2f]/20 p-6 rounded-2xl border border-slate-100 dark:border-[#224249]/50">
                    <h3 class="text-sm font-bold text-primary uppercase tracking-widest flex items-center gap-2 mb-4">
                        <span class="material-symbols-outlined text-[18px]">info</span>
                        Datos Principales
                    </h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Título -->
                        <div class="md:col-span-2 space-y-2">
                            <label for="title" class="block text-sm font-bold text-slate-700 dark:text-slate-200">
                                Título del post *
                            </label>
                            <input
                                type="text"
                                id="title"
                                name="title"
                                required
                                class="w-full px-4 py-3 rounded-xl bg-white dark:bg-[#0b1618] border border-slate-200 dark:border-[#224249] text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all font-medium text-lg"
                                placeholder="Escribe el título aquí..."
                            />
                        </div>

                        <!-- Descripción -->
                        <div class="md:col-span-2 space-y-2">
                            <label for="description" class="block text-sm font-bold text-slate-700 dark:text-slate-200">
                                Descripción / Resumen *
                            </label>
                            <textarea
                                id="description"
                                name="description"
                                required
                                rows="3"
                                class="w-full px-4 py-3 rounded-xl bg-white dark:bg-[#0b1618] border border-slate-200 dark:border-[#224249] text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all font-medium resize-none leading-relaxed"
                                placeholder="Un breve resumen que aparecerá en la tarjeta principal y en resultados de búsqueda (SEO)..."
                            ></textarea>
                        </div>
                    </div>
                </div>

                <!-- Sección 2: Metadata y Categorización -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    
                    <!-- Columna Izquierda: Taxonomía -->
                    <div class="space-y-6">
                        <!-- Categoría -->
                        <div class="space-y-2">
                            <label for="category" class="block text-sm font-bold text-slate-700 dark:text-slate-200">
                                Categoría *
                            </label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 flex items-center pointer-events-none">
                                    <span class="material-symbols-outlined text-[18px]">category</span>
                                </span>
                                <select
                                    id="category"
                                    name="category"
                                    required
                                    class="w-full pl-11 pr-10 py-3 rounded-xl bg-slate-50 dark:bg-[#162a2f]/50 border border-slate-200 dark:border-[#224249] text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all font-medium appearance-none cursor-pointer"
                                >
                                    <option value="" disabled selected>Seleccionar categoría...</option>
                                    <option value="Artículos">Artículos</option>
                                    <option value="Premios">Premios</option>
                                    <option value="Críticas">Críticas</option>
                                </select>
                                <span class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 material-symbols-outlined">expand_more</span>
                            </div>
                        </div>

                        <!-- Tags / Etiquetas -->
                        <div class="space-y-2">
                            <label for="tags" class="block text-sm font-bold text-slate-700 dark:text-slate-200">
                                Etiquetas (Tags) <span class="text-xs font-normal text-slate-500">(Separadas por comas)</span>
                            </label>
                            <div class="relative flex items-center">
                                <span class="absolute left-4 text-slate-400 flex items-center pointer-events-none">
                                    <span class="material-symbols-outlined text-[18px]">sell</span>
                                </span>
                                <input
                                    type="text"
                                    id="tags"
                                    name="tags"
                                    class="w-full pl-11 pr-4 py-3 rounded-xl bg-slate-50 dark:bg-[#162a2f]/50 border border-slate-200 dark:border-[#224249] text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all font-medium"
                                    placeholder="Ej. Oscar, Cannes, Box Office"
                                />
                            </div>
                        </div>
                    </div>

                    <!-- Columna Derecha: Fuente original -->
                    <div class="space-y-6">
                        <!-- Nombre de la Fuente -->
                        <div class="space-y-2">
                            <label for="sourceName" class="block text-sm font-bold text-slate-700 dark:text-slate-200">
                                Nombre de la fuente <span class="text-xs font-normal text-slate-500">(Opcional)</span>
                            </label>
                            <input
                                type="text"
                                id="sourceName"
                                name="sourceName"
                                class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-[#162a2f]/50 border border-slate-200 dark:border-[#224249] text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all font-medium"
                                placeholder="Ej. The Hollywood Reporter"
                            />
                        </div>
                        
                        <!-- URL de la Fuente -->
                        <div class="space-y-2">
                            <label for="sourceUrl" class="block text-sm font-bold text-slate-700 dark:text-slate-200">
                                Enlace de la fuente <span class="text-xs font-normal text-slate-500">(Opcional)</span>
                            </label>
                            <div class="relative flex items-center">
                                <span class="absolute left-4 text-slate-400 flex items-center pointer-events-none">
                                    <span class="material-symbols-outlined text-[18px]">link</span>
                                </span>
                                <input
                                    type="url"
                                    id="sourceUrl"
                                    name="sourceUrl"
                                    class="w-full pl-11 pr-4 py-3 rounded-xl bg-slate-50 dark:bg-[#162a2f]/50 border border-slate-200 dark:border-[#224249] text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all font-medium"
                                    placeholder="https://"
                                />
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="border-slate-100 dark:border-[#224249]/50" />

                <!-- Sección 3: Área visual (Imagen Header) -->
                <div class="space-y-4 bg-slate-50/50 dark:bg-[#162a2f]/10 p-6 rounded-2xl border border-slate-100 dark:border-[#224249]/50">
                    <h3 class="text-sm font-bold text-slate-700 dark:text-slate-200 flex items-center gap-2 mb-2">
                        <span class="material-symbols-outlined text-[20px] text-primary">broken_image</span>
                        Imagen Principal (Portada)
                    </h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
                        <!-- Opción URL -->
                        <div class="w-full space-y-2">
                            <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide">Vincular por URL externa</label>
                            <input
                                type="url"
                                id="imageUrl"
                                name="imageUrl"
                                class="w-full px-4 py-3 rounded-xl bg-white dark:bg-[#0b1618] border border-slate-200 dark:border-[#224249] text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all font-medium text-sm"
                                placeholder="Pega el enlace web de la imagen aquí..."
                            />
                        </div>

                        <!-- Opción Subir -->
                        <div class="w-full space-y-2 mt-2 md:mt-0">
                            <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide">O subir archivo local</label>
                            <div class="flex items-center justify-center w-full">
                                <label for="imageFile" class="flex flex-col items-center justify-center w-full h-[50px] border-2 border-slate-200 dark:border-[#224249] border-dashed rounded-xl cursor-pointer bg-slate-50 dark:bg-[#0b1618] dark:hover:bg-[#162a2f] hover:bg-slate-100 transition-colors group">
                                    <div class="flex items-center space-x-2">
                                        <span class="material-symbols-outlined text-slate-400 group-hover:text-primary transition-colors">cloud_upload</span>
                                        <span class="text-sm text-slate-500 dark:text-slate-400 font-medium group-hover:text-slate-600 dark:group-hover:text-slate-200 transition-colors">Examinar computadora...</span>
                                    </div>
                                    <input id="imageFile" type="file" accept="image/*" class="hidden" />
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="border-slate-100 dark:border-[#224249]/50" />

                <!-- Sección 4: Área del Editor Enriquecido -->
                <div class="space-y-4">
                    <label class="block text-sm font-bold text-slate-700 dark:text-slate-200 flex items-center gap-2">
                        <span class="material-symbols-outlined text-[20px] text-primary">edit_note</span>
                        Contenido del Artículo
                    </label>

                    <!-- TIPTAP EDITOR -->
                    <div class="w-full rounded-2xl bg-white dark:bg-[#0b1618] border border-slate-200 dark:border-[#224249] flex flex-col focus-within:ring-2 focus-within:ring-primary/50 focus-within:border-primary/50 transition-all overflow-hidden shadow-sm">
                        
                        <!-- Toolbar -->
                        <div class="flex flex-wrap items-center gap-1.5 p-3 bg-slate-50 dark:bg-[#162a2f]/50 border-b border-slate-200 dark:border-[#224249]">
                            <!-- Format Buttons -->
                            <button type="button" data-tiptap-btn="bold" class="p-2 w-10 h-10 rounded-xl flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-[#224249] transition-colors focus:outline-none" title="Negrita (Ctrl+B)">
                                <span class="font-serif font-black text-lg">N</span>
                            </button>
                            <button type="button" data-tiptap-btn="italic" class="p-2 w-10 h-10 rounded-xl flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-[#224249] transition-colors focus:outline-none italic" title="Itálica (Ctrl+I)">
                                <span class="font-serif font-black text-lg">I</span>
                            </button>
                            <button type="button" data-tiptap-btn="underline" class="p-2 w-10 h-10 rounded-xl flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-[#224249] transition-colors focus:outline-none underline line-through decoration-transparent" title="Subrayado (Ctrl+U)">
                                <span class="font-serif font-black text-lg">U</span>
                            </button>
                            
                            <div class="w-px h-6 bg-slate-300 dark:bg-[#224249] mx-2"></div>
                            
                            <!-- Heading Buttons -->
                            <button type="button" data-tiptap-btn="h1" class="p-2 w-10 h-10 rounded-xl flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-[#224249] transition-colors focus:outline-none font-bold" title="Título principal">
                                <span class="text-[15px]">H1</span>
                            </button>
                            <button type="button" data-tiptap-btn="h2" class="p-2 w-10 h-10 rounded-xl flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-[#224249] transition-colors focus:outline-none font-bold" title="Subtítulo">
                                <span class="text-sm">H2</span>
                            </button>
                            <button type="button" data-tiptap-btn="h3" class="p-2 w-10 h-10 rounded-xl flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-[#224249] transition-colors focus:outline-none font-bold" title="Sección">
                                <span class="text-[12px]">H3</span>
                            </button>
                        </div>

                        <!-- Escritura Area -->
                        <div id="tiptap-editor" class="p-6 prose prose-slate dark:prose-invert max-w-none text-slate-900 dark:text-slate-200 min-h-[400px] outline-none bg-transparent prose-headings:font-display prose-headings:font-bold prose-a:text-primary prose-strong:text-primary prose-a:no-underline hover:prose-a:underline"></div>
                        <input type="hidden" name="contentMarkdown" id="contentMarkdown">
                    </div>
                </div>

                <!-- Botones de Acción (Submit) -->
                <div class="flex flex-col-reverse sm:flex-row items-center justify-end gap-3 sm:gap-4 pt-8 mt-12 border-t border-slate-100 dark:border-[#224249]">
                    <a 
                        href="/admin" 
                        class="w-full sm:w-auto px-6 py-3.5 rounded-xl border border-slate-200 dark:border-[#224249] text-slate-600 dark:text-slate-300 font-bold hover:bg-slate-50 dark:hover:bg-[#162a2f] transition-all flex items-center justify-center gap-2"
                    >
                        <span class="material-symbols-outlined text-[18px]">close</span>
                        Cancelar
                    </a>
                    
                    <button 
                        type="button"
                        class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-primary text-[#0b1618] font-bold shadow-[0_4px_14px_0_rgba(212,175,55,0.39)] hover:shadow-[0_6px_20px_rgba(212,175,55,0.23)] hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2"
                    >
                        <span class="material-symbols-outlined text-[20px]">public</span>
                        Publicar artículo
                    </button>
                </div>
            </form>
        </div>
    </main>
</Layout>

<style is:global>
    /* Estilos base de TipTap para quitar bordes e indicar el min height default */
    .ProseMirror {
        outline: none;
        min-height: 400px;
        caret-color: #D4AF37; /* Color primario o dorado */
    }
    
    /* Placeholder behavior cuando esta vacío */
    .ProseMirror p.is-editor-empty:first-child::before {
        content: attr(data-placeholder);
        float: left;
        color: #94a3b8; /* slate-400 */
        pointer-events: none;
        height: 0;
    }

    /* Estado visual de los botones del Toolbar de TipTap cuando estan activos */
    .tiptap-btn-active {
        background-color: #e2e8f0 !important; /* slate-200 */
        color: #0f172a !important; /* slate-900 */
        box-shadow: inset 0 2px 4px 0 rgb(0 0 0 / 0.05);
    }
    .dark .tiptap-btn-active {
        background-color: #0b1618 !important; 
        color: #D4AF37 !important; /* text-primary */
        border-color: #224249;
    }
    
    /* Regla absoluta para que todo el texto en negritas dentro del área de edición sea del color primario (dorado) */
    .ProseMirror strong, .ProseMirror b {
        color: #D4AF37 !important;
    }
</style>

<script>
    import { Editor } from '@tiptap/core';
    import StarterKit from '@tiptap/starter-kit';
    import Underline from '@tiptap/extension-underline';
    import { Markdown } from 'tiptap-markdown';

    // Para evitar ejecución prematura en Astro e hidratar correctamente el script del lado del cliente
    document.addEventListener("DOMContentLoaded", () => {
        const editorElement = document.getElementById('tiptap-editor');
        const inputContent = document.getElementById('contentMarkdown') as HTMLInputElement;
        const form = document.getElementById('nuevo-post-form');

        if (editorElement) {
            // Referencias inmediatas a los botones
            const btns = {
                bold: document.querySelector('[data-tiptap-btn="bold"]'),
                italic: document.querySelector('[data-tiptap-btn="italic"]'),
                underline: document.querySelector('[data-tiptap-btn="underline"]'),
                h1: document.querySelector('[data-tiptap-btn="h1"]'),
                h2: document.querySelector('[data-tiptap-btn="h2"]'),
                h3: document.querySelector('[data-tiptap-btn="h3"]'),
            };

            const editor = new Editor({
                element: editorElement,
                extensions: [
                    StarterKit,
                    Underline,
                    Markdown
                ],
                content: '<p></p>',
                editorProps: {
                    attributes: {
                        class: 'focus:outline-none',
                        'data-placeholder': 'Comienza a escribir la publicación aquí...'
                    },
                },
                onUpdate: ({ editor }) => {
                    // TipTap Markdown extrae el texto puro MD que usaremos después en colecciones
                    inputContent.value = editor.storage.markdown.getMarkdown();
                    updateActiveButtons(editor);
                },
                onSelectionUpdate: ({ editor }) => {
                    updateActiveButtons(editor);
                }
            });

            // Registrar listeners para los botones de texto
            btns.bold?.addEventListener('click', () => { editor.chain().focus().toggleBold().run() });
            btns.italic?.addEventListener('click', () => { editor.chain().focus().toggleItalic().run() });
            btns.underline?.addEventListener('click', () => { editor.chain().focus().toggleUnderline().run() });
            btns.h1?.addEventListener('click', () => { editor.chain().focus().toggleHeading({ level: 1 }).run() });
            btns.h2?.addEventListener('click', () => { editor.chain().focus().toggleHeading({ level: 2 }).run() });
            btns.h3?.addEventListener('click', () => { editor.chain().focus().toggleHeading({ level: 3 }).run() });

            // Detecta y sombrea como actio el formato detectado por Cursor
            function updateActiveButtons(ed: any) {
                setBtnState(btns.bold, ed.isActive('bold'));
                setBtnState(btns.italic, ed.isActive('italic'));
                setBtnState(btns.underline, ed.isActive('underline'));
                setBtnState(btns.h1, ed.isActive('heading', { level: 1 }));
                setBtnState(btns.h2, ed.isActive('heading', { level: 2 }));
                setBtnState(btns.h3, ed.isActive('heading', { level: 3 }));
            }

            function setBtnState(btn: Element | null | undefined, isActive: boolean) {
                if (!btn) return;
                if (isActive) btn.classList.add('tiptap-btn-active');
                else btn.classList.remove('tiptap-btn-active');
            }

            // Manejar validación y submit temporal (enviar alerta a la plataforma)
            form?.addEventListener('submit', (e) => {
                e.preventDefault();
                const content = inputContent.value;
                if (!content || content.trim() === '') {
                    alert('El contenido del artículo está vacío. Por favor escribe algo.');
                    return;
                }
                
                console.log('--- OUTPUT DE TIPTAP CONVERTIDO A MARKDOWN ---');
                console.log(content);
                alert('¡El texto ha sido convertido a Markdown exitosamente! Revisar registro de la consola base para ver el output.');
            });
        }
    });
</script>
