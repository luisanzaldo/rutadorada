                                        type="submit"
                                        id="calendar-chat-send"
                                        class="bg-primary text-[#0b1618] px-5 py-3 rounded-xl font-bold text-sm hover:brightness-110 transition-all shadow-[0_0_15px_rgba(242,175,13,0.3)] disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 self-stretch"
                                    >
                                        <span id="calendar-chat-send-label">Enviar</span>
                                    </button>
                                </form>
