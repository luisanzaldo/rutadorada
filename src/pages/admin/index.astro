---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { getSession } from "../../lib/auth";
import { USERS } from "../../lib/users";

export const prerender = false;

// 1. Verificar la sesión usando getSession de src/lib/auth.ts
const session = await getSession(Astro.request);

// Si no hay sesión válida, redirigir automáticamente a /admin/login
if (!session) {
    return Astro.redirect("/admin/login");
}

// 2. Obtener los datos del usuario logueado
const user = USERS.find((u) => u.username === session.username);

// 3. Manejar el cierre de sesión mediante un POST
if (Astro.request.method === "POST") {
    try {
        const formData = await Astro.request.formData();
        if (formData.get("action") === "logout") {
            // Eliminar la cookie de sesión
            Astro.cookies.delete("session", { path: "/" });
            return Astro.redirect("/admin/login");
        }
    } catch (e) {
        // Manejar errores silenciosamente por ahora
    }
}

const title = "Panel de Administración | RutaDorada";
---

<Layout title={title}>
    <Header />
    <main class="flex-grow py-12 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto w-full">
        <!-- Background Elements para coherencia visual -->
        <div class="absolute inset-0 pointer-events-none overflow-hidden -z-10">
            <div class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-primary/10 rounded-full blur-[120px] mix-blend-screen opacity-20"></div>
            <div class="absolute bottom-[-10%] left-[-5%] w-[500px] h-[500px] bg-blue-500/5 rounded-full blur-[120px] mix-blend-screen opacity-20"></div>
        </div>

        <div class="bg-white/80 dark:bg-[#0b1618] border border-slate-200 dark:border-[#224249] rounded-2xl p-8 shadow-2xl backdrop-blur-sm relative z-10">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8 border-b border-slate-100 dark:border-[#224249] pb-8">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-primary/20 flex items-center justify-center text-primary border border-primary/20">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                    </div>
                    <div>
                        <h1 class="font-display font-bold text-2xl text-slate-900 dark:text-white">
                            Panel Maestros
                        </h1>
                        <p class="text-slate-500 text-sm">
                            Hola, <span class="text-primary font-bold">{user?.displayName}</span>. Bienvenido al centro de control.
                        </p>
                    </div>
                </div>

                <form method="POST">
                    <input type="hidden" name="action" value="logout" />
                    <button 
                        type="submit"
                        class="px-5 py-2.5 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-500 text-xs font-bold uppercase tracking-widest border border-red-500/20 transition-all flex items-center gap-2 group"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                        </svg>
                        Cerrar sesión
                    </button>
                </form>
            </div>

            <!-- Espacio para futura funcionalidad -->
            <div class="py-20 text-center">
                <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-slate-50 dark:bg-[#162a2f] mb-6 border border-slate-100 dark:border-[#224249]">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-slate-300 dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                </div>
                <h2 class="text-slate-400 dark:text-slate-500 font-medium text-lg">Sesión iniciada correctamente</h2>
                <p class="text-slate-500 dark:text-slate-600 text-sm mt-2">Próximamente podrás gestionar el contenido desde aquí.</p>
            </div>
        </div>
    </main>
</Layout>
