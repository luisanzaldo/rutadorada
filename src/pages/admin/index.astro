    {activeSection === "cannes" && (
        <script is:inline>
            (function () {
                const refreshBtn = document.getElementById('cannes-refresh-btn');
                const refreshLabel = document.getElementById('cannes-refresh-label');
                const downloadBtn = document.getElementById('cannes-download-btn');
                const downloadLabel = document.getElementById('cannes-download-label');
                const feedback = document.getElementById('cannes-feedback');
                const updatedAtEl = document.getElementById('cannes-updated-at');
                const theadRow = document.getElementById('cannes-thead-row');
                const tbody = document.getElementById('cannes-tbody');
                const dataNode = document.getElementById('cannes-snapshot-data');
                const posterTable = document.getElementById('cannes-poster-table');
                const posterFooter = document.getElementById('cannes-poster-footer');

                if (!refreshBtn || !downloadBtn || !feedback || !dataNode || !posterTable) return;

                let snapshot;
                try {
                    snapshot = JSON.parse(dataNode.textContent || '{"headers":[],"rows":[],"updatedAt":""}');
                } catch (e) {
                    snapshot = { headers: [], rows: [], updatedAt: '' };
                }

                function escapeHtml(s) {
                    return String(s)
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;')
                        .replace(/'/g, '&#39;');
                }

                function formatUpdated(iso) {
                    if (!iso) return 'Sin datos aún';
                    try {
                        return new Date(iso).toLocaleString('es-ES', {
                            year: 'numeric', month: 'long', day: 'numeric',
                            hour: '2-digit', minute: '2-digit',
                        });
                    } catch (e) {
                        return iso;
                    }
                }

                function cellToHtml(cell) {
                    if (!cell || !cell.runs || cell.runs.length === 0) return '—';
                    const hasContent = cell.runs.some((r) => (r.text || '').trim() !== '');
                    if (!hasContent) return '—';
                    return cell.runs.map((r) => {
                        const t = escapeHtml(r.text || '');
                        return r.bold ? '<strong>' + t + '</strong>' : t;
                    }).join('');
                }

                function renderVisibleTable() {
                    if (!theadRow || !tbody) return;
                    if (snapshot.headers.length === 0) {
                        theadRow.innerHTML = '<th class="text-left py-3 px-4 font-bold">Sin datos. Haz clic en "Actualización de calificaciones".</th>';
                        tbody.innerHTML = '';
                        return;
                    }
                    theadRow.innerHTML = snapshot.headers.map((h, i) => {
                        const headerCls = i === 0
                            ? 'text-left'
                            : i === 1
                                ? 'text-center text-primary bg-primary/5'
                                : 'text-center';
                        return '<th class="py-3 px-4 font-bold ' + headerCls + '">' + escapeHtml(h) + '</th>';
                    }).join('');
                    tbody.innerHTML = snapshot.rows.map((row) =>
                        '<tr class="border-t border-slate-100 dark:border-[#224249]/50 hover:bg-primary/5 transition-colors">' +
                        row.map((cell, i) => {
                            const cls = i === 0
                                ? 'text-slate-900 dark:text-white'
                                : i === 1
                                    ? 'text-center text-primary font-bold bg-primary/5 tabular-nums'
                                    : 'text-center text-slate-700 dark:text-slate-300 tabular-nums';
                            return '<td class="py-3 px-4 ' + cls + '">' + cellToHtml(cell) + '</td>';
                        }).join('') +
                        '</tr>'
                    ).join('');
                }

                function renderPoster() {
                    if (snapshot.headers.length === 0) {
                        posterTable.innerHTML = '';
                        if (posterFooter) posterFooter.textContent = '';
                        return;
                    }
                    // Anchos: la primera columna (Película) más ancha; las restantes uniformes.
                    const colCount = snapshot.headers.length;
                    const ratingsCount = Math.max(1, colCount - 1);
                    const firstColPct = 40;
                    const otherColPct = (100 - firstColPct) / ratingsCount;
                    const colgroup = '<colgroup>' +
                        snapshot.headers.map((_, i) =>
                            '<col style="width:' + (i === 0 ? firstColPct : otherColPct) + '%;">'
                        ).join('') +
                        '</colgroup>';

                    // Renderiza el header con label y escala (/5, /100) en líneas separadas
                    function renderPosterHeader(h) {
                        const text = (h || '').toString();
                        const m = text.match(/^(.+?)\s+(\/\S+)\s*$/);
                        if (m) {
                            return '<span style="display:block;line-height:1.15;">' + escapeHtml(m[1]) + '</span>' +
                                   '<span style="display:block;font-size:10px;letter-spacing:0.1em;opacity:0.7;line-height:1.2;margin-top:4px;">' + escapeHtml(m[2]) + '</span>';
                        }
                        return '<span style="display:block;line-height:1.15;">' + escapeHtml(text) + '</span>';
                    }

                    // Renderiza una celda preservando los runs en negrita (blanco, peso más grueso)
                    function cellToInlineHtml(cell) {
                        if (!cell || !cell.runs || cell.runs.length === 0) return '—';
                        const hasContent = cell.runs.some((r) => (r.text || '').trim() !== '');
                        if (!hasContent) return '—';
                        return cell.runs.map((r) => {
                            const t = escapeHtml(r.text || '');
                            return r.bold ? '<span style="font-weight:800;">' + t + '</span>' : t;
                        }).join('');
                    }

                    const thead =
                        '<thead><tr style="border-bottom:2px solid #F2AF0D;background:#0c0a09;">' +
                        snapshot.headers.map((h, i) => {
                            const align = i === 0 ? 'left' : 'center';
                            const isPromedio = i === 1;
                            const headerBg = isPromedio ? 'background:rgba(242,175,13,0.08);' : '';
                            return '<th style="text-align:' + align + ';padding:10px 6px;font-family:\'Cinzel\',serif;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#F2AF0D;font-weight:700;vertical-align:bottom;' + headerBg + '">' +
                                renderPosterHeader(h) + '</th>';
                        }).join('') +
                        '</tr></thead>';

                    const tbodyHtml =
                        '<tbody>' +
                        snapshot.rows.map((row, idx) => {
                            const bg = idx % 2 === 0 ? '#1c1917' : '#11100f';
                            return '<tr style="background:' + bg + ';">' +
                                row.map((cell, i) => {
                                    const align = i === 0 ? 'left' : 'center';
                                    const isTitle = i === 0;
                                    const isPromedio = i === 1;
                                    const hasContent = cell && cell.runs && cell.runs.some((r) => (r.text || '').trim() !== '');
                                    const color = isTitle
                                        ? '#ffffff'
                                        : isPromedio
                                            ? '#F2AF0D'
                                            : (hasContent ? '#fafaf9' : '#78716c');
                                    const weight = isTitle ? '500' : (isPromedio ? '800' : '600');
                                    const fontSize = isTitle ? '16px' : '17px';
                                    const cellBg = isPromedio ? 'background:rgba(242,175,13,0.05);' : '';
                                    return '<td style="text-align:' + align + ';padding:6px 8px;color:' + color + ';font-weight:' + weight + ';font-family:\'Plus Jakarta Sans\',system-ui,sans-serif;font-style:normal;font-size:' + fontSize + ';border-bottom:1px solid #292524;line-height:1.25;vertical-align:middle;' + cellBg + '">' +
                                        cellToInlineHtml(cell) + '</td>';
                                }).join('') +
                                '</tr>';
                        }).join('') +
                        '</tbody>';
                    posterTable.innerHTML = colgroup + thead + tbodyHtml;
                    if (posterFooter) {
                        const date = snapshot.updatedAt
                            ? new Date(snapshot.updatedAt).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })
                            : '';
                        posterFooter.textContent = date ? 'Actualizado · ' + date : '';
                    }
                }

                function showFeedback(message, kind) {
                    feedback.textContent = message;
                    feedback.classList.remove('hidden', 'bg-red-500/10', 'border-red-500/30', 'text-red-500', 'bg-emerald-500/10', 'border-emerald-500/30', 'text-emerald-600', 'dark:text-emerald-400');
                    if (kind === 'error') {
                        feedback.classList.add('bg-red-500/10', 'border-red-500/30', 'text-red-500');
                    } else {
                        feedback.classList.add('bg-emerald-500/10', 'border-emerald-500/30', 'text-emerald-600', 'dark:text-emerald-400');
                    }
                }

                function setRefreshBusy(busy) {
                    refreshBtn.disabled = busy;
                    if (refreshLabel) refreshLabel.textContent = busy ? 'Actualizando…' : 'Actualización de calificaciones';
                }

                function setDownloadBusy(busy) {
                    downloadBtn.disabled = busy;
                    if (downloadLabel) downloadLabel.textContent = busy ? 'Generando PNG…' : 'Descarga la imagen actualizada';
                }

                refreshBtn.addEventListener('click', async () => {
                    setRefreshBusy(true);
                    feedback.classList.add('hidden');
                    try {
                        const res = await fetch('/api/admin/cannes/refresh', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                        });
                        const data = await res.json().catch(() => ({}));
                        if (!res.ok || !data.ok) {
                            showFeedback(data.error || 'No se pudo actualizar.', 'error');
                            return;
                        }
                        snapshot = data.snapshot;
                        if (updatedAtEl) updatedAtEl.textContent = formatUpdated(snapshot.updatedAt);
                        renderVisibleTable();
                        renderPoster();
                        showFeedback('Calificaciones actualizadas correctamente.', 'success');
                    } catch (err) {
                        showFeedback('No pude conectar con el servidor.', 'error');
                    } finally {
                        setRefreshBusy(false);
                    }
                });

                downloadBtn.addEventListener('click', async () => {
                    if (snapshot.headers.length === 0) {
                        showFeedback('Primero actualiza las calificaciones.', 'error');
                        return;
                    }
                    setDownloadBusy(true);
                    feedback.classList.add('hidden');
                    try {
                        renderPoster();
                        const poster = document.getElementById('cannes-poster');
                        if (!poster) throw new Error('Poster no encontrado.');

                        // Esperar a que las fuentes estén disponibles antes de capturar
                        if (document.fonts && document.fonts.ready) {
                            try { await document.fonts.ready; } catch (e) {}
                        }
                        // Dejar dos frames para que el browser layout el poster recién poblado
                        await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));

                        const mod = await import('https://esm.sh/html-to-image@1.11.13');
                        const dataUrl = await mod.toPng(poster, {
                            pixelRatio: 2,
                            backgroundColor: '#0c0a09',
                            cacheBust: true,
                            // Aplica al clon usado para la captura — el original sigue invisible
                            style: { opacity: '1', zIndex: '0', position: 'static', pointerEvents: 'auto' },
                        });

                        if (!dataUrl || dataUrl.length < 5000) {
                            throw new Error('PNG vacío. Reintenta en un momento.');
                        }

                        const today = new Date().toISOString().slice(0, 10);
                        const a = document.createElement('a');
                        a.href = dataUrl;
                        a.download = 'calificaciones-cannes-2026-' + today + '.png';
                        document.body.appendChild(a);
                        a.click();
                        a.remove();
                        showFeedback('Imagen descargada.', 'success');
                    } catch (err) {
                        showFeedback('No se pudo generar el PNG: ' + (err && err.message ? err.message : 'error desconocido'), 'error');
                    } finally {
                        setDownloadBusy(false);
                    }
                });

                renderPoster();
            })();
        </script>
    )}
</Layout>
