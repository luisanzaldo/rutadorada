---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import AdminDesktopOnly from "../../components/AdminDesktopOnly.astro";
import { getSession } from "../../lib/auth";
import { USERS } from "../../lib/users";
import { supabaseAdmin } from "../../lib/supabaseAdmin";
import { getSnapshot, type Cell } from "../../lib/cannes";
import { renderRichText, stripRichText } from "../../lib/richText";

export const prerender = false;

// 1. Verificar la sesión usando getSession de src/lib/auth.ts
const session = await getSession(Astro.request);

// Si no hay sesión válida, redirigir automáticamente a /admin/login
if (!session) {
    return Astro.redirect("/admin/login");
}

// 2. Obtener los datos del usuario logueado
const user = USERS.find((u) => u.username === session.username);

// 3. Determinar la sección activa
const validSections = ["publicaciones", "calendario", "dashboard", "cannes"] as const;
type Section = (typeof validSections)[number];
const sectionParam = Astro.url.searchParams.get("section") as Section | null;
const activeSection: Section = sectionParam && validSections.includes(sectionParam) ? sectionParam : "publicaciones";

// 4. Obtener todas las publicaciones (solo necesarias para "publicaciones")
const allPosts = await getCollection("posts");
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Búsqueda por título
const searchParams = Astro.url.searchParams;
const rawSearch = searchParams.get('search') ?? '';
const searchQuery = rawSearch.trim();
const filteredPosts = searchQuery
    ? sortedPosts.filter((post) => stripRichText(post.data.title).toLowerCase().includes(searchQuery.toLowerCase()))
    : sortedPosts;

// Paginación (solo aplica a la sección de publicaciones)
const pageParam = searchParams.get('page');
const currentPage = pageParam ? parseInt(pageParam, 10) : 1;
const postsPerPage = 9;

const totalPosts = filteredPosts.length;
const totalPages = Math.max(1, Math.ceil(totalPosts / postsPerPage));
const validCurrentPage = Math.max(1, Math.min(currentPage, totalPages));

const startIndex = (validCurrentPage - 1) * postsPerPage;
const endIndex = startIndex + postsPerPage;
const paginatedPosts = filteredPosts.slice(startIndex, endIndex);

const buildPageHref = (page: number) => {
    const params = new URLSearchParams();
    params.set('section', 'publicaciones');
    if (searchQuery) params.set('search', searchQuery);
    params.set('page', String(page));
    return `/admin?${params.toString()}`;
};
const formatDate = (date: Date) => {
    return date.toLocaleDateString("es-ES", {
        year: "numeric",
        month: "short",
        day: "numeric",
    });
};

// 5. Datos del Dashboard (solo se cargan si la sección activa es "dashboard")
type UserSummary = { total_registrados: number; email_confirmado: number; nuevos_7d: number; nuevos_30d: number };
type ActividadRow = { dia: string; likes: number; comentarios: number; favoritos: number };
type PostRow = { slug: string; likes: number; comentarios: number; favoritos: number; engagement_total: number };

let userSummary: UserSummary = { total_registrados: 0, email_confirmado: 0, nuevos_7d: 0, nuevos_30d: 0 };
let actividad7d: ActividadRow[] = [];
let postsSummary: PostRow[] = [];
let dashboardError: string | null = null;
const slugToTitle: Record<string, string> = {};

if (activeSection === "dashboard") {
    if (!supabaseAdmin) {
        dashboardError = "Supabase admin no está configurado. Revisa SUPABASE_SERVICE_ROLE_KEY.";
    } else {
        const [usersRes, activityRes, postsRes] = await Promise.all([
            supabaseAdmin.rpc("dashboard_user_summary"),
            supabaseAdmin.rpc("dashboard_actividad_7d"),
            supabaseAdmin.rpc("dashboard_posts_summary"),
        ]);

        if (usersRes.error) dashboardError = `Error usuarios: ${usersRes.error.message}`;
        else if (activityRes.error) dashboardError = `Error actividad: ${activityRes.error.message}`;
        else if (postsRes.error) dashboardError = `Error posts: ${postsRes.error.message}`;
        else {
            const u = (usersRes.data as UserSummary[] | null)?.[0];
            if (u) userSummary = u;
            actividad7d = (activityRes.data as ActividadRow[] | null) ?? [];
            postsSummary = (postsRes.data as PostRow[] | null) ?? [];
        }

        // Mapa slug → título para mostrar nombres legibles en lugar de slugs
        for (const p of allPosts) slugToTitle[p.id] = stripRichText(p.data.title);
    }
}

// Helpers de rankings (derivados de postsSummary, top 5 cada uno)
const topLikes = [...postsSummary].sort((a, b) => b.likes - a.likes).filter(p => p.likes > 0).slice(0, 5);
const topComentarios = [...postsSummary].sort((a, b) => b.comentarios - a.comentarios).filter(p => p.comentarios > 0).slice(0, 5);
const topFavoritos = [...postsSummary].sort((a, b) => b.favoritos - a.favoritos).filter(p => p.favoritos > 0).slice(0, 5);
const topEngagement = postsSummary.slice(0, 10);

const formatDayShort = (iso: string) => {
    const d = new Date(iso + "T00:00:00");
    return d.toLocaleDateString("es-ES", { weekday: "short", day: "numeric" });
};

// Convierte un slug ("la-doncella" o "2026-04-12-trailer-godzilla") en un título legible ("La Doncella", "Trailer Godzilla").
// Solo se usa como fallback cuando el slug no existe en la colección de posts (post borrado, slug huérfano, etc.).
const slugToPrettyTitle = (slug: string): string => {
    const withoutDate = slug.replace(/^\d{4}-\d{2}-\d{2}-/, "");
    return withoutDate
        .split("-")
        .filter(Boolean)
        .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
        .join(" ");
};

const displayTitle = (slug: string): string => slugToTitle[slug] ?? slugToPrettyTitle(slug);

// 6. Configuración del menú lateral
type NavItem = {
    id: string;
    label: string;
    emoji: string;
    iconType: "emoji" | "gdrive" | "envato" | "buffer" | "analytics" | "clarity";
    href?: string;
    external?: boolean;
};

const navItems: NavItem[] = [
    { id: "publicaciones", label: "Publicaciones", emoji: "✏️", iconType: "emoji" },
    { id: "calendario", label: "Calendario", emoji: "📅", iconType: "emoji" },
    { id: "dashboard", label: "Dashboard", emoji: "📊", iconType: "emoji" },
    { id: "cannes", label: "Calificaciones Cannes 2026", emoji: "🎬", iconType: "emoji" },
    { id: "guiones", label: "Guiones", emoji: "", iconType: "gdrive", href: "https://drive.google.com/drive/folders/1-WMR3OBw_2-fe4Z5bJFLPl4OZGQIZPAn?usp=sharing", external: true },
    { id: "videos", label: "Videos", emoji: "", iconType: "gdrive", href: "https://drive.google.com/drive/folders/19Hvo2G3GfmbjNBh4BS00IzH1vCaIw9A_?usp=sharing", external: true },
    { id: "recursos", label: "Recursos", emoji: "", iconType: "envato", href: "https://app.envato.com/", external: true },
    { id: "posts-redes", label: "Posts de redes", emoji: "", iconType: "buffer", href: "https://publish.buffer.com/schedule", external: true },
    { id: "analytics", label: "Google Analytics", emoji: "", iconType: "analytics", href: "https://analytics.google.com/analytics/web/#/a393754490p536372172/reports/reportinghub?params=_u..nav%3Dmaui%26_u.dateOption%3Dtoday%26_u.comparisonOption%3Ddisabled", external: true },
    { id: "clarity", label: "Clarity", emoji: "", iconType: "clarity", href: "https://clarity.microsoft.com/projects/view/wmk7qoz72z/dashboard?date=Last%203%20days", external: true },
];

const sectionTitles: Record<Section, string> = {
    publicaciones: "Publicaciones",
    calendario: "Calendario de actividades",
    dashboard: "Dashboard",
    cannes: "Calificaciones Cannes 2026",
};

// Snapshot inicial para la sección de Cannes
const cannesSnapshot = activeSection === "cannes" ? await getSnapshot() : { headers: [] as string[], rows: [] as Cell[][], updatedAt: "" };

const escapeHtml = (s: string): string => s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");

// Renderiza una celda preservando las negritas del Google Sheet
const cellToHtml = (cell: Cell): string => {
    if (!cell?.runs?.length) return "—";
    if (cell.runs.every((r) => (r.text ?? "").trim() === "")) return "—";
    return cell.runs.map((r) => {
        const t = escapeHtml(r.text ?? "");
        return r.bold ? `<strong>${t}</strong>` : t;
    }).join("");
};

const formatUpdated = (iso: string): string => {
    if (!iso) return "Sin datos aún";
    try {
        return new Date(iso).toLocaleString("es-ES", {
            year: "numeric",
            month: "long",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit",
        });
    } catch {
        return iso;
    }
};

const title = `${sectionTitles[activeSection]} | Panel de RutaDorada`;
---

<Layout title={title}>
    <Header />
    <AdminDesktopOnly />
    <main class="hidden lg:block flex-grow py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
        <!-- Background Elements para coherencia visual -->
        <div class="absolute inset-0 pointer-events-none overflow-hidden -z-10">
            <div class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-primary/10 rounded-full blur-[120px] mix-blend-screen opacity-20"></div>
            <div class="absolute bottom-[-10%] left-[-5%] w-[500px] h-[500px] bg-blue-500/5 rounded-full blur-[120px] mix-blend-screen opacity-20"></div>
        </div>

        <div class="bg-white/80 dark:bg-background-dark border border-slate-200 dark:border-[#224249] rounded-2xl p-6 sm:p-8 shadow-2xl backdrop-blur-sm relative z-10">
            <!-- Cabecera -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8 border-b border-slate-100 dark:border-[#224249] pb-8">
                <div class="flex items-center gap-4">
                    <div>
                        <h1 class="font-display font-bold text-2xl text-slate-900 dark:text-white">
                            Panel de Ruta<span class="text-primary">Dorada</span> Films
                        </h1>
                        <p class="text-slate-500 text-sm">
                            Hola, <span class="text-primary font-bold">{user?.displayName}</span>. Bienvenido al centro de control.
                        </p>
                    </div>
                </div>

                <button
                    id="logout-button"
                    title="Cerrar sesión"
                    aria-label="Cerrar sesión"
                    class="text-white hover:text-red-500 transition-colors self-start md:self-auto disabled:opacity-50 disabled:cursor-not-allowed"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                </button>
            </div>

            <!-- Layout de 2 columnas: sidebar + contenido -->
            <div class="flex flex-col lg:flex-row gap-8">
                <!-- COLUMNA IZQUIERDA: Navegación -->
                <aside class="lg:w-64 flex-shrink-0">
                    <nav class="flex lg:flex-col gap-2 overflow-x-auto lg:overflow-visible pb-2 lg:pb-0 -mx-1 px-1">
                        {navItems.map((item) => {
                            const isActive = !item.external && item.id === activeSection;
                            const baseClass = "flex items-center gap-3 px-4 py-3 rounded-xl border text-sm font-bold transition-all whitespace-nowrap lg:whitespace-normal flex-shrink-0";
                            const activeClass = "bg-primary/10 border-primary/40 text-primary shadow-[0_0_15px_rgba(242,175,13,0.15)]";
                            const inactiveClass = "bg-white/5 dark:bg-card-dark/60 border-slate-200 dark:border-[#224249]/60 text-slate-700 dark:text-slate-300 hover:border-primary/40 hover:text-primary";
                            const linkHref = item.external && item.href ? item.href : `/admin?section=${item.id}`;
                            const linkTarget = item.external ? "_blank" : undefined;
                            const linkRel = item.external ? "noopener noreferrer" : undefined;
                            return (
                                <a href={linkHref} target={linkTarget} rel={linkRel} class={`${baseClass} ${isActive ? activeClass : inactiveClass}`}>
                                    <span class="flex items-center justify-center w-6 h-6 flex-shrink-0">
                                        {item.iconType === "emoji" && (
                                            <span class="text-xl leading-none">{item.emoji}</span>
                                        )}
                                        {item.iconType === "gdrive" && (
                                            <svg viewBox="0 0 87.3 78" class="w-5 h-5" xmlns="http://www.w3.org/2000/svg">
                                                <path d="m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8h-27.5c0 1.55.4 3.1 1.2 4.5z" fill="#0066da"/>
                                                <path d="m43.65 25-13.75-23.8c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44a9.06 9.06 0 0 0 -1.2 4.5h27.5z" fill="#00ac47"/>
                                                <path d="m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.502l5.852 11.5z" fill="#ea4335"/>
                                                <path d="m43.65 25 13.75-23.8c-1.35-.8-2.9-1.2-4.5-1.2h-18.5c-1.6 0-3.15.45-4.5 1.2z" fill="#00832d"/>
                                                <path d="m59.8 53h-32.3l-13.75 23.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.45 4.5-1.2z" fill="#2684fc"/>
                                                <path d="m73.4 26.5-12.7-22c-.8-1.4-1.95-2.5-3.3-3.3l-13.75 23.8 16.15 28h27.45c0-1.55-.4-3.1-1.2-4.5z" fill="#ffba00"/>
                                            </svg>
                                        )}
                                        {item.iconType === "envato" && (
                                            <svg viewBox="0 0 24 24" class="w-5 h-5" xmlns="http://www.w3.org/2000/svg">
                                                <path fill="#82B541" d="M20.7 2.3c-.3-.3-.7-.4-1-.2-3.5 1.6-6 4-7.3 7-1.4-2-1.5-4-.2-6.5.2-.3.1-.7-.1-1-.3-.2-.7-.2-1 0C7.5 4 6 6.4 6 9.4c0 1.4.3 2.7.9 3.9-1.4 1.6-2.2 3.6-2.4 5.7 0 .4.3.7.7.8h.1c.4 0 .7-.3.8-.7.2-1.5.7-2.9 1.6-4.1 1.4 1.9 3.6 3.1 6.1 3.1 4.7 0 8.5-3.8 8.5-8.5 0-2.4-.5-4.6-1.6-6.5-.2-.3-.4-.6-.6-.8.2 0 .4-.1.5-.2.2-.2.2-.5.1-.8z"/>
                                            </svg>
                                        )}
                                        {item.iconType === "buffer" && (
                                            <svg viewBox="0 0 24 24" class="w-5 h-5" xmlns="http://www.w3.org/2000/svg">
                                                <path fill="#2C4BFF" d="M23.997 7.469L12.012 1.594.003 7.47l11.998 5.876 11.996-5.876zm0 9.063l-2.866-1.405-9.122 4.469-9.139-4.476L0 16.522l12.012 5.884 11.985-5.876v-.001zm0-4.532l-2.866-1.405-9.122 4.469L2.87 10.59 0 11.989l12.012 5.884 11.985-5.876V12z"/>
                                            </svg>
                                        )}
                                        {item.iconType === "analytics" && (
                                            <svg viewBox="0 0 64 64" class="w-5 h-5" xmlns="http://www.w3.org/2000/svg">
                                                <path fill="#F9AB00" d="M43 9v44a8 8 0 0 0 16 0V9.45C59 5 55.41 1 51 1s-8 3.85-8 8z"/>
                                                <path fill="#E37400" d="M24 32v21a8 8 0 1 0 16 0V32a8 8 0 1 0-16 0zM5 55a8 8 0 1 0 16 0 8 8 0 0 0-16 0z"/>
                                            </svg>
                                        )}
                                        {item.iconType === "clarity" && (
                                            <svg viewBox="0 0 24 24" class="w-5 h-5" xmlns="http://www.w3.org/2000/svg">
                                                <circle cx="12" cy="12" r="10" fill="#2A9DD8"/>
                                                <circle cx="12" cy="12" r="4" fill="#fff"/>
                                                <circle cx="12" cy="12" r="1.6" fill="#2A9DD8"/>
                                            </svg>
                                        )}
                                    </span>
                                    <span>{item.label}</span>
                                </a>
                            );
                        })}
                    </nav>
                </aside>

                <!-- COLUMNA DERECHA: Contenido dinámico -->
                <div class="flex-1 min-w-0">
                    {activeSection === "publicaciones" && (
                        <div>
                            <div class="flex items-center justify-between flex-wrap gap-4 mb-6">
                                <h2 class="font-display font-bold text-xl text-slate-900 dark:text-white flex items-center gap-2">
                                    <span class="text-2xl">✏️</span> Publicaciones
                                </h2>
                                <div class="flex items-center gap-3 flex-wrap">
                                    <form action="/admin" method="get" class="flex items-stretch rounded-xl border border-slate-200 dark:border-[#224249] bg-white/5 dark:bg-card-dark/60 focus-within:border-primary/60 focus-within:shadow-[0_0_0_3px_rgba(242,175,13,0.15)] transition-all overflow-hidden">
                                        <input type="hidden" name="section" value="publicaciones" />
                                        <input
                                            type="text"
                                            name="search"
                                            value={searchQuery}
                                            placeholder="Buscar por título..."
                                            aria-label="Buscar posts por título"
                                            class="bg-transparent px-4 py-2.5 text-sm text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none w-44 sm:w-56"
                                        />
                                        <button
                                            type="submit"
                                            aria-label="Buscar"
                                            class="px-3 text-slate-500 dark:text-slate-300 hover:text-primary hover:bg-primary/10 transition-colors flex items-center justify-center"
                                        >
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
                                            </svg>
                                        </button>
                                    </form>
                                    <a href="/admin/nuevo-post" class="bg-primary text-[#0b1618] px-6 py-2.5 flex items-center gap-2 rounded-xl font-bold text-sm hover:brightness-110 transition-all shadow-[0_0_15px_rgba(242,175,13,0.3)]">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                        </svg>
                                        Nuevo post
                                    </a>
                                </div>
                            </div>

                            {searchQuery && (
                                <div class="flex items-center justify-between flex-wrap gap-3 mb-8 px-4 py-3 rounded-xl bg-primary/5 border border-primary/20">
                                    <p class="text-sm text-slate-700 dark:text-slate-300">
                                        {totalPosts === 0 ? (
                                            <>Sin resultados para <strong class="text-slate-900 dark:text-white">"{searchQuery}"</strong></>
                                        ) : (
                                            <>{totalPosts} {totalPosts === 1 ? "resultado" : "resultados"} para <strong class="text-slate-900 dark:text-white">"{searchQuery}"</strong></>
                                        )}
                                    </p>
                                    <a href="/admin?section=publicaciones" class="text-xs font-bold uppercase tracking-widest text-primary hover:brightness-110 transition-all flex items-center gap-1.5">
                                        Limpiar
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                        </svg>
                                    </a>
                                </div>
                            )}

                            {totalPosts === 0 ? (
                                <div class="rounded-2xl border border-dashed border-slate-200 dark:border-[#224249] bg-white/5 dark:bg-card-dark/40 p-12 text-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 mx-auto text-slate-400 dark:text-slate-500 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
                                    </svg>
                                    <p class="text-slate-500 dark:text-slate-400 text-sm">No se encontraron publicaciones que coincidan con tu búsqueda.</p>
                                </div>
                            ) : (
                            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
                                {paginatedPosts.map((post) => (
                                    <div class="group flex flex-col bg-white/5 dark:bg-card-dark border border-slate-100 dark:border-[#224249]/50 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 relative" data-filename={post.id} data-title={stripRichText(post.data.title)}>

                                        <!-- Cover Image Area -->
                                        <div class="relative w-full aspect-video bg-slate-100 dark:bg-background-dark overflow-hidden rounded-t-2xl">
                                            {post.data.image ? (
                                                <img src={post.data.image} alt={stripRichText(post.data.title)} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                                            ) : (
                                                <div class="w-full h-full flex items-center justify-center text-slate-300 dark:text-slate-700">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
                                                    </svg>
                                                </div>
                                            )}
                                        </div>

                                        <!-- Content Area -->
                                        <div class="p-5 flex flex-col flex-grow">
                                            <div class="flex items-center gap-2 mb-3">
                                                <span class="px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-background-dark border border-slate-200 dark:border-[#224249] text-[10px] uppercase font-bold tracking-wider text-slate-600 dark:text-slate-300 shadow-sm">
                                                    {post.data.category}
                                                </span>
                                                <span class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 font-medium ml-auto">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                                    </svg>
                                                    {formatDate(post.data.pubDate)}
                                                </span>
                                            </div>

                                            <h3
                                                class="text-slate-900 dark:text-white font-bold text-base leading-snug mb-4 group-hover:text-primary transition-colors line-clamp-2"
