---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { getSession } from "../../lib/auth";

export const prerender = false;

let error = "";

// 1. Verificar si ya tiene sesión activa
const session = await getSession(Astro.request);
if (session) {
    return Astro.redirect("/admin");
}

// 2. Título de la página
const title = "Admin Login | RutaDorada";
---

<Layout title={title}>
    <Header />
    <main
        class="flex-grow grid place-items-center relative overflow-hidden py-20 px-4"
    >
        <!-- Background Elements (Coherente con login.astro) -->
        <div class="absolute inset-0 pointer-events-none">
            <div
                class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-primary/20 rounded-full blur-[120px] mix-blend-screen opacity-30"
            >
            </div>
            <div
                class="absolute bottom-[-10%] left-[-5%] w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[120px] mix-blend-screen opacity-30"
            >
            </div>
        </div>

        <div class="w-full max-w-md relative z-10">
            <div
                class="bg-white/80 dark:bg-[#0b1618] border border-slate-200 dark:border-[#224249] rounded-2xl p-8 shadow-2xl backdrop-blur-sm"
            >
                <div class="text-center mb-8">
                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary/10 mb-4 border border-primary/20">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                    </div>
                    <h1
                        class="font-display font-bold text-3xl text-slate-900 dark:text-white mb-2"
                    >
                        Panel de Administración
                    </h1>
                    <p class="text-slate-500 text-sm">
                        Ingresa tus credenciales maestras
                    </p>
                </div>

                <form id="login-form" class="space-y-6">
                    <div>
                        <label
                            for="username"
                            class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2"
                            >Usuario</label
                        >
                        <input
                            type="text"
                            name="username"
                            id="username"
                            required
                            class="w-full bg-slate-50 dark:bg-[#162a2f] text-slate-900 dark:text-white px-4 py-3 rounded-xl border border-slate-200 dark:border-transparent focus:border-primary/50 focus:ring-2 focus:ring-primary/20 outline-none transition-all placeholder:text-slate-400"
                            placeholder="Tu usuario"
                        />
                    </div>

                    <div>
                        <div class="flex justify-between items-center mb-2">
                            <label
                                for="password"
                                class="block text-xs font-bold text-slate-500 uppercase tracking-widest"
                                >Contraseña</label
                            >
                        </div>
                        <input
                            type="password"
                            name="password"
                            id="password"
                            required
                            class="w-full bg-slate-50 dark:bg-[#162a2f] text-slate-900 dark:text-white px-4 py-3 rounded-xl border border-slate-200 dark:border-transparent focus:border-primary/50 focus:ring-2 focus:ring-primary/20 outline-none transition-all placeholder:text-slate-400"
                            placeholder="••••••••"
                        />
                    </div>

                    <div id="error-message" class="hidden text-red-500 text-sm text-center bg-red-500/10 p-2 rounded-lg border border-red-500/20 animate-pulse"></div>

                    <button
                        type="submit"
                        id="login-button"
                        class="w-full bg-primary hover:bg-primary/90 text-[#102023] font-bold py-3.5 rounded-xl shadow-lg shadow-primary/25 hover:shadow-primary/40 transform hover:-translate-y-0.5 transition-all duration-200"
                    >
                        Acceder al Panel
                    </button>
                    
                    <div class="text-center pt-2">
                        <a href="/" class="text-xs text-slate-400 hover:text-primary transition-colors">
                            ← Volver al sitio principal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <script>
        const loginForm = document.getElementById('login-form') as HTMLFormElement;
        const errorDiv = document.getElementById('error-message');
        const loginButton = document.getElementById('login-button') as HTMLButtonElement;

        loginForm?.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            if (errorDiv) {
                errorDiv.classList.add('hidden');
                errorDiv.textContent = '';
            }
            
            if (loginButton) {
                loginButton.disabled = true;
                loginButton.textContent = 'Autenticando...';
            }

            try {
                const formData = new FormData(loginForm);
                const data = Object.fromEntries(formData.entries());

                const response = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(data),
                });

                const result = await response.json();

                if (result.success) {
                    window.location.href = '/admin';
                } else {
                    if (errorDiv) {
                        errorDiv.textContent = result.error || 'Credenciales incorrectas';
                        errorDiv.classList.remove('hidden');
                    }
                    if (loginButton) {
                        loginButton.disabled = false;
                        loginButton.textContent = 'Acceder al Panel';
                    }
                }
            } catch (error) {
                console.error('Error al iniciar sesión:', error);
                if (errorDiv) {
                    errorDiv.textContent = 'Ocurrió un error en la conexión';
                    errorDiv.classList.remove('hidden');
                }
                if (loginButton) {
                    loginButton.disabled = false;
                    loginButton.textContent = 'Acceder al Panel';
                }
            }
        });
    </script>
</Layout>
